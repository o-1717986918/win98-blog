# 必填：生产站点的公开根 URL，不要以 / 结尾
SITE_URL=https://example.com

# 可选：部署到 GitHub Pages 项目站时填写仓库子路径，例如 /win98-blog
BASE_PATH=

# Cloudflare Pages Direct Upload。复制为 .env 后填写；.env 不进入版本控制
CLOUDFLARE_PAGES_PROJECT=someone-site
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PRODUCTION_BRANCH=main
DEPLOY_BRANCH=manual-preview

# 仅本机生产发布时临时设为 YES；不要把确认值长期写入文件
CONFIRM_PRODUCTION=

# 可选：生产构建是否包含 draft 和未来日期内容
PREVIEW_DRAFTS=false

# 评论：none | giscus | waline
PUBLIC_COMMENTS_PROVIDER=none
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_WALINE_SERVER_URL=

# 统计：none | cloudflare | umami
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 可选：开放网络与现场性能。均须为 HTTPS；留空时不产生网络请求
PUBLIC_WEBMENTION_ENDPOINT=
PUBLIC_PERFORMANCE_ENDPOINT=

# 宝塔 Compose 运行参数；正式发布建议把 WIN98_TAG 固定为已验收的 sha-<commit>
WIN98_IMAGE=ghcr.io/o-1717986918/win98-blog
WIN98_TAG=stable
WIN98_PORT=18098
