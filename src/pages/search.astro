---
import FullShell from '../layouts/FullShell.astro';
---

<FullShell title="站内搜索" description="搜索win98的小站全部公开文章、主题、笔记与页面。" noindex>
  <div class="page-wrap search-page">
    <header class="page-intro">
      <div><p class="eyebrow">FIND A NOTE</p><h1 class="display-title">从这里<br />查找</h1></div>
      <div class="page-intro__copy"><p>搜索入口位于侧栏顶部。输入标题、主题、公开笔记或正文里的词，就能回到相关内容。</p><a class="open-search" href="#site-search">前往搜索框 <span aria-hidden="true">↗</span></a></div>
    </header>
  </div>
</FullShell>

<style>
  .search-page { min-height: calc(100vh - var(--header)); padding-bottom: 5rem; }
  .open-search { display: inline-flex; margin-top: 1.5rem; padding: .75rem 1rem; border: 1px solid var(--line-strong); border-radius: .55rem; color: rgb(var(--text-rgb)); background: rgba(var(--surface-rgb), .72); box-shadow: 0 .8rem 2rem rgba(0, 0, 0, .12); text-decoration: none; cursor: pointer; }
  .open-search:hover { border-color: rgb(var(--spectrum-aqua-rgb)); transform: translateY(-2px); }
</style>
