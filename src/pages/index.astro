---
import { getCollection } from 'astro:content';
import ContentCover from '../components/ContentCover.astro';
import HomePostStream from '../components/HomePostStream.astro';
import PortalControls from '../components/PortalControls.astro';
import ProfileCard from '../components/ProfileCard.astro';
import PublicationCalendar from '../components/PublicationCalendar.astro';
import { SITE } from '../config/site';
import { allTags, belongsToColumn, formatDate, isPublished, sortColumns, sortPosts } from '../lib/content';
import { accentStyle, postAccent } from '../lib/visual';
import { withBase } from '../lib/site-path';
import FullShell from '../layouts/FullShell.astro';

const posts = sortPosts((await getCollection('posts')).filter(isPublished));
const columns = sortColumns((await getCollection('columns')).filter(isPublished));
const notes = (await getCollection('notes'))
  .filter((note) => note.data.publish && !note.data.draft)
  .sort((a, b) => (b.data.updated ?? b.data.created).getTime() - (a.data.updated ?? a.data.created).getTime() || a.id.localeCompare(b.id, 'en'));
const columnMap = new Map(columns.map((column) => [column.id, column]));
const spotlight = posts.find((post) => post.data.featured) ?? posts[0];
const streamPosts = posts.filter((post) => post.id !== spotlight?.id);
const spotlightStyle = spotlight ? accentStyle(postAccent(spotlight, columnMap)) : accentStyle('aqua');
const tags = allTags(posts);
const portalTags = tags.slice(0, 10);
const noteTags = [...new Set(notes.flatMap((note) => note.data.tags))].slice(0, 5);
const latestNote = notes[0];
---

<FullShell title={SITE.title} description={SITE.description}>
  <div class="page-wrap home-page">
    <header class="home-dashboard-head">
      <h1>{SITE.title}</h1>
      <PortalControls />
    </header>

    <section class="home-portal" aria-label="个人门户" data-right-visible="true">
        <div class="portal-profile"><ProfileCard posts={posts.length} columns={columns.length} notes={notes.length} /></div>

        <section class="notes-feature" data-notes-feature aria-labelledby="notes-feature-title">
          <span class="notes-feature__glow" aria-hidden="true"></span>
          <header><p>PUBLIC VAULT / LOCAL KNOWLEDGE</p><span><i></i> {String(notes.length).padStart(2, '0')} NOTES</span></header>
          <div class="notes-feature__identity">
            <h2 id="notes-feature-title">学习<br />笔记</h2>
            <p>像翻开一组仍在生长的卡片：正文、属性、双向链接与局部关系图共同描述一个知识节点。</p>
          </div>
          <div class="notes-feature__modes" role="tablist" aria-label="预览学习笔记视图">
            <button id="note-tab-note" type="button" role="tab" aria-selected="true" aria-controls="note-panel-note" tabindex="0" data-note-mode="note"><b>NOTE</b><span>笔记</span></button>
            <button id="note-tab-links" type="button" role="tab" aria-selected="false" aria-controls="note-panel-links" tabindex="-1" data-note-mode="links"><b>LINKS</b><span>关系</span></button>
            <button id="note-tab-properties" type="button" role="tab" aria-selected="false" aria-controls="note-panel-properties" tabindex="-1" data-note-mode="properties"><b>YAML</b><span>属性</span></button>
          </div>
          <div class="notes-feature__canvas">
            <div id="note-panel-note" role="tabpanel" aria-labelledby="note-tab-note" tabindex="0" data-note-panel="note">
              <span>LATEST PUBLIC NOTE</span>
              <strong>{latestNote?.data.title ?? '等待第一条公开笔记'}</strong>
              <p>{latestNote?.data.description ?? '在本地知识库中标记公开后，笔记会出现在这里。'}</p>
            </div>
            <div id="note-panel-links" role="tabpanel" aria-labelledby="note-tab-links" tabindex="0" data-note-panel="links" hidden>
              <span>LOCAL GRAPH</span>
              <div class="notes-feature__nodes"><i></i>{notes.slice(0, 3).map((note) => <a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>)}</div>
              <p>节点来自真实公开笔记；内容增加后，关系视图会沿 Wiki 链接继续生长。</p>
            </div>
            <div id="note-panel-properties" role="tabpanel" aria-labelledby="note-tab-properties" tabindex="0" data-note-panel="properties" hidden>
              <span>NOTE PROPERTIES</span>
              <dl><div><dt>updated</dt><dd>{latestNote ? formatDate(latestNote.data.updated ?? latestNote.data.created) : '—'}</dd></div><div><dt>tags</dt><dd>{noteTags.join(', ') || '—'}</dd></div><div><dt>publish</dt><dd>true</dd></div></dl>
            </div>
          </div>
          <a class="notes-feature__enter" href={withBase('/notes/')}><span>进入知识空间</span><i>↗</i></a>
        </section>

        <nav class="portal-panel portal-topics" aria-labelledby="portal-topics-title" data-portal-widget="topics">
          <header class="portal-panel__heading">
            <div><p>LONG-RUNNING THEMES</p><h2 id="portal-topics-title">长期主题</h2></div>
            <span>{String(columns.length).padStart(2, '0')}</span>
          </header>
          <p class="portal-panel__intro">沿着长期问题组织文章，而不是按栏目制造一次性入口。</p>
          <ol>
            {columns.map((column, index) => (
              <li style={accentStyle(column.data.accent)}>
                <a href={withBase(`/columns/${column.id}/`)}>
                  <small>{String(index + 1).padStart(2, '0')}</small>
                  <span><strong>{column.data.title}</strong><i>{posts.filter((post) => belongsToColumn(post, column.id)).length} 篇记录</i></span>
                  <b aria-hidden="true">↗</b>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <section class="writing-stream" aria-labelledby="writing-stream-title">
          <header class="portal-section-heading">
            <div><p>CHRONOLOGICAL DISPATCH</p><h2 id="writing-stream-title">最近写作</h2></div>
            <a href={withBase('/archive/')}>全部 {posts.length} 篇 →</a>
          </header>
          <p class="writing-stream__intro">文章按时间进入同一条发表航线；主题、标签和预计阅读量负责提供上下文。</p>
          <HomePostStream posts={streamPosts} columns={columns} />
        </section>

        <aside class="portal-right" aria-label="发表状态与内容发现">
          <PublicationCalendar posts={streamPosts} />

          <nav class="portal-panel portal-tags" aria-labelledby="portal-tags-title" data-portal-widget="tags">
            <header class="portal-panel__heading">
              <div><p>INDEX / TAGS</p><h2 id="portal-tags-title">发现索引</h2></div>
              <span>{String(tags.length).padStart(2, '0')}</span>
            </header>
            <div>
              {portalTags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag.name)}/`)}><span>#{tag.name}</span><small>{tag.count}</small></a>)}
            </div>
            <a class="portal-panel__more" href={withBase('/tags/')}>查看全部标签 <i aria-hidden="true">→</i></a>
          </nav>

        </aside>
    </section>

    <section class="home-featured-return" aria-label="最近重点">
      {spotlight ? (
        <a class="spotlight" href={withBase(`/posts/${spotlight.id}/`)} style={spotlightStyle}>
          <span class="spotlight-glow" aria-hidden="true"></span>
          <span class="spotlight-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="spotlight-main">
            <p class="spotlight-label"><span>最近重点</span><time datetime={spotlight.data.date.toISOString()}>{formatDate(spotlight.data.date)}</time></p>
            <h2 aria-label={spotlight.data.title}><span class="spotlight-title__full">{spotlight.data.title}</span>{spotlight.data.shortTitle && <span class="spotlight-title__short" aria-hidden="true">{spotlight.data.shortTitle}</span>}</h2>
          </div>
          <div class="spotlight-detail">
            <p>{spotlight.data.description}</p>
            <div class="spotlight-taxonomy">
              {spotlight.data.columns.map((reference) => {
                const column = columnMap.get(reference.id);
                return column && <span>{column.data.title}</span>;
              })}
              {spotlight.data.tags.map((tag) => <span>#{tag}</span>)}
            </div>
            <span class="spotlight-link">开始阅读 <i aria-hidden="true">↗</i></span>
          </div>
          <ContentCover className="spotlight-cover" title={spotlight.data.title} seed={spotlight.id} kind="post" accent={postAccent(spotlight, columnMap)} cover={spotlight.data.cover} variant="spotlight" />
        </a>
      ) : (
        <div class="spotlight spotlight--empty"><p>第一篇文章正在准备中。</p></div>
      )}
    </section>
  </div>
</FullShell>

<style>
  .home-page { width: min(var(--content), calc(100% - clamp(2.5rem, 5vw, 6rem))); padding-bottom: clamp(5rem, 10vw, 9rem); }
  .home-dashboard-head { position: relative; padding-top: clamp(1.4rem, 3vh, 2.2rem); }
  .home-dashboard-head > h1 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .home-featured-return { padding-top: clamp(4.5rem, 8vw, 7.5rem); }
  .spotlight { position: relative; isolation: isolate; display: grid; grid-template-areas: 'main cover' 'detail cover'; grid-template-columns: minmax(0, 1fr) minmax(21rem, .72fr); grid-template-rows: auto 1fr; gap: .55rem clamp(1.4rem, 2.6vw, 2.8rem); align-items: center; min-height: clamp(15rem, 18vw, 17rem); padding: clamp(.9rem, 1.45vw, 1.3rem); overflow: hidden; border: 1px solid rgba(var(--content-accent-rgb), .42); border-radius: .36rem; color: inherit; background: linear-gradient(112deg, rgba(var(--content-accent-rgb), .16), rgba(var(--surface-rgb), .93) 38%, rgba(var(--content-secondary-rgb), .11) 82%, rgba(var(--surface-rgb), .86)); box-shadow: .55rem .62rem 0 rgba(var(--content-secondary-rgb), .09), 0 1.2rem 3rem rgba(8, 19, 28, .11), inset 0 1px rgba(255, 255, 255, .12); text-decoration: none; transition: transform .24s var(--ease), border-color .24s var(--ease), box-shadow .24s var(--ease); cursor: pointer; }
  .spotlight::before { content: ''; position: absolute; inset: 0 auto 0 0; width: .46rem; background: rgb(var(--content-accent-rgb)); }
  .spotlight::after { content: ''; position: absolute; inset: auto 1.35rem 1.2rem auto; width: clamp(5rem, 12vw, 9rem); height: 1px; background: linear-gradient(90deg, transparent, rgb(var(--content-accent-rgb))); opacity: .7; }
  .spotlight:hover { border-color: rgba(var(--content-accent-rgb), .72); box-shadow: .92rem 1rem 0 rgba(var(--content-secondary-rgb), .13), 0 2.2rem 5rem rgba(8, 19, 28, .16); transform: translateY(-3px); }
  .spotlight-glow { position: absolute; inset: 0; z-index: 0; background: radial-gradient(26rem circle at var(--spot-x, 32%) var(--spot-y, 48%), rgba(var(--content-accent-rgb), .2), transparent 66%); opacity: 0; transition: opacity .28s ease; pointer-events: none; }
  .spotlight[data-pointer='true'] .spotlight-glow { opacity: 1; }
  :global(.spotlight-cover) { grid-area: cover; justify-self: end; align-self: center; width: min(100%, 25rem); height: auto; min-height: 0; aspect-ratio: 16 / 9; box-shadow: .55rem .62rem 0 rgba(var(--content-secondary-rgb), .1); transition: transform .32s var(--ease), border-color .24s var(--ease); }
  .spotlight:hover :global(.spotlight-cover) { border-color: rgba(var(--content-accent-rgb), .72); }
  .spotlight[data-pointer='true'] :global(.spotlight-cover) { transform: translate3d(calc(var(--spot-nx, 0) * 5px), calc(var(--spot-ny, 0) * 5px), 0) rotate(calc(var(--spot-nx, 0) * .35deg)); }
  .spotlight-main, .spotlight-detail { position: relative; z-index: 1; padding-left: clamp(.75rem, 1.7vw, 1.4rem); }
  .spotlight-main { grid-area: main; align-self: end; }
  .spotlight-detail { grid-area: detail; align-self: start; }
  .spotlight-mark { position: absolute; top: .85rem; right: 1rem; display: flex; gap: .24rem; align-items: end; }
  .spotlight-mark i { width: 1.2rem; height: 1px; background: rgb(var(--content-accent-rgb)); opacity: .72; }
  .spotlight-mark i:nth-child(2) { width: .65rem; transform: translateY(.22rem); }
  .spotlight-mark i:nth-child(3) { width: .3rem; height: .3rem; border: 1px solid rgb(var(--content-accent-rgb)); background: transparent; transform: translateY(.12rem); }
  .spotlight:focus-visible { outline: 3px solid rgb(var(--brand-primary-rgb)); outline-offset: 4px; }
  .spotlight-label { display: flex; align-items: center; gap: 1rem; margin-bottom: .65rem; color: rgba(var(--text-rgb), .7); font-family: var(--font-mono); font-size: .61rem; }
  .spotlight-label span { color: rgb(var(--content-accent-rgb)); }
  .spotlight h2 { max-width: 17ch; font-family: var(--font-display); font-size: clamp(2.2rem, 2.85vw, 3.3rem); font-stretch: condensed; font-weight: 640; line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .spotlight-title__short { display: none; }
  .spotlight:hover h2, .spotlight:focus-visible h2 { color: rgb(var(--content-accent-rgb)); }
  .spotlight-detail > p { display: none; }
  .spotlight-taxonomy { display: flex; flex-wrap: wrap; gap: .35rem .75rem; margin-top: .72rem; color: rgba(var(--text-rgb), .6); font-family: var(--font-mono); font-size: .57rem; }
  .spotlight-taxonomy span { color: inherit; }
  .spotlight-taxonomy span:first-child { color: rgb(var(--content-accent-rgb)); }
  .spotlight-link { display: inline-flex; gap: .6rem; align-items: center; margin-top: .8rem; color: rgb(var(--content-accent-rgb)); font-size: .72rem; font-weight: 650; }
  .spotlight-link i { font-style: normal; transition: transform .2s var(--ease); }
  .spotlight:hover .spotlight-link i { transform: translate(.2rem, -.2rem); }
  .spotlight--empty { min-height: 18rem; align-items: center; }
  .home-portal { display: grid; grid-template-areas: 'profile stream notes' 'topics stream right'; grid-template-columns: minmax(13.5rem, .72fr) minmax(28rem, 1.65fr) minmax(13.5rem, .68fr); gap: clamp(1.25rem, 1.8vw, 2rem); align-items: start; padding-top: clamp(2rem, 3.5vw, 3.25rem); }
  .portal-profile { grid-area: profile; min-width: 0; }
  :global(.portal-profile > .profile-card) { width: 100%; }
  .notes-feature { --note-x: 72%; --note-y: 30%; position: relative; isolation: isolate; grid-area: notes; display: grid; grid-template-areas: 'header' 'identity' 'modes' 'canvas' 'enter'; grid-template-columns: minmax(0, 1fr); gap: .75rem; min-width: 0; min-height: 0; padding: 1rem; overflow: hidden; border: 1px solid rgba(var(--spectrum-violet-rgb), .46); background: linear-gradient(145deg, rgba(var(--spectrum-violet-rgb), .13), rgba(var(--surface-rgb), .96) 43%, rgba(var(--spectrum-gold-rgb), .08)); box-shadow: .55rem .62rem 0 rgba(var(--spectrum-violet-rgb), .08); }
  .notes-feature::before { content: ''; position: absolute; z-index: -1; inset: 0; background-image: linear-gradient(rgba(var(--spectrum-violet-rgb), .08) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--spectrum-violet-rgb), .08) 1px, transparent 1px); background-size: 2.4rem 2.4rem; mask-image: linear-gradient(115deg, #000, transparent 72%); }
  .notes-feature__glow { position: absolute; z-index: -1; width: 13rem; aspect-ratio: 1; left: var(--note-x); top: var(--note-y); border: 1px solid rgba(var(--spectrum-gold-rgb), .28); border-radius: 50%; box-shadow: 0 0 0 1.4rem rgba(var(--spectrum-violet-rgb), .04), 0 0 0 2.8rem rgba(var(--spectrum-gold-rgb), .025); opacity: .55; transform: translate(-50%, -50%); transition: left .18s ease, top .18s ease, opacity .2s ease; pointer-events: none; }
  .notes-feature:hover .notes-feature__glow, .notes-feature:focus-within .notes-feature__glow { opacity: 1; }
  .notes-feature > header { grid-area: header; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-bottom: .8rem; border-bottom: 1px solid rgba(var(--spectrum-violet-rgb), .25); }
  .notes-feature > header p, .notes-feature > header span { font: .53rem/1 var(--font-mono); letter-spacing: .1em; }
  .notes-feature > header p { color: rgb(var(--spectrum-violet-rgb)); }
  .notes-feature > header span { display: flex; gap: .4rem; align-items: center; color: rgba(var(--text-rgb), .52); }
  .notes-feature > header i { width: .42rem; aspect-ratio: 1; border-radius: 50%; background: rgb(var(--spectrum-aqua-rgb)); box-shadow: 0 0 .65rem rgba(var(--spectrum-aqua-rgb), .7); }
  .notes-feature__identity { grid-area: identity; display: grid; gap: .55rem; }
  .notes-feature__identity h2 { font: 650 clamp(2.2rem, 3vw, 3rem)/.84 var(--font-display); letter-spacing: -.065em; }
  .notes-feature__identity p { color: rgba(var(--text-rgb), .62); font-size: .65rem; line-height: 1.65; }
  .notes-feature__modes { grid-area: modes; align-self: end; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); background: rgba(var(--surface-rgb), .7); }
  .notes-feature__modes button { display: grid; gap: .28rem; padding: .52rem .4rem; border: 0; border-right: 1px solid var(--line); color: rgba(var(--text-rgb), .5); background: transparent; text-align: left; cursor: pointer; }
  .notes-feature__modes button:last-child { border-right: 0; }
  .notes-feature__modes button:hover, .notes-feature__modes button[aria-selected='true'] { color: rgb(var(--text-rgb)); background: rgba(var(--spectrum-violet-rgb), .13); }
  .notes-feature__modes b { color: rgb(var(--spectrum-coral-rgb)); font: .5rem/1 var(--font-mono); }
  .notes-feature__modes span { font-size: .62rem; }
  .notes-feature__canvas { grid-area: canvas; min-width: 0; min-height: 11.5rem; padding: .9rem; border: 1px solid rgba(var(--spectrum-violet-rgb), .32); background: linear-gradient(rgba(var(--spectrum-violet-rgb), .07) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--spectrum-violet-rgb), .07) 1px, transparent 1px), rgba(var(--surface-rgb), .76); background-size: 2.2rem 2.2rem; }
  .notes-feature__canvas > div { display: grid; align-content: center; height: 100%; }
  .notes-feature__canvas > div[hidden] { display: none; }
  .notes-feature__canvas span { color: rgb(var(--spectrum-violet-rgb)); font: .53rem/1 var(--font-mono); letter-spacing: .09em; }
  .notes-feature__canvas strong { max-width: 18ch; margin: .85rem 0 .55rem; font: 640 clamp(1.25rem, 1.7vw, 1.65rem)/1.04 var(--font-display); letter-spacing: -.04em; }
  .notes-feature__canvas p { display: -webkit-box; overflow: hidden; color: rgba(var(--text-rgb), .62); font-size: .64rem; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .notes-feature__canvas dl { display: grid; gap: .75rem; margin-top: 1.4rem; }
  .notes-feature__canvas dl div { grid-template-columns: 6rem 1fr; gap: 1rem; padding-bottom: .55rem; border-bottom: 1px solid var(--line); }
  .notes-feature__canvas dt, .notes-feature__canvas dd { font-size: .62rem; }
  .notes-feature__nodes { position: relative; display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; margin: 1.5rem 0; }
  .notes-feature__nodes i { width: 1.15rem; aspect-ratio: 1; border: 1px solid rgb(var(--spectrum-gold-rgb)); border-radius: 50%; background: rgba(var(--spectrum-gold-rgb), .14); }
  .notes-feature__nodes::before { content: ''; position: absolute; left: 1.1rem; right: 1rem; top: .57rem; z-index: -1; height: 1px; background: linear-gradient(90deg, rgb(var(--spectrum-gold-rgb)), rgb(var(--spectrum-violet-rgb)), transparent); }
  .notes-feature__nodes a { max-width: 12rem; padding: .6rem .75rem; overflow: hidden; border: 1px solid rgba(var(--spectrum-violet-rgb), .35); color: inherit; background: rgba(var(--surface-rgb), .94); font-size: .68rem; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
  .notes-feature__nodes a:hover { border-color: rgb(var(--spectrum-aqua-rgb)); transform: translateY(-2px); }
  .notes-feature__enter { grid-area: enter; display: flex; justify-content: space-between; align-items: center; padding-top: .95rem; border-top: 1px solid rgba(var(--spectrum-violet-rgb), .25); color: rgb(var(--spectrum-coral-rgb)); font-size: .78rem; font-weight: 650; text-decoration: none; }
  .notes-feature__enter i { font-style: normal; transition: transform .2s var(--ease); }
  .notes-feature__enter:hover i { transform: translate(.25rem, -.25rem); }
  .portal-panel { min-width: 0; padding: 1rem; border-top: 1px solid rgba(var(--spectrum-aqua-rgb), .4); border-bottom: 1px solid var(--line); background: linear-gradient(145deg, rgba(var(--surface-rgb), .74), rgba(var(--raised-rgb), .2)); }
  .portal-panel__heading, .portal-section-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; padding-bottom: .8rem; border-bottom: 1px solid var(--line); }
  .portal-panel__heading p, .portal-section-heading p { color: rgb(var(--spectrum-coral-rgb)); font: .5rem/1 var(--font-mono); letter-spacing: .09em; }
  .portal-panel__heading h2, .portal-section-heading h2 { margin-top: .32rem; font: 620 clamp(1.35rem, 2vw, 1.8rem)/1 var(--font-display); letter-spacing: -.04em; }
  .portal-panel__heading > span { color: rgb(var(--spectrum-gold-rgb)); font: .58rem/1 var(--font-mono); }
  .portal-panel__intro, .writing-stream__intro { color: rgba(var(--text-rgb), .55); font-size: .65rem; line-height: 1.7; }
  .portal-panel__intro { padding: .8rem 0; }
  .portal-topics { grid-area: topics; align-self: start; }
  .portal-topics ol { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .portal-topics li { border-bottom: 1px solid var(--line); }
  .portal-topics li a { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr) auto; gap: .65rem; align-items: center; padding: .72rem .08rem; color: inherit; text-decoration: none; }
  .portal-topics li small { color: rgba(var(--text-rgb), .38); font: .49rem/1 var(--font-mono); }
  .portal-topics li span { display: grid; min-width: 0; gap: .18rem; }
  .portal-topics li strong { overflow: hidden; font-size: .72rem; text-overflow: ellipsis; white-space: nowrap; }
  .portal-topics li i { color: rgba(var(--text-rgb), .46); font: normal .51rem/1 var(--font-mono); }
  .portal-topics li b { color: rgb(var(--content-accent-rgb)); font-size: .7rem; font-weight: 500; opacity: .55; transition: opacity .2s var(--ease), transform .2s var(--ease); }
  .portal-topics li a:is(:hover, :focus-visible) strong { color: rgb(var(--content-accent-rgb)); }
  .portal-topics li a:is(:hover, :focus-visible) b { opacity: 1; transform: translate(.12rem, -.12rem); }
  .writing-stream { grid-area: stream; min-width: 0; }
  .portal-section-heading { margin-bottom: .2rem; }
  .portal-section-heading > a { color: rgba(var(--text-rgb), .65); font-size: .66rem; text-decoration: none; }
  .portal-section-heading > a:hover { color: rgb(var(--spectrum-aqua-rgb)); }
