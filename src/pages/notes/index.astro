---
import { getCollection } from 'astro:content';
import StandaloneLayout from '../../layouts/StandaloneLayout.astro';
import '../../styles/tokens.css';
import '../../styles/shell.css';

const notes = (await getCollection('notes'))
  .filter((note) => note.data.publish && !note.data.draft)
  .sort((a, b) => (b.data.updated ?? b.data.created).getTime() - (a.data.updated ?? a.data.created).getTime());
const tags = [...new Set(notes.flatMap((note) => note.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const latest = notes[0];
const formatDate = (value: Date) => value.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const linksTo = (source: (typeof notes)[number], target: (typeof notes)[number]) =>
  (source.body ?? '').includes(`[[${target.data.title}`) || (source.body ?? '').includes(`/notes/${target.id}/`);
const relations = notes.flatMap((source) => notes
  .filter((target) => target.id !== source.id && linksTo(source, target))
  .map((target) => ({ source: source.id, target: target.id })));
const graphNodes = notes.map((note, index) => {
  const count = Math.max(notes.length, 1);
  const angle = -Math.PI / 2 + index * (Math.PI * 2 / count);
  const radius = notes.length === 1 ? 0 : Math.min(34, 21 + notes.length * 1.8);
  return { note, x: 50 + Math.cos(angle) * radius, y: 50 + Math.sin(angle) * radius };
});
const nodeById = new Map(graphNodes.map((node) => [node.note.id, node]));
const incomingFor = (note: (typeof notes)[number]) => notes.filter((entry) => entry.id !== note.id && linksTo(entry, note));
const outgoingFor = (note: (typeof notes)[number]) => notes.filter((entry) => entry.id !== note.id && linksTo(note, entry));
const latestIncoming = latest ? incomingFor(latest) : [];
const latestOutgoing = latest ? outgoingFor(latest) : [];
---

<StandaloneLayout title="学习笔记" description="本地知识库经过显式公开后形成的只读知识空间。" theme="mist">
  <main class="garden" data-note-workbench data-pagefind-body>
    <header class="garden-bar">
      <a class="garden-home" href="/" aria-label="返回博客首页"><b>某</b><span>某人的小站</span></a>
      <p>PRIVATE WORKSPACE / PUBLIC PROJECTION</p>
      <nav aria-label="学习笔记导航"><a href="/">博客首页</a><span><i></i> LOCAL-FIRST</span></nav>
    </header>

    <section class="garden-hero">
      <div class="garden-hero__title">
        <p>LEARNING NOTES / PUBLIC GARDEN</p>
        <h1>学习<br /><em>笔记</em></h1>
      </div>
      <div class="garden-hero__copy">
        <p>这里保留旧版学习笔记的自由页面感，但不再把它伪装成普通主题。每一条公开笔记都是本地 Vault 的只读投影，可以通过标题、属性、标签、Wiki 链接与反向链接重新找到。</p>
        <dl>
          <div><dt>公开笔记</dt><dd>{String(notes.length).padStart(2, '0')}</dd></div>
          <div><dt>真实连接</dt><dd>{String(relations.length).padStart(2, '0')}</dd></div>
          <div><dt>最近投影</dt><dd>{latest ? formatDate(latest.data.updated ?? latest.data.created) : '—'}</dd></div>
        </dl>
      </div>
    </section>

    <section class="garden-workspace" aria-label="公开笔记空间">
      <aside class="garden-explorer" aria-label="笔记资源管理器">
        <header><p>PUBLIC VAULT</p><span><b data-visible-count>{notes.length}</b> / {notes.length}</span></header>
        <label class="garden-search"><span>⌕</span><input type="search" placeholder="搜索公开笔记…" autocomplete="off" data-note-search /></label>
        <div class="garden-tags" aria-label="按标签筛选">
          <button type="button" aria-pressed="true" data-note-tag="">全部</button>
          {tags.map((tag) => <button type="button" aria-pressed="false" data-note-tag={tag}>#{tag}</button>)}
        </div>
        <p class="garden-folder"><span>⌄</span> notes / public</p>
        <ol class="garden-list">
          {notes.map((note, index) => {
            const date = note.data.updated ?? note.data.created;
            const incoming = incomingFor(note);
            const outgoing = outgoingFor(note);
            return <li data-note-entry data-note-title={note.data.title.toLowerCase()} data-note-description={note.data.description.toLowerCase()} data-note-tags={note.data.tags.join('|').toLowerCase()}>
              <a href={`/notes/${note.id}/`} data-note-preview
                data-preview-index={String(index + 1).padStart(2, '0')}
                data-preview-title={note.data.title}
                data-preview-description={note.data.description}
                data-preview-date={formatDate(date)}
                data-preview-tags={note.data.tags.map((tag) => `#${tag}`).join(' · ') || 'UNTAGGED'}
                data-preview-source={note.data.source ?? '站内创建'}
                data-preview-aliases={note.data.aliases.join(' · ') || '—'}
                data-preview-incoming={String(incoming.length)}
                data-preview-outgoing={String(outgoing.length)}>
                <i aria-hidden="true">◇</i><span><strong>{note.data.title}</strong><small>{formatDate(date)}</small></span>
              </a>
            </li>;
          })}
        </ol>
        <p class="garden-empty" data-note-empty hidden>没有匹配的公开笔记。私人条目不会出现在这里。</p>
      </aside>

      <section class="garden-stage">
        <header class="garden-stage__bar">
          <p><span>学习笔记.md</span><i>只读</i></p>
          <div class="garden-views" aria-label="切换笔记视图">
            <button type="button" aria-pressed="true" data-note-view="index">笔记</button>
            <button type="button" aria-pressed="false" data-note-view="map">关系图</button>
          </div>
        </header>

        <article class="garden-note" data-index-view>
          <p data-preview-tags>{latest?.data.tags.map((tag) => `#${tag}`).join(' · ') || 'NO PUBLIC NOTE'}</p>
          <h2 data-preview-title>{latest?.data.title ?? '等待第一条公开笔记'}</h2>
          <span data-preview-description>{latest?.data.description ?? '在本地 Vault 中明确标记公开后，笔记会出现在这里。'}</span>
          <div class="garden-note__rule" aria-hidden="true"><i></i><i></i><i></i></div>
          <section>
            <h3>公开笔记如何进入这里</h3>
            <p>正文仍在 Markdown 文件中完成。同步器转换基础 Wiki 链接与附件，并且只让带有 <code>publish: true</code> 的条目进入静态站点。这个页面负责阅读与发现，不远程修改你的本地知识库。</p>
            <a href={latest ? `/notes/${latest.id}/` : '/notes/'} data-preview-open>打开完整笔记 <span>↗</span></a>
          </section>
          <footer><span>UPDATED</span><time data-preview-date>{latest ? formatDate(latest.data.updated ?? latest.data.created) : '—'}</time></footer>
        </article>

        <div class="garden-graph" data-map-view hidden>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {relations.map((relation) => {
              const source = nodeById.get(relation.source);
              const target = nodeById.get(relation.target);
              return source && target && <line x1={source.x} y1={source.y} x2={target.x} y2={target.y} />;
            })}
          </svg>
          {graphNodes.map(({ note, x, y }, index) => <a href={`/notes/${note.id}/`} style={`--node-x:${x}%;--node-y:${y}%;`} data-note-entry data-note-title={note.data.title.toLowerCase()} data-note-description={note.data.description.toLowerCase()} data-note-tags={note.data.tags.join('|').toLowerCase()}><i></i><strong>{note.data.title}</strong><small>{String(index + 1).padStart(2, '0')}</small></a>)}
          <p>{relations.length ? '线条仅表示公开笔记之间的真实内部链接。' : '当前公开条目尚未形成内部链接；新增 Wiki 链接后，关系线会自然出现。'}</p>
        </div>
      </section>

      <aside class="garden-context" aria-label="当前笔记上下文">
        <section>
          <header><p>PROPERTIES</p><span data-preview-number>{latest ? '01' : '00'}</span></header>
          <dl>
            <div><dt>aliases</dt><dd data-preview-aliases>{latest?.data.aliases.join(' · ') || '—'}</dd></div>
            <div><dt>tags</dt><dd data-context-tags>{latest?.data.tags.join(' · ') || '—'}</dd></div>
            <div><dt>source</dt><dd data-preview-source>{latest?.data.source ?? '站内创建'}</dd></div>
            <div><dt>publish</dt><dd>true</dd></div>
          </dl>
        </section>
        <section class="garden-backlinks">
          <header><p>LINKED MENTIONS</p><span data-preview-incoming>{latestIncoming.length}</span></header>
          <div data-backlink-copy>{latestIncoming.length ? latestIncoming.map((entry) => <a href={`/notes/${entry.id}/`}>{entry.data.title} ↗</a>) : <small>尚无公开笔记引用当前条目。</small>}</div>
        </section>
        <section class="garden-outgoing">
          <header><p>OUTGOING LINKS</p><span data-preview-outgoing>{latestOutgoing.length}</span></header>
          <small>关系数量随当前选中的公开笔记更新。</small>
        </section>
      </aside>
    </section>

    <details class="garden-sync">
      <summary><span>本地同步</span><small>Obsidian / Markdown Vault → 公开只读投影</small><i>＋</i></summary>
      <div>
        <p>写作与私人关系留在本机；Blog Studio 负责预演和同步。网页不会获得你的 Vault 写权限。</p>
        <code>pnpm notes:sync -- --source &quot;C:\path\to\vault&quot; --dry-run</code>
        <button type="button" data-copy-command={'pnpm notes:sync -- --source "C:\\path\\to\\vault" --dry-run'}>复制预演命令</button>
        <span role="status" aria-live="polite" data-copy-status></span>
      </div>
    </details>
  </main>
</StandaloneLayout>

<style>
  :global(body) { background: rgb(var(--bg-rgb)); }
  .garden { --garden-paper:rgba(var(--surface-rgb),.93);--garden-line:rgba(var(--spectrum-violet-rgb),.24);--garden-shadow:rgba(var(--spectrum-violet-rgb),.08);min-height:100vh;padding-bottom:7rem;color:rgb(var(--text-rgb));background:radial-gradient(circle at 84% 7%,rgba(var(--spectrum-violet-rgb),.12),transparent 28rem),radial-gradient(circle at 12% 52%,rgba(var(--spectrum-aqua-rgb),.08),transparent 32rem),rgb(var(--bg-rgb));font-family:var(--font-ui);}
  .garden::before{content:'';position:fixed;inset:0;opacity:.58;background-image:linear-gradient(rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px);background-size:3.2rem 3.2rem;mask-image:linear-gradient(120deg,#000,transparent 78%);pointer-events:none}
  .garden-bar{position:relative;z-index:4;display:grid;grid-template-columns:17rem 1fr auto;min-height:4.6rem;border-bottom:1px solid var(--garden-line);background:rgba(var(--bg-rgb),.82);backdrop-filter:blur(18px)}
  .garden-bar>*{display:flex;align-items:center;min-width:0;padding:.75rem 1.35rem}.garden-home{gap:.75rem;border-right:1px solid var(--garden-line);color:inherit;text-decoration:none}.garden-home b{display:grid;width:2.15rem;aspect-ratio:1;place-items:center;color:rgb(var(--bg-rgb));background:rgb(var(--spectrum-aqua-rgb));font:750 .82rem/1 var(--font-display)}.garden-home span{font-size:.75rem;font-weight:680}.garden-bar>p{color:rgba(var(--text-rgb),.47);font:600 .54rem/1 var(--font-mono);letter-spacing:.09em}.garden-bar nav{gap:1.2rem;border-left:1px solid var(--garden-line);font:.56rem/1 var(--font-mono)}.garden-bar nav a{color:inherit;text-decoration:none}.garden-bar nav span{display:flex;gap:.45rem;align-items:center;color:rgba(var(--text-rgb),.52)}.garden-bar nav i{width:.42rem;aspect-ratio:1;border-radius:50%;background:rgb(var(--spectrum-aqua-rgb));box-shadow:0 0 .6rem rgba(var(--spectrum-aqua-rgb),.65)}
  .garden-hero{position:relative;z-index:1;display:grid;grid-template-columns:minmax(28rem,.95fr) minmax(25rem,.65fr);gap:clamp(3rem,8vw,10rem);align-items:end;width:min(94rem,calc(100% - clamp(2rem,5vw,6rem)));min-height:clamp(27rem,39vw,37rem);margin:auto;padding:clamp(4rem,8vw,8rem) 0 clamp(3rem,5vw,5rem)}
  .garden-hero__title>p{color:rgb(var(--spectrum-violet-rgb));font:650 .6rem/1 var(--font-mono);letter-spacing:.12em}.garden-hero h1{margin:1rem 0 0;font:650 clamp(6rem,10vw,11rem)/.7 var(--font-display);letter-spacing:-.09em}.garden-hero h1 em{color:rgb(var(--spectrum-coral-rgb));font-style:normal}.garden-hero__copy>p{max-width:37rem;color:rgba(var(--text-rgb),.68);font-size:.92rem;line-height:2}.garden-hero__copy dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:2rem 0 0;background:var(--garden-line)}.garden-hero__copy dl div{display:grid;gap:.45rem;padding:.9rem;background:rgba(var(--surface-rgb),.72)}.garden-hero dt{color:rgba(var(--text-rgb),.48);font:.52rem/1 var(--font-mono)}.garden-hero dd{margin:0;color:rgb(var(--spectrum-gold-rgb));font:.64rem/1.3 var(--font-mono)}
  .garden-workspace{position:relative;z-index:2;display:grid;grid-template-columns:minmax(14rem,.58fr) minmax(32rem,1.55fr) minmax(16rem,.68fr);width:min(98rem,calc(100% - clamp(1rem,3vw,3rem)));min-height:42rem;margin:auto;border:1px solid var(--garden-line);background:var(--garden-paper);box-shadow:1rem 1rem 0 var(--garden-shadow),0 2rem 5rem rgba(13,25,31,.1)}
  .garden-explorer{min-width:0;padding:1.1rem;border-right:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.58)}.garden-explorer>header,.garden-context section>header{display:flex;justify-content:space-between;align-items:center;padding-bottom:.75rem;border-bottom:1px solid var(--garden-line)}.garden-explorer>header p,.garden-context header p{font:650 .54rem/1 var(--font-mono);letter-spacing:.09em}.garden-explorer>header span,.garden-context header span{color:rgba(var(--text-rgb),.5);font:.52rem/1 var(--font-mono)}.garden-explorer>header b{color:rgb(var(--spectrum-coral-rgb));font-weight:650}.garden-search{display:flex;gap:.55rem;align-items:center;margin:1rem 0;padding:.62rem .7rem;border:1px solid var(--garden-line);background:rgba(var(--bg-rgb),.52)}.garden-search span{color:rgb(var(--spectrum-aqua-rgb))}.garden-search input{min-width:0;width:100%;border:0;outline:0;color:inherit;background:transparent;font-size:.68rem}.garden-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:1rem}.garden-tags button,.garden-views button{padding:.4rem .55rem;border:1px solid var(--garden-line);color:rgba(var(--text-rgb),.57);background:transparent;font:.52rem/1 var(--font-mono);cursor:pointer}.garden-tags button:hover,.garden-tags button[aria-pressed='true'],.garden-views button:hover,.garden-views button[aria-pressed='true']{border-color:rgb(var(--spectrum-violet-rgb));color:rgb(var(--text-rgb));background:rgba(var(--spectrum-violet-rgb),.12)}.garden-folder{padding:.55rem 0;color:rgba(var(--text-rgb),.52);font:.56rem/1 var(--font-mono)}.garden-folder span{color:rgb(var(--spectrum-gold-rgb))}.garden-list{margin:0;padding:0;list-style:none}.garden-list li a{display:grid;grid-template-columns:1rem minmax(0,1fr);gap:.55rem;padding:.68rem .35rem;border-bottom:1px solid rgba(var(--spectrum-violet-rgb),.13);color:inherit;text-decoration:none}.garden-list li a:hover,.garden-list li a:focus-visible{background:linear-gradient(90deg,rgba(var(--spectrum-aqua-rgb),.12),transparent)}.garden-list i{color:rgb(var(--spectrum-violet-rgb));font-style:normal}.garden-list span{display:grid;gap:.28rem;min-width:0}.garden-list strong{overflow:hidden;font-size:.7rem;text-overflow:ellipsis;white-space:nowrap}.garden-list small{color:rgba(var(--text-rgb),.44);font:.49rem/1 var(--font-mono)}.garden-empty{padding:1rem;border:1px dashed var(--garden-line);color:rgba(var(--text-rgb),.52);font:.62rem/1.6 var(--font-mono)}
  .garden-stage{display:grid;grid-template-rows:auto 1fr;min-width:0;min-height:42rem}.garden-stage__bar{display:flex;justify-content:space-between;align-items:center;min-height:3.15rem;padding:0 1rem;border-bottom:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.68)}.garden-stage__bar>p{display:flex;gap:.6rem;align-items:center;font:.57rem/1 var(--font-mono)}.garden-stage__bar>p i{color:rgba(var(--text-rgb),.42);font-style:normal}.garden-views{display:flex;gap:.35rem}.garden-note{display:grid;align-content:start;min-height:0;padding:clamp(2rem,5vw,5.5rem);background:linear-gradient(90deg,rgba(var(--spectrum-aqua-rgb),.035),transparent 25%),rgba(var(--surface-rgb),.46)}.garden-note>p{color:rgb(var(--spectrum-violet-rgb));font:.56rem/1.4 var(--font-mono);letter-spacing:.06em}.garden-note h2{max-width:15ch;margin:1rem 0;font:650 clamp(2.7rem,5vw,5rem)/.98 var(--font-display);letter-spacing:-.065em}.garden-note>span{max-width:45rem;color:rgba(var(--text-rgb),.65);font-size:.84rem;line-height:1.85}.garden-note__rule{display:flex;gap:.3rem;margin:2rem 0 3rem}.garden-note__rule i{width:3rem;height:2px;background:rgb(var(--spectrum-aqua-rgb))}.garden-note__rule i:nth-child(2){width:1.6rem;background:rgb(var(--spectrum-coral-rgb));transform:translateY(.35rem)}.garden-note__rule i:nth-child(3){width:.45rem;height:.45rem;border:1px solid rgb(var(--spectrum-gold-rgb));background:transparent}.garden-note section{max-width:42rem}.garden-note section h3{margin-bottom:.8rem;font:620 1.25rem/1.25 var(--font-display)}.garden-note section p{color:rgba(var(--text-rgb),.68);font-size:.75rem;line-height:1.9}.garden-note code{color:rgb(var(--spectrum-coral-rgb));font-family:var(--font-mono)}.garden-note section a{display:inline-flex;gap:.6rem;margin-top:1.5rem;color:rgb(var(--spectrum-coral-rgb));font-size:.74rem;font-weight:650;text-decoration:none}.garden-note footer{display:flex;gap:.7rem;align-items:center;margin-top:auto;padding-top:3rem;color:rgba(var(--text-rgb),.48);font:.52rem/1 var(--font-mono)}.garden-note footer time{color:rgb(var(--spectrum-gold-rgb))}
  .garden-graph{position:relative;min-height:38rem;overflow:hidden;background:radial-gradient(circle at 50% 50%,rgba(var(--spectrum-violet-rgb),.13),transparent 18rem),linear-gradient(rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px);background-size:auto,2.5rem 2.5rem,2.5rem 2.5rem}.garden-graph[hidden]{display:none}.garden-graph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.garden-graph line{vector-effect:non-scaling-stroke;stroke:rgba(var(--spectrum-violet-rgb),.58);stroke-width:1}.garden-graph>a{position:absolute;left:var(--node-x);top:var(--node-y);display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.55rem;align-items:center;max-width:14rem;padding:.7rem .8rem;border:1px solid rgba(var(--spectrum-violet-rgb),.38);color:inherit;background:rgba(var(--surface-rgb),.94);box-shadow:.35rem .4rem 0 rgba(var(--spectrum-violet-rgb),.08);font-size:.68rem;text-decoration:none;transform:translate(-50%,-50%)}.garden-graph>a:hover{z-index:2;border-color:rgb(var(--spectrum-aqua-rgb));transform:translate(-50%,calc(-50% - 3px))}.garden-graph>a i{width:.5rem;aspect-ratio:1;border-radius:50%;background:rgb(var(--spectrum-aqua-rgb));box-shadow:0 0 .5rem rgba(var(--spectrum-aqua-rgb),.5)}.garden-graph>a strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.garden-graph>a small{color:rgb(var(--spectrum-coral-rgb));font:.48rem/1 var(--font-mono)}.garden-graph>p{position:absolute;right:1rem;bottom:1rem;max-width:26rem;color:rgba(var(--text-rgb),.5);font:.55rem/1.6 var(--font-mono);text-align:right}
  .garden-context{min-width:0;padding:1.1rem;border-left:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.58)}.garden-context section+section{margin-top:2rem}.garden-context dl{display:grid;margin:0}.garden-context dl div{display:grid;gap:.35rem;padding:.7rem 0;border-bottom:1px solid rgba(var(--spectrum-violet-rgb),.13)}.garden-context dt{color:rgb(var(--spectrum-violet-rgb));font:.51rem/1 var(--font-mono)}.garden-context dd{margin:0;overflow-wrap:anywhere;color:rgba(var(--text-rgb),.68);font:.62rem/1.55 var(--font-mono)}.garden-context section>div{display:grid;gap:.45rem;padding-top:.8rem}.garden-context section>div a{color:inherit;font-size:.66rem;text-decoration:none}.garden-context section>div a:hover{color:rgb(var(--spectrum-coral-rgb))}.garden-context small{color:rgba(var(--text-rgb),.5);font:.57rem/1.65 var(--font-mono)}
  .garden-sync{position:relative;z-index:1;width:min(74rem,calc(100% - clamp(2rem,8vw,10rem)));margin:clamp(4rem,8vw,8rem) auto 0;border-top:1px solid var(--garden-line);border-bottom:1px solid var(--garden-line)}.garden-sync summary{display:grid;grid-template-columns:auto 1fr auto;gap:2rem;align-items:center;padding:1.2rem 0;cursor:pointer}.garden-sync summary span{font:640 1.15rem/1 var(--font-display)}.garden-sync summary small{color:rgba(var(--text-rgb),.5);font:.57rem/1 var(--font-mono)}.garden-sync summary i{color:rgb(var(--spectrum-coral-rgb));font-style:normal}.garden-sync[open] summary i{transform:rotate(45deg)}.garden-sync>div{display:grid;grid-template-columns:1fr auto;gap:1rem;padding:1.2rem 0 1.5rem}.garden-sync p{grid-column:1/-1;color:rgba(var(--text-rgb),.63);font-size:.7rem;line-height:1.7}.garden-sync code{overflow:auto;padding:.8rem;border:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.66);font:.61rem/1.4 var(--font-mono);white-space:nowrap}.garden-sync button{padding:.7rem 1rem;border:1px solid rgba(var(--spectrum-coral-rgb),.42);color:rgb(var(--spectrum-coral-rgb));background:transparent;font:.58rem/1 var(--font-mono);cursor:pointer}.garden-sync button:hover{color:rgb(var(--bg-rgb));background:rgb(var(--spectrum-coral-rgb))}.garden-sync>div>span{grid-column:1/-1;min-height:1rem;color:rgb(var(--spectrum-gold-rgb));font:.54rem/1 var(--font-mono)}
  [hidden]{display:none!important}
  @media(max-width:1120px){.garden-bar{grid-template-columns:15rem 1fr auto}.garden-hero{grid-template-columns:1fr;gap:2.5rem}.garden-hero__copy{max-width:48rem}.garden-workspace{grid-template-columns:14rem minmax(0,1fr)}.garden-context{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;border-top:1px solid var(--garden-line);border-left:0}.garden-context section+section{margin-top:0}}
  @media(max-width:760px){.garden-bar{grid-template-columns:1fr auto}.garden-bar>p{display:none}.garden-bar nav{border-left:1px solid var(--garden-line)}.garden-bar nav a{display:none}.garden-hero{width:calc(100% - 2rem);min-height:0;padding:4rem 0 3rem}.garden-hero h1{font-size:clamp(4.6rem,23vw,7rem)}.garden-hero__copy dl{grid-template-columns:1fr}.garden-workspace{grid-template-columns:1fr;width:calc(100% - 1rem)}.garden-explorer{border-right:0;border-bottom:1px solid var(--garden-line)}.garden-list{max-height:16rem;overflow:auto}.garden-stage{min-height:34rem}.garden-note{padding:2rem 1.25rem}.garden-note h2{font-size:clamp(2.5rem,13vw,4rem)}.garden-graph{min-height:34rem}.garden-context{grid-template-columns:1fr}.garden-context section+section{margin-top:1rem}.garden-sync{width:calc(100% - 2rem)}.garden-sync summary{grid-template-columns:1fr auto}.garden-sync summary small{grid-column:1/-1;grid-row:2}.garden-sync>div{grid-template-columns:1fr}.garden-home{border-right:0}.garden-home span{font-size:.65rem}}
</style>

<script>
  const workbench = document.querySelector<HTMLElement>('[data-note-workbench]');
  if (workbench) {
    const search = workbench.querySelector<HTMLInputElement>('[data-note-search]');
    const tagButtons = [...workbench.querySelectorAll<HTMLButtonElement>('[data-note-tag]')];
    const entries = [...workbench.querySelectorAll<HTMLElement>('[data-note-entry]')];
    const listEntries = [...workbench.querySelectorAll<HTMLElement>('.garden-list [data-note-entry]')];
    const visibleCount = workbench.querySelector<HTMLElement>('[data-visible-count]');
    const empty = workbench.querySelector<HTMLElement>('[data-note-empty]');
    let activeTag = '';
    const applyFilter = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let count = 0;
      entries.forEach((entry) => {
        const matchesText = !query || `${entry.dataset.noteTitle} ${entry.dataset.noteDescription} ${entry.dataset.noteTags}`.includes(query);
        const matchesTag = !activeTag || (entry.dataset.noteTags ?? '').split('|').includes(activeTag.toLowerCase());
        const visible = matchesText && matchesTag;
        entry.hidden = !visible;
        if (visible && listEntries.includes(entry)) count += 1;
      });
      if (visibleCount) visibleCount.textContent = String(count);
      if (empty) empty.hidden = count !== 0;
    };
    search?.addEventListener('input', applyFilter);
    tagButtons.forEach((button) => button.addEventListener('click', () => {
      activeTag = button.dataset.noteTag ?? '';
      tagButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      applyFilter();
    }));

    const indexView = workbench.querySelector<HTMLElement>('[data-index-view]');
    const mapView = workbench.querySelector<HTMLElement>('[data-map-view]');
    workbench.querySelectorAll<HTMLButtonElement>('[data-note-view]').forEach((button) => button.addEventListener('click', () => {
      const showMap = button.dataset.noteView === 'map';
      if (indexView) indexView.hidden = showMap;
      if (mapView) mapView.hidden = !showMap;
      workbench.querySelectorAll<HTMLButtonElement>('[data-note-view]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    }));

    const field = (selector: string) => workbench.querySelector<HTMLElement>(selector);
    workbench.querySelectorAll<HTMLAnchorElement>('[data-note-preview]').forEach((link) => {
      const update = () => {
        const values: Record<string, string | undefined> = {
          '[data-preview-number]': link.dataset.previewIndex,
          '[data-preview-tags]': link.dataset.previewTags,
          '[data-context-tags]': link.dataset.previewTags,
          '[data-preview-title]': link.dataset.previewTitle,
          '[data-preview-description]': link.dataset.previewDescription,
          '[data-preview-date]': link.dataset.previewDate,
          '[data-preview-source]': link.dataset.previewSource,
          '[data-preview-aliases]': link.dataset.previewAliases,
          '[data-preview-incoming]': link.dataset.previewIncoming,
          '[data-preview-outgoing]': link.dataset.previewOutgoing,
        };
        Object.entries(values).forEach(([selector, value]) => { const node = field(selector); if (node) node.textContent = value ?? ''; });
        const open = workbench.querySelector<HTMLAnchorElement>('[data-preview-open]');
        if (open) open.href = link.href;
        const backlinkCopy = field('[data-backlink-copy]');
        if (backlinkCopy) backlinkCopy.innerHTML = Number(link.dataset.previewIncoming) ? '<small>打开完整笔记查看引用它的公开条目。</small>' : '<small>尚无公开笔记引用当前条目。</small>';
      };
      link.addEventListener('mouseenter', update);
      link.addEventListener('focus', update);
    });

    const status = field('[data-copy-status]');
    workbench.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(button.dataset.copyCommand ?? ''); if (status) status.textContent = '命令已复制，可在项目根目录运行。'; }
      catch { if (status) status.textContent = '浏览器未授权剪贴板，请手动复制上方命令。'; }
    }));
  }
</script>
