---
import { getCollection } from 'astro:content';
import StandaloneLayout from '../../layouts/StandaloneLayout.astro';
import '../../styles/tokens.css';
import '../../styles/shell.css';
import '../../styles/prose.css';
import { withBase } from '../../lib/site-path';
import { buildNoteGraph, NOTE_MATURITY } from '../../lib/note-graph';

const notes = (await getCollection('notes'))
  .filter((note) => note.data.publish && !note.data.draft)
  .sort((a, b) => (b.data.updated ?? b.data.created).getTime() - (a.data.updated ?? a.data.created).getTime());
const tags = [...new Set(notes.flatMap((note) => note.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const latest = notes[0];
const excerpt = (body: string) => body
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_match, target, label) => label ?? target)
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/[*_`>~]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 320);
const previewNotes = notes.map((note) => ({ note, excerpt: excerpt(note.body ?? note.data.description) }));
const formatDate = (value: Date) => value.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const graph = buildNoteGraph(notes);
const relations = graph.relations;
const graphNodes = notes.map((note, index) => {
  const count = Math.max(notes.length, 1);
  const angle = -Math.PI / 2 + index * (Math.PI * 2 / count);
  const radius = notes.length === 1 ? 0 : Math.min(34, 21 + notes.length * 1.8);
  return { note, x: 50 + Math.cos(angle) * radius, y: 50 + Math.sin(angle) * radius };
});
const nodeById = new Map(graphNodes.map((node) => [node.note.id, node]));
const incomingFor = (note: (typeof notes)[number]) => graph.incoming.get(note.id) ?? [];
const outgoingFor = (note: (typeof notes)[number]) => graph.outgoing.get(note.id) ?? [];
const latestIncoming = latest ? incomingFor(latest) : [];
const latestOutgoing = latest ? outgoingFor(latest) : [];
---

<StandaloneLayout title="学习笔记" description="本地知识库经过显式公开后形成的只读知识空间。" theme="mist" back={false} schemaType="CollectionPage">
  <main class="garden" data-note-workbench data-pagefind-body>
    <header class="garden-bar">
      <a class="garden-home" href={withBase('/')} aria-label="返回博客首页"><b>某</b><span><strong>学习笔记</strong><small>PUBLIC VAULT</small></span></a>
      <p class="garden-path"><span>notes</span><i>/</i><strong>{latest?.id ?? 'public'}</strong></p>
      <nav aria-label="学习笔记导航"><a href={withBase('/')}>返回博客</a><span><i></i>{notes.length} PUBLISHED</span></nav>
    </header>

    <section class="garden-workspace" aria-label="公开笔记空间">
      <aside class="garden-explorer" aria-label="笔记资源管理器">
        <header><p>PUBLIC VAULT</p><span><b data-visible-count>{notes.length}</b> / {notes.length}</span></header>
        <label class="garden-search"><span>⌕</span><input type="search" placeholder="搜索公开笔记…" autocomplete="off" data-note-search /></label>
        <div class="garden-tags" aria-label="按标签筛选">
          <button type="button" aria-pressed="true" data-note-tag="">全部</button>
          {tags.map((tag) => <button type="button" aria-pressed="false" data-note-tag={tag}>#{tag}</button>)}
        </div>
        <p class="garden-folder"><span>⌄</span> notes / public</p>
        <ol class="garden-list">
          {notes.map((note, index) => {
            const date = note.data.updated ?? note.data.created;
            const incoming = incomingFor(note);
            const outgoing = outgoingFor(note);
            return <li data-note-entry data-note-title={note.data.title.toLowerCase()} data-note-description={note.data.description.toLowerCase()} data-note-tags={note.data.tags.join('|').toLowerCase()}>
              <a href={withBase(`/notes/${note.id}/`)} data-note-preview
                aria-current={index === 0 ? 'page' : undefined}
                data-preview-id={note.id}
                data-preview-index={String(index + 1).padStart(2, '0')}
                data-preview-file={`${note.id}.md`}
                data-preview-tags={note.data.tags.map((tag) => `#${tag}`).join(' · ') || 'UNTAGGED'}
                data-preview-source={note.data.source ?? '站内创建'}
                data-preview-aliases={note.data.aliases.join(' · ') || '—'}
                data-preview-maturity={NOTE_MATURITY[note.data.maturity].label}
                data-preview-backlinks={JSON.stringify(incoming.map((entry) => ({ title: entry.data.title, href: withBase(`/notes/${entry.id}/`) })))}
                data-preview-outgoing-links={JSON.stringify(outgoing.map((entry) => ({ title: entry.data.title, href: withBase(`/notes/${entry.id}/`) })))}
                data-preview-incoming={String(incoming.length)}
                data-preview-outgoing={String(outgoing.length)}>
                <i aria-hidden="true">◇</i><span><strong>{note.data.title}</strong><small>{formatDate(date)}</small></span>
              </a>
            </li>;
          })}
        </ol>
        <p class="garden-empty" data-note-empty hidden>没有匹配的公开笔记。私人条目不会出现在这里。</p>
      </aside>

      <section class="garden-stage">
        <header class="garden-stage__bar">
          <p><span data-preview-file>{latest ? `${latest.id}.md` : 'public.md'}</span><i>只读投影</i></p>
          <div class="garden-views" aria-label="切换笔记视图">
            <button type="button" aria-pressed="true" data-note-view="index">笔记</button>
            <button type="button" aria-pressed="false" data-note-view="map">关系图</button>
          </div>
        </header>

        <div class="garden-index" data-index-view>
          {previewNotes.length ? previewNotes.map(({ note, excerpt }, index) => <article class="garden-note" data-note-panel={note.id} hidden={index !== 0}>
            <header>
              <p>{NOTE_MATURITY[note.data.maturity].label} · {note.data.tags.map((tag) => `#${tag}`).join(' · ') || 'UNTAGGED'}</p>
              <h2>{note.data.title}</h2>
              <span>{note.data.description}</span>
              <a class="garden-note__open" href={withBase(`/notes/${note.id}/`)}>独立阅读 <span>↗</span></a>
            </header>
            <div class="garden-note__body prose"><p>{excerpt}</p></div>
            <footer><span>LAST SYNC</span><time>{formatDate(note.data.updated ?? note.data.created)}</time></footer>
          </article>) : <article class="garden-note garden-note--empty"><h2>等待第一条公开笔记</h2><p>在本地 Vault 中明确标记公开后，笔记会出现在这里。</p></article>}
        </div>

        <div class="garden-graph" data-map-view hidden>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {relations.map((relation) => {
              const source = nodeById.get(relation.source);
              const target = nodeById.get(relation.target);
              return source && target && <line x1={source.x} y1={source.y} x2={target.x} y2={target.y} />;
            })}
          </svg>
          {graphNodes.map(({ note, x, y }, index) => <a href={withBase(`/notes/${note.id}/`)} style={`--node-x:${x}%;--node-y:${y}%;`} data-note-entry data-note-title={note.data.title.toLowerCase()} data-note-description={note.data.description.toLowerCase()} data-note-tags={note.data.tags.join('|').toLowerCase()}><i></i><strong>{note.data.title}</strong><small>{String(index + 1).padStart(2, '0')}</small></a>)}
          <p>{relations.length ? '线条仅表示公开笔记之间的真实内部链接。' : '当前公开条目尚未形成内部链接；新增 Wiki 链接后，关系线会自然出现。'}</p>
        </div>
      </section>

      <aside class="garden-context" aria-label="当前笔记上下文">
        <section>
          <header><p>PROPERTIES</p><span data-preview-number>{latest ? '01' : '00'}</span></header>
          <dl>
            <div><dt>aliases</dt><dd data-preview-aliases>{latest?.data.aliases.join(' · ') || '—'}</dd></div>
            <div><dt>tags</dt><dd data-context-tags>{latest?.data.tags.join(' · ') || '—'}</dd></div>
            <div><dt>source</dt><dd data-preview-source>{latest?.data.source ?? '站内创建'}</dd></div>
            <div><dt>maturity</dt><dd data-preview-maturity>{latest ? NOTE_MATURITY[latest.data.maturity].label : '—'}</dd></div>
            <div><dt>publish</dt><dd>true</dd></div>
          </dl>
        </section>
        <section class="garden-backlinks">
          <header><p>LINKED MENTIONS</p><span data-preview-incoming>{latestIncoming.length}</span></header>
          <div data-backlink-copy>{latestIncoming.length ? latestIncoming.map((entry) => <a href={withBase(`/notes/${entry.id}/`)}>{entry.data.title} ↗</a>) : <small>尚无公开笔记引用当前条目。</small>}</div>
        </section>
        <section class="garden-outgoing">
          <header><p>OUTGOING LINKS</p><span data-preview-outgoing>{latestOutgoing.length}</span></header>
          <div data-outgoing-copy>{latestOutgoing.length ? latestOutgoing.map((entry) => <a href={withBase(`/notes/${entry.id}/`)}>{entry.data.title} ↗</a>) : <small>当前笔记尚未指向其他公开条目。</small>}</div>
        </section>
      </aside>
    </section>

    <details class="garden-sync">
      <summary><span>本地同步</span><small>Obsidian / Markdown Vault → 公开只读投影</small><i>＋</i></summary>
      <div>
        <p>写作与私人关系留在本机；Blog Studio 负责预演和同步。网页不会获得你的 Vault 写权限。</p>
        <code>pnpm notes:sync -- --source &quot;C:\path\to\vault&quot; --dry-run</code>
        <button type="button" data-copy-command={'pnpm notes:sync -- --source "C:\\path\\to\\vault" --dry-run'}>复制预演命令</button>
        <span role="status" aria-live="polite" data-copy-status></span>
      </div>
    </details>
  </main>
</StandaloneLayout>

<style>
  :global(body) { background: rgb(var(--bg-rgb)); }
  .garden { --garden-paper:rgba(var(--surface-rgb),.94);--garden-line:rgba(var(--spectrum-violet-rgb),.24);display:grid;grid-template-rows:4.25rem minmax(0,1fr) auto;height:100dvh;min-height:42rem;overflow:hidden;color:rgb(var(--text-rgb));background:rgb(var(--bg-rgb));font-family:var(--font-ui)}
  .garden::before{content:'';position:fixed;inset:0;opacity:.38;background-image:linear-gradient(rgba(var(--spectrum-violet-rgb),.05) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--spectrum-violet-rgb),.05) 1px,transparent 1px);background-size:3.2rem 3.2rem;mask-image:linear-gradient(120deg,#000,transparent 78%);pointer-events:none}
  .garden-bar{position:relative;z-index:4;display:grid;grid-template-columns:minmax(15rem,20vw) 1fr auto;min-height:0;border-bottom:1px solid var(--garden-line);background:rgba(var(--bg-rgb),.88);backdrop-filter:blur(18px)}
  .garden-bar>*{display:flex;align-items:center;min-width:0;padding:.65rem 1.15rem}.garden-home{gap:.72rem;border-right:1px solid var(--garden-line);color:inherit;text-decoration:none}.garden-home b{display:grid;width:2.2rem;aspect-ratio:1;place-items:center;color:rgb(var(--bg-rgb));background:rgb(var(--spectrum-aqua-rgb));font:750 .82rem/1 var(--font-display)}.garden-home span{display:grid;gap:.24rem}.garden-home strong{font-size:.72rem}.garden-home small{color:rgba(var(--text-rgb),.45);font:.47rem/1 var(--font-mono);letter-spacing:.1em}.garden-path{gap:.55rem;overflow:hidden;color:rgba(var(--text-rgb),.43);font:.56rem/1 var(--font-mono)}.garden-path i{font-style:normal;color:rgba(var(--text-rgb),.22)}.garden-path strong{overflow:hidden;color:rgba(var(--text-rgb),.68);font-weight:550;text-overflow:ellipsis;white-space:nowrap}.garden-bar nav{gap:1.2rem;border-left:1px solid var(--garden-line);font:.54rem/1 var(--font-mono)}.garden-bar nav a{color:inherit;text-decoration:none}.garden-bar nav span{display:flex;gap:.45rem;align-items:center;color:rgba(var(--text-rgb),.52)}.garden-bar nav i{width:.42rem;aspect-ratio:1;border-radius:50%;background:rgb(var(--spectrum-aqua-rgb));box-shadow:0 0 .6rem rgba(var(--spectrum-aqua-rgb),.65)}
  .garden-workspace{position:relative;z-index:2;display:grid;grid-template-columns:minmax(15rem,20vw) minmax(26rem,1fr) minmax(15rem,20vw);min-height:0;border-bottom:1px solid var(--garden-line);background:var(--garden-paper)}
  .garden-explorer{display:grid;grid-template-rows:auto auto auto auto minmax(0,1fr) auto;min-width:0;min-height:0;padding:1rem;border-right:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.58)}.garden-explorer>header,.garden-context section>header{display:flex;justify-content:space-between;align-items:center;padding-bottom:.75rem;border-bottom:1px solid var(--garden-line)}.garden-explorer>header p,.garden-context header p{font:650 .54rem/1 var(--font-mono);letter-spacing:.09em}.garden-explorer>header span,.garden-context header span{color:rgba(var(--text-rgb),.5);font:.52rem/1 var(--font-mono)}.garden-explorer>header b{color:rgb(var(--spectrum-coral-rgb));font-weight:650}.garden-search{display:flex;gap:.55rem;align-items:center;margin:.8rem 0;padding:.62rem .7rem;border:1px solid var(--garden-line);background:rgba(var(--bg-rgb),.52)}.garden-search:focus-within{border-color:rgb(var(--spectrum-aqua-rgb));box-shadow:0 0 0 2px rgba(var(--spectrum-aqua-rgb),.1)}.garden-search span{color:rgb(var(--spectrum-aqua-rgb))}.garden-search input{min-width:0;width:100%;border:0;outline:0;color:inherit;background:transparent;font-size:.68rem}.garden-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.7rem}.garden-tags button,.garden-views button{padding:.4rem .55rem;border:1px solid var(--garden-line);color:rgba(var(--text-rgb),.57);background:transparent;font:.52rem/1 var(--font-mono);cursor:pointer}.garden-tags button:hover,.garden-tags button[aria-pressed='true'],.garden-views button:hover,.garden-views button[aria-pressed='true']{border-color:rgb(var(--spectrum-violet-rgb));color:rgb(var(--text-rgb));background:rgba(var(--spectrum-violet-rgb),.12)}.garden-folder{padding:.5rem 0;color:rgba(var(--text-rgb),.52);font:.56rem/1 var(--font-mono)}.garden-folder span{color:rgb(var(--spectrum-gold-rgb))}.garden-list{min-height:0;margin:0 -1rem;padding:0 1rem;overflow:auto;list-style:none}.garden-list li a{display:grid;grid-template-columns:1rem minmax(0,1fr);gap:.55rem;padding:.72rem .35rem;border-bottom:1px solid rgba(var(--spectrum-violet-rgb),.13);color:inherit;text-decoration:none}.garden-list li a:hover,.garden-list li a:focus-visible,.garden-list li a[aria-current='page']{background:linear-gradient(90deg,rgba(var(--spectrum-aqua-rgb),.16),transparent)}.garden-list li a[aria-current='page']{box-shadow:inset 2px 0 rgb(var(--spectrum-aqua-rgb))}.garden-list i{color:rgb(var(--spectrum-violet-rgb));font-style:normal}.garden-list span{display:grid;gap:.28rem;min-width:0}.garden-list strong{overflow:hidden;font-size:.7rem;text-overflow:ellipsis;white-space:nowrap}.garden-list small{color:rgba(var(--text-rgb),.44);font:.49rem/1 var(--font-mono)}.garden-empty{padding:1rem;border:1px dashed var(--garden-line);color:rgba(var(--text-rgb),.52);font:.62rem/1.6 var(--font-mono)}
  .garden-stage{display:grid;grid-template-rows:auto minmax(0,1fr);min-width:0;min-height:0;background:linear-gradient(90deg,rgba(var(--spectrum-aqua-rgb),.04),transparent 24%),rgba(var(--surface-rgb),.46)}.garden-stage__bar{display:flex;justify-content:space-between;align-items:center;min-height:3.1rem;padding:0 1rem;border-bottom:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.68)}.garden-stage__bar>p{display:flex;gap:.6rem;align-items:center;overflow:hidden;font:.57rem/1 var(--font-mono)}.garden-stage__bar>p span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.garden-stage__bar>p i{color:rgba(var(--text-rgb),.42);font-style:normal;white-space:nowrap}.garden-views{display:flex;gap:.35rem}.garden-index{min-height:0;overflow:hidden}.garden-note{display:grid;grid-template-rows:auto minmax(0,1fr) auto;height:100%;min-height:0;padding:clamp(1.25rem,2.4vw,2.4rem);overflow:hidden}.garden-note>header{padding-bottom:1.25rem;border-bottom:1px solid rgba(var(--spectrum-violet-rgb),.14)}.garden-note>header>p{color:rgb(var(--spectrum-violet-rgb));font:.54rem/1.4 var(--font-mono);letter-spacing:.06em}.garden-note h2{max-width:24ch;margin:.55rem 0;font:650 clamp(1.65rem,2.8vw,2.8rem)/1.04 var(--font-display);letter-spacing:-.05em}.garden-note>header>span{display:block;max-width:48rem;color:rgba(var(--text-rgb),.68);font-size:.78rem;line-height:1.7}.garden-note__open{display:inline-flex;gap:.55rem;align-items:center;width:max-content;margin-top:.8rem;padding:.5rem 0;border-bottom:1px solid rgba(var(--spectrum-coral-rgb),.45);color:rgb(var(--spectrum-coral-rgb));font-size:.67rem;font-weight:650;text-decoration:none}.garden-note__open:hover{border-color:rgb(var(--spectrum-coral-rgb));transform:translateX(.2rem)}.garden-note__body{min-height:0;max-width:none!important;padding:1.15rem .2rem 1.5rem 0;overflow:auto;font-size:.78rem}.garden-note__body :global(h2){margin-top:1.4rem;font-size:1.05rem;letter-spacing:-.02em}.garden-note__body :global(p),.garden-note__body :global(li){line-height:1.75}.garden-note__body :global(pre){font-size:.65rem}.garden-note footer{display:flex;gap:.7rem;align-items:center;padding-top:.7rem;border-top:1px solid rgba(var(--spectrum-violet-rgb),.14);color:rgba(var(--text-rgb),.44);font:.51rem/1 var(--font-mono)}.garden-note footer time{color:rgb(var(--spectrum-gold-rgb))}.garden-note--empty{display:grid;place-content:center;text-align:center}
  .garden-graph{position:relative;min-height:0;overflow:hidden;background:radial-gradient(circle at 50% 50%,rgba(var(--spectrum-violet-rgb),.13),transparent 18rem),linear-gradient(rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--spectrum-violet-rgb),.055) 1px,transparent 1px);background-size:auto,2.5rem 2.5rem,2.5rem 2.5rem}.garden-graph[hidden]{display:none}.garden-graph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.garden-graph line{vector-effect:non-scaling-stroke;stroke:rgba(var(--spectrum-violet-rgb),.58);stroke-width:1}.garden-graph>a{position:absolute;left:var(--node-x);top:var(--node-y);display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.55rem;align-items:center;max-width:14rem;padding:.7rem .8rem;border:1px solid rgba(var(--spectrum-violet-rgb),.38);color:inherit;background:rgba(var(--surface-rgb),.94);box-shadow:.35rem .4rem 0 rgba(var(--spectrum-violet-rgb),.08);font-size:.68rem;text-decoration:none;transform:translate(-50%,-50%)}.garden-graph>a:hover{z-index:2;border-color:rgb(var(--spectrum-aqua-rgb));transform:translate(-50%,calc(-50% - 3px))}.garden-graph>a i{width:.5rem;aspect-ratio:1;border-radius:50%;background:rgb(var(--spectrum-aqua-rgb));box-shadow:0 0 .5rem rgba(var(--spectrum-aqua-rgb),.5)}.garden-graph>a strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.garden-graph>a small{color:rgb(var(--spectrum-coral-rgb));font:.48rem/1 var(--font-mono)}.garden-graph>p{position:absolute;right:1rem;bottom:1rem;max-width:26rem;color:rgba(var(--text-rgb),.5);font:.55rem/1.6 var(--font-mono);text-align:right}
  .garden-context{min-width:0;min-height:0;padding:1rem;overflow:auto;border-left:1px solid var(--garden-line);background:rgba(var(--surface-rgb),.58)}.garden-context section+section{margin-top:1.7rem}.garden-context dl{display:grid;margin:0}.garden-context dl div{display:grid;gap:.35rem;padding:.7rem 0;border-bottom:1px solid rgba(var(--spectrum-violet-rgb),.13)}.garden-context dt{color:rgb(var(--spectrum-violet-rgb));font:.51rem/1 var(--font-mono)}.garden-context dd{margin:0;overflow-wrap:anywhere;color:rgba(var(--text-rgb),.68);font:.62rem/1.55 var(--font-mono)}.garden-context section>div{display:grid;gap:.45rem;padding-top:.8rem}.garden-context section>div a{color:inherit;font-size:.66rem;text-decoration:none}.garden-context section>div a:hover{color:rgb(var(--spectrum-coral-rgb))}.garden-context small{color:rgba(var(--text-rgb),.5);font:.57rem/1.65 var(--font-mono)}
  .garden-sync{position:relative;z-index:6;width:100%;margin:0;background:rgba(var(--bg-rgb),.95)}.garden-sync summary{display:grid;grid-template-columns:auto 1fr auto;gap:1.1rem;align-items:center;min-height:2.7rem;padding:.55rem 1rem;cursor:pointer}.garden-sync summary span{font:640 .7rem/1 var(--font-display)}.garden-sync summary small{color:rgba(var(--text-rgb),.48);font:.52rem/1 var(--font-mono)}.garden-sync summary i{color:rgb(var(--spectrum-coral-rgb));font-style:normal}.garden-sync[open] summary i{transform:rotate(45deg)}.garden-sync>div{position:absolute;right:0;bottom:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.8rem;width:min(48rem,100%);padding:1rem;border:1px solid var(--garden-line);background:rgb(var(--surface-rgb));box-shadow:0 -1rem 3rem rgba(13,25,31,.12)}.garden-sync p{grid-column:1/-1;color:rgba(var(--text-rgb),.63);font-size:.68rem;line-height:1.65}.garden-sync code{overflow:auto;padding:.75rem;border:1px solid var(--garden-line);background:rgba(var(--bg-rgb),.66);font:.58rem/1.4 var(--font-mono);white-space:nowrap}.garden-sync button{padding:.7rem 1rem;border:1px solid rgba(var(--spectrum-coral-rgb),.42);color:rgb(var(--spectrum-coral-rgb));background:transparent;font:.56rem/1 var(--font-mono);cursor:pointer}.garden-sync button:hover{color:rgb(var(--bg-rgb));background:rgb(var(--spectrum-coral-rgb))}.garden-sync>div>span{grid-column:1/-1;min-height:1rem;color:rgb(var(--spectrum-gold-rgb));font:.54rem/1 var(--font-mono)}
  /* Workbench authenticity cannot come at the cost of legibility. Keep metadata dense, not microscopic. */
