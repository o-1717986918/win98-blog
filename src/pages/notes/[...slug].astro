---
import { getCollection, render } from 'astro:content';
import FullShell from '../../layouts/FullShell.astro';
import ReaderControls from '../../components/chrome/ReaderControls.astro';
import '../../styles/prose.css';
import { withBase } from '../../lib/site-path';
import { buildNoteGraph, NOTE_MATURITY } from '../../lib/note-graph';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => note.data.publish && !note.data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
const allNotes = (await getCollection('notes')).filter((entry) => entry.data.publish && !entry.data.draft);
const graph = buildNoteGraph(allNotes);
const incoming = graph.incoming.get(note.id) ?? [];
const outgoing = graph.outgoing.get(note.id) ?? [];
const maturity = NOTE_MATURITY[note.data.maturity];
---

<FullShell title={note.data.title} description={note.data.description || `学习笔记：${note.data.title}`} pageKind="page">
  <main class="page-wrap note-page">
    <header class="h-entry"><p>LEARNING NOTE / {maturity.label.toUpperCase()}</p><h1 class="p-name">{note.data.title}</h1><span class="p-summary">{note.data.description}</span><dl><div><dt>成熟度</dt><dd>{maturity.label}</dd></div><div><dt>实质更新</dt><dd><time class="dt-updated" datetime={(note.data.updated ?? note.data.created).toISOString()}>{(note.data.updated ?? note.data.created).toLocaleDateString('zh-CN')}</time></dd></div><div><dt>标签</dt><dd>{note.data.tags.join(' · ') || '未标注'}</dd></div><div><dt>来源</dt><dd>{note.data.source ?? '站内创建'}</dd></div></dl><small>{maturity.description}</small></header>
    <div class="note-page__grid"><article class="prose e-content" data-pagefind-body data-reading-surface><Content /></article><aside><p>NOTE MAP</p>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}<div><span>反向链接</span>{incoming.length ? incoming.map((entry) => <a href={withBase(`/notes/${entry.id}/`)}>{entry.data.title} ↗</a>) : <small>尚无公开笔记引用此页。</small>}</div><div><span>延伸阅读</span>{outgoing.length ? outgoing.map((entry) => <a href={withBase(`/notes/${entry.id}/`)}>{entry.data.title} ↗</a>) : <small>此页尚未指向其他公开笔记。</small>}</div></aside></div>
    <a class="note-page__back" href={withBase('/notes/')}>← 返回学习笔记</a>
  </main>
  <ReaderControls />
</FullShell>

<style>
  .note-page{padding:clamp(4rem,8vw,7rem) 0}.note-page>header{width:min(52rem,100%);padding:0 0 2rem;border-bottom:1px solid var(--line)}.note-page>header>p{color:rgb(var(--spectrum-violet-rgb));font:.68rem/1 var(--font-mono);letter-spacing:.1em}.note-page h1{margin:1rem 0;font:640 clamp(2.7rem,6vw,5rem)/1.02 var(--font-display);letter-spacing:-.06em}.note-page>header>span{color:rgba(var(--text-rgb),.66);line-height:1.8}.note-page>header>small{display:block;margin-top:1rem;color:rgba(var(--text-rgb),.55);font:.68rem/1.6 var(--font-mono)}.note-page header dl{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin:1.4rem 0 0}.note-page dt{color:rgba(var(--text-rgb),.5);font:.58rem/1 var(--font-mono)}.note-page dd{margin:.35rem 0 0;color:rgb(var(--spectrum-gold-rgb));font:.66rem/1.4 var(--font-mono)}.note-page__grid{display:grid;grid-template-columns:minmax(0,1fr) 13rem;gap:clamp(2rem,7vw,6rem);width:min(65rem,100%);margin-top:3rem}.note-page__grid aside{position:sticky;top:calc(var(--header) + 2rem);align-self:start}.note-page__grid aside>p,.note-page__grid aside>div>span{display:block;margin-bottom:.7rem;color:rgba(var(--text-rgb),.5);font:.6rem/1 var(--font-mono);letter-spacing:.08em}.note-page__grid aside>a,.note-page__grid aside>div>a{display:block;padding:.45rem 0 .45rem .7rem;border-left:1px solid var(--line);font-size:.76rem;text-decoration:none}.note-page__grid aside>div{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--line)}.note-page__grid aside small{color:rgba(var(--text-rgb),.54);font:.64rem/1.6 var(--font-mono)}.note-page__back{display:inline-block;margin-top:4rem;color:rgb(var(--signal-rgb));font:.74rem/1 var(--font-mono);text-decoration:none}@media(max-width:900px){.note-page__grid{grid-template-columns:1fr}.note-page__grid aside{position:static}}
</style>
