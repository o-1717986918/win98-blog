---
import Icon from './Icon.astro';

const canSubmit = import.meta.env.DEV || Astro.site?.origin === 'https://win98.site';
---

{canSubmit ? (
  <form class="registration" action="/api/github-onboarding/register-student" method="post" data-registration>
    <h3 class="form-heading">登记 GitHub 账号</h3>
    <label for="github-username">GitHub 用户名或个人主页链接</label>
    <div class="input-row">
      <input id="github-username" name="github_username" type="text" autocapitalize="none" spellcheck="false" autocomplete="username" placeholder="例如 example-user" required maxlength="250" aria-describedby="registration-help" />
    </div>
    <div class="student-field">
      <label for="student-info">专业、班级、姓名</label>
      <p class="registration-visibility" id="registration-visibility">提交后，你的 GitHub 账号、专业、班级、姓名和邀请状态会同步到培训组织的 GitHub 名单。培训团队成员和其他有名单权限的组织成员可查看。</p>
      <input type="hidden" name="directory_notice" value="org-members-v1" />
      <div class="input-row">
        <input id="student-info" name="student_info" type="text" spellcheck="false" autocomplete="off" placeholder="例如：计算机26-4王小明" required maxlength="96" aria-describedby="registration-visibility" />
        <button class="button" type="submit" disabled><span>提交并获取邀请</span><Icon name="arrow" /></button>
      </div>
    </div>
    <div class="form-trap" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <p class="form-help" id="registration-help">提交后自动收到github组织邀请</p>
    <div class="form-status" role="status" aria-live="polite"></div>
    <a class="text-link" href="#invitation" data-continue hidden>继续：接受组织邀请 <Icon name="arrow" /></a>
    <noscript><p>请启用 JavaScript 后提交登记。</p></noscript>
  </form>
) : (
  <div class="registration">
    <a class="button" href="https://win98.site/posts/github-onboarding/#register">前往正式站点登记 <Icon name="external" /></a>
  </div>
)}
