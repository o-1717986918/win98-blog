---
import Icon from './Icon.astro';
interface Props {
  command: string;
  customize?: boolean;
}
const { command, customize } = Astro.props;
---

<div class="code-block">
  <div class="code-toolbar">
    <button type="button" data-copy-command hidden><Icon name="copy" /><span>复制命令</span></button>
  </div>
  <pre tabindex="0"><code data-command-template={customize ? command : undefined}>{command}</code></pre>
</div>
