---
import '../styles/tokens.css';
import '../styles/minimal.css';
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import AmbientField from '../components/AmbientField.astro';
import BackBadge from '../components/chrome/BackBadge.astro';
import ReaderControls from '../components/chrome/ReaderControls.astro';
import TableOfContents from '../components/chrome/TableOfContents.astro';
import { formatDate, type ColumnEntry, type PostEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props { post: PostEntry; columns: ColumnEntry[]; headings: MarkdownHeading[]; }
const { post, columns, headings } = Astro.props;
const showToc = !post.data.hideToc && headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;
---

<BaseLayout title={post.data.title} description={post.data.description} theme={post.data.theme} pageKind="post">
  <AmbientField />
  {post.data.back && <BackBadge />}
  <main class="minimal-main">
    <article class="article-page">
      <header class="article-head">
        <p class="eyebrow">MINIMAL ARTICLE</p>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {columns.map((column) => <a href={`/columns/${column.id}/`}>{column.data.title}</a>)}
        </div>
      </header>
      <div class:list={['article-grid', { 'article-grid--no-toc': !showToc }]}>
        <div class="prose"><slot /></div>
        {showToc && <TableOfContents headings={headings} />}
      </div>
    </article>
  </main>
  <ReaderControls />
</BaseLayout>
