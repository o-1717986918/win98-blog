---
import '../styles/tokens.css';
import '../styles/minimal.css';
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import { getImage, Image } from 'astro:assets';
import AmbientField from '../components/AmbientField.astro';
import BackBadge from '../components/chrome/BackBadge.astro';
import ReaderControls from '../components/chrome/ReaderControls.astro';
import TableOfContents from '../components/chrome/TableOfContents.astro';
import ArticleTools from '../components/ArticleTools.astro';
import Analytics from '../components/Analytics.astro';
import Comments from '../components/Comments.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { formatDate, tagPath, type ColumnEntry, type PostEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props { post: PostEntry; columns: ColumnEntry[]; headings: MarkdownHeading[]; related: PostEntry[]; }
const { post, columns, headings, related } = Astro.props;
const showToc = !post.data.hideToc && headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;
const socialImage = post.data.cover ? await getImage({ src: post.data.cover.src, width: 1200, format: 'webp' }) : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description} theme={post.data.theme} pageKind="post" image={socialImage?.src} published={post.data.date} updated={post.data.updated} tags={post.data.tags} noindex={post.data.noindex}>
  <AmbientField />
  {post.data.back && <BackBadge />}
  <main class="minimal-main">
    <article class="article-page">
      <header class="article-head">
        <p class="eyebrow">FOCUSED READING</p>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {columns.map((column) => <a href={`/columns/${column.id}/`}>{column.data.title}</a>)}
          {post.data.tags.map((tag) => <a href={tagPath(tag)}>#{tag}</a>)}
        </div>
      </header>
      {post.data.cover && <Image class="article-cover" src={post.data.cover.src} alt={post.data.cover.alt} widths={[640, 960, 1280]} sizes="(max-width: 800px) 100vw, 800px" loading="eager" />}
      <div class:list={['article-grid', { 'article-grid--no-toc': !showToc }]}>
        <div class="prose"><slot /></div>
        {showToc && <TableOfContents headings={headings} />}
      </div>
      <ArticleTools />
      <RelatedPosts posts={related} />
      <Comments preference={post.data.comments} />
      <p class="article-license">本文采用 {post.data.license} 许可；转载时请保留作者与原文链接。</p>
    </article>
  </main>
  <ReaderControls />
  <Analytics />
</BaseLayout>
