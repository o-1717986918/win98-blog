---
import '../styles/tokens.css';
import '../styles/minimal.css';
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import AmbientField from '../components/AmbientField.astro';
import ArticleBody from '../components/ArticleBody.astro';
import BackBadge from '../components/chrome/BackBadge.astro';
import ReaderControls from '../components/chrome/ReaderControls.astro';
import Analytics from '../components/Analytics.astro';
import type { ColumnEntry, PostEntry } from '../lib/content';
import { socialImagePath } from '../lib/social-image';
import BaseLayout from './BaseLayout.astro';

interface Props { post: PostEntry; columns: ColumnEntry[]; columnLookup: Map<string, ColumnEntry>; headings: MarkdownHeading[]; related: PostEntry[]; }
const { post, columns, columnLookup, headings, related } = Astro.props;
const socialImage = post.data.cover ? (await getImage({ src: post.data.cover.src, width: 1200, format: 'webp' })).src : socialImagePath('posts', post.id);
---

<BaseLayout title={post.data.title} description={post.data.description} theme={post.data.theme} pageKind="post" image={socialImage} published={post.data.date} updated={post.data.updated} tags={post.data.tags} noindex={post.data.noindex}>
  <AmbientField />
  <BackBadge />
  <main class="minimal-main">
    <ArticleBody {post} {columns} {columnLookup} {headings} {related} eyebrow="QUIET READING"><slot /></ArticleBody>
  </main>
  <ReaderControls />
  <Analytics />
</BaseLayout>
