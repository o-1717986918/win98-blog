---
import { resolveTheme, SITE, type ThemeId } from '../config/site';
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../lib/site-path';

interface Props {
  title: string;
  description?: string;
  theme?: ThemeId;
  pageKind?: 'page' | 'post' | 'column' | 'standalone';
  image?: string | undefined;
  published?: Date | undefined;
  updated?: Date | undefined;
  tags?: string[] | undefined;
  noindex?: boolean | undefined;
  schemaType?: 'WebPage' | 'CollectionPage' | 'ProfilePage' | undefined;
}

const {
  title,
  description = SITE.description,
  theme = SITE.defaultTheme,
  pageKind = 'page',
  image,
  published,
  updated,
  tags,
  noindex,
  schemaType,
} = Astro.props;
const documentTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedTheme = resolveTheme(theme);
const webmentionEndpoint = (() => {
  try {
    const endpoint = new URL(import.meta.env.PUBLIC_WEBMENTION_ENDPOINT ?? '');
    return endpoint.protocol === 'https:' ? endpoint.href : '';
  } catch { return ''; }
})();
---

<!doctype html>
<html lang={SITE.language} data-theme={resolvedTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={resolvedTheme === 'mist' ? '#e7eceb' : '#091115'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={withBase('/rss.xml')} />
    {webmentionEndpoint && <link rel="webmention" href={webmentionEndpoint} />}
    <link rel="icon" href={withBase('/brand/logo.jpg')} type="image/jpeg" sizes="640x640" />
    <link rel="apple-touch-icon" href={withBase('/brand/logo.jpg')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <SeoHead {title} {description} {canonical} {pageKind} {image} {published} {updated} {tags} {noindex} {schemaType} />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body data-page-kind={pageKind}>
    <slot />
  </body>
</html>
