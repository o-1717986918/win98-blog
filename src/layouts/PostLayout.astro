---
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import ReaderControls from '../components/chrome/ReaderControls.astro';
import ArticleBody from '../components/ArticleBody.astro';
import type { ColumnEntry, PostEntry } from '../lib/content';
import { socialImagePath } from '../lib/social-image';
import FullShell from './FullShell.astro';

interface Props {
  post: PostEntry;
  columns: ColumnEntry[];
  columnLookup: Map<string, ColumnEntry>;
  headings: MarkdownHeading[];
  related: PostEntry[];
  previous?: PostEntry | undefined;
  next?: PostEntry | undefined;
}
const { post, columns, columnLookup, headings, related, previous, next } = Astro.props;
const socialImage = post.data.cover ? (await getImage({ src: post.data.cover.src, width: 1200, format: 'webp' })).src : socialImagePath('posts', post.id);
---

<FullShell title={post.data.title} description={post.data.description} theme={post.data.theme} pageKind="post" image={socialImage} published={post.data.date} updated={post.data.updated} tags={post.data.tags} noindex={post.data.noindex}>
  <div class="page-wrap">
    <ArticleBody {post} {columns} {columnLookup} {headings} {related} {previous} {next} eyebrow="FROM THE NOTEBOOK"><slot /></ArticleBody>
  </div>
  <ReaderControls />
</FullShell>
