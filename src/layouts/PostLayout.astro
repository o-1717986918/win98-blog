---
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import ReaderControls from '../components/chrome/ReaderControls.astro';
import TableOfContents from '../components/chrome/TableOfContents.astro';
import { formatDate, type ColumnEntry, type PostEntry } from '../lib/content';
import FullShell from './FullShell.astro';

interface Props {
  post: PostEntry;
  columns: ColumnEntry[];
  headings: MarkdownHeading[];
  previous?: PostEntry | undefined;
  next?: PostEntry | undefined;
}
const { post, columns, headings, previous, next } = Astro.props;
const showToc = !post.data.hideToc && headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;
---

<FullShell title={post.data.title} description={post.data.description} theme={post.data.theme} pageKind="post">
  <article class:list={['article-page', 'page-wrap', { 'article-page--wide': post.data.wide }]}>
    <header class="article-head">
      <p class="eyebrow">ARTICLE / {post.data.chrome.toUpperCase()}</p>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.minutes && <span>约 {post.data.minutes} 分钟</span>}
        <span class="article-chrome">CHROME {post.data.chrome.toUpperCase()}</span>
        {columns.map((column) => <a href={`/columns/${column.id}/`}>{column.data.title}</a>)}
      </div>
    </header>
    <div class:list={['article-grid', { 'article-grid--no-toc': !showToc }]}>
      <div class="prose"><slot /></div>
      {showToc && <TableOfContents headings={headings} />}
    </div>
    {(previous || next) && (
      <nav class="post-navigation" aria-label="相邻文章">
        {previous ? <a href={`/posts/${previous.id}/`}><small>上一篇</small><span>{previous.data.title}</span></a> : <span></span>}
        {next ? <a href={`/posts/${next.id}/`}><small>下一篇</small><span>{next.data.title}</span></a> : <span></span>}
      </nav>
    )}
  </article>
  <ReaderControls />
</FullShell>
