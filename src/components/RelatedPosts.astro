---
import { formatDate, tagPath, type PostEntry } from '../lib/content';
interface Props { posts: PostEntry[]; }
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <aside class="related" aria-labelledby="related-heading">
    <div class="related__head"><h2 id="related-heading">继续阅读</h2><span>RELATED</span></div>
    <div class="related__grid">
      {posts.map((post) => (
        <article>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <div>{post.data.tags.slice(0, 2).map((tag) => <a href={tagPath(tag)}>#{tag}</a>)}</div>
        </article>
      ))}
    </div>
  </aside>
)}

<style>
  .related { margin-top: clamp(4rem, 9vw, 7rem); padding-top: 2rem; border-top: 1px solid var(--line); }
  .related__head { display: flex; align-items: baseline; gap: .8rem; margin-bottom: 1.2rem; }
  .related__head h2 { font-size: 1.15rem; }
  .related__head span { color: rgba(var(--text-rgb), .42); font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; }
  .related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  article { min-width: 0; padding: 1.25rem; background: rgba(var(--surface-rgb), .8); }
  time, article > div { color: rgba(var(--text-rgb), .43); font-family: var(--font-mono); font-size: .57rem; }
  h3 { margin: .65rem 0 .45rem; font-size: .98rem; line-height: 1.5; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: rgb(var(--signal-rgb)); }
  p { color: rgba(var(--text-rgb), .55); font-size: .75rem; line-height: 1.7; }
  article > div { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .8rem; }
  article > div a { color: rgb(var(--signal-rgb)); text-decoration: none; }
  @media (max-width: 760px) { .related__grid { grid-template-columns: 1fr; } }
</style>
