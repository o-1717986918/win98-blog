---
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? 'none';
const cloudflareToken = provider === 'cloudflare' ? import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN : '';
const umamiScript = (() => {
  if (provider !== 'umami') return '';
  try {
    const parsed = new URL(import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ?? '');
    return parsed.protocol === 'https:' ? parsed.href : '';
  } catch { return ''; }
})();
const umamiWebsite = provider === 'umami' ? import.meta.env.PUBLIC_UMAMI_WEBSITE_ID : '';
---

{cloudflareToken && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: cloudflareToken })}></script>
)}
{umamiScript && umamiWebsite && (
  <script is:inline defer src={umamiScript} data-website-id={umamiWebsite}></script>
)}
