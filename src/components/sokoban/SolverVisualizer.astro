---
const defaultMap = [
  '################', '#---#------#---#', '#-$---####-.-*-#', '###-#----#-#---#',
  '#-*---##-$-#---#', '#-###--#---###-#', '#@--##-*-#---.-#', '###----#---###-#',
  '#---##-$-#-----#', '#-#----#---#.--#', '#---####---#####', '################',
].join('\n');
---

<section class="solver-viz" id="live-solver" data-solver-viz aria-labelledby="solver-viz-title">
  <div class="solver-viz__head"><div><p>LIVE CORE / C99 → WEBASSEMBLY</p><h2 id="solver-viz-title">把 C 内核的完整路径真正执行一遍</h2></div><span class="solver-status" data-status data-state="loading">LOADING WASM</span></div>
  <div class="solver-mode" role="group" aria-label="选择回放阶段">
    <button type="button" data-trace="recognition" aria-pressed="true">01 · 识别路径</button><button type="button" data-trace="planning" aria-pressed="false" disabled>02 · 完整规划</button>
    <p><span data-trace-summary>等待 C 内核返回路径</span><b data-event>INPUT</b></p>
  </div>
  <div class="solver-viz__workspace">
    <div class="solver-stage">
      <div class="solver-board" data-board role="img" aria-label="推箱炸障地图逐步状态"></div>
      <div class="solver-timeline"><div><span>TRACE</span><strong data-phase>INPUT MAP</strong></div><dl><div><dt>STEP</dt><dd data-step>00 / 00</dd></div><div><dt>TURN</dt><dd data-turns>0</dd></div><div><dt>POSITION</dt><dd data-position>—</dd></div></dl><input data-range type="range" min="0" max="0" value="0" aria-label="当前路径回放进度" /></div>
      <div class="solver-path-track" data-path-track aria-label="完整路径序列"><p>路径会在求解后逐步展开。</p></div>
    </div>
    <aside class="solver-console">
      <label for="solver-map"><span>MAP INPUT</span><small>`# @ $ . * -` · 最大 16×12 · 箱/口/弹各最多 6</small></label><textarea id="solver-map" data-map spellcheck="false" rows="12">{defaultMap}</textarea>
      <div class="solver-run"><button type="button" data-action="recognize">只跑识别</button><button type="button" data-action="solve">识别 + 完整规划</button><button type="button" data-action="stop" disabled>停止</button></div>
      <p class="solver-message" data-message aria-live="polite">正在初始化 20 个 C 源文件构建的 Wasm 内核。</p>
      <dl class="solver-metrics"><div><dt>RECOGNITION</dt><dd data-rec-metric>—</dd></div><div><dt>PLANNING</dt><dd data-plan-metric>—</dd></div><div><dt>ENGINE TIME</dt><dd data-time>—</dd></div><div><dt>ENTITY RECEIPT</dt><dd data-entities>—</dd></div></dl>
      <div class="solver-paths"><div><span>REC PATH</span><code data-rec-path>等待求解</code></div><div><span>PLAN PATH</span><code data-plan-path>完整规划模式才会产生</code></div></div>
      <div class="solver-legend" aria-label="地图图例"><span><i class="box"></i>箱子</span><span><i class="bomb"></i>炸弹</span><span><i class="exit"></i>出口</span><span><i class="blast"></i>爆破范围</span></div>
    </aside>
  </div>
  <div class="solver-controls"><button type="button" data-action="play" disabled>回放当前路径</button><button type="button" data-action="step" disabled>单步</button><button type="button" data-action="start-map">初始地图</button><button type="button" data-action="end-map" disabled>识别后地图</button><button type="button" data-action="final-map" disabled>规划结束</button><button type="button" data-action="reset">恢复内置地图</button><label>回放速度 <select data-speed><option value="480">1×</option><option value="220" selected>2×</option><option value="80">快速</option></select></label></div>
  <p class="solver-viz__note">路径、完成数和引爆数来自真实 C99 → Wasm 内核；浏览器只按原 `anim_engine` 语义重放。大写表示行走，小写表示推动。炸弹进入墙格时触发 3×3 清墙动画，非法路径会在对应步骤中止。</p>
</section>

<style>
  .solver-viz{--lime:#9dd17d;--amber:#f2b75e;--red:#e46c66;--blue:#6ab9d6;--line:#31434e;margin:4rem 0;border:1px solid var(--line);background:#0b1217;color:#e7eeea;box-shadow:12px 12px 0 #d4c8a5}.solver-viz__head{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding:1.4rem 1.5rem;border-bottom:1px solid var(--line)}.solver-viz__head p{margin:0;color:var(--lime);font:.58rem/1 ui-monospace,monospace;letter-spacing:.12em}.solver-viz__head h2{margin:.5rem 0 0!important;padding:0!important;border:0!important;color:#e7eeea!important;font-family:'Segoe UI','PingFang SC',sans-serif!important;font-size:clamp(1.35rem,3vw,2.4rem)!important;font-weight:700!important;letter-spacing:-.04em!important}.solver-status{padding:.48rem .6rem;border:1px solid #52616a;color:#94a3aa;font:.56rem/1 ui-monospace,monospace;letter-spacing:.08em}.solver-status[data-state='ready']{border-color:var(--lime);color:var(--lime)}.solver-status[data-state='running']{border-color:var(--amber);color:var(--amber)}.solver-status[data-state='error']{border-color:var(--red);color:var(--red)}
  .solver-mode{display:grid;grid-template-columns:auto auto minmax(0,1fr);border-bottom:1px solid var(--line)}.solver-mode>button{padding:.85rem 1rem;border:0;border-right:1px solid var(--line);color:#81939c;background:#0e181e;font:.58rem/1 ui-monospace,monospace;cursor:pointer}.solver-mode>button[aria-pressed='true']{color:#0b1217;background:var(--lime)}.solver-mode>button:disabled{cursor:not-allowed;opacity:.38}.solver-mode>p{display:flex;justify-content:flex-end;gap:1rem;align-items:center;min-width:0;margin:0!important;padding:.65rem 1rem;color:#70828c!important;font:.54rem/1.4 ui-monospace,monospace!important}.solver-mode>p span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.solver-mode>p b{color:var(--amber);font-weight:500;white-space:nowrap}
  .solver-viz__workspace{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(19rem,.8fr)}.solver-stage{min-width:0;border-right:1px solid var(--line)}.solver-board{display:grid;align-content:center;gap:2px;min-height:34rem;padding:clamp(.8rem,2.5vw,2rem);background:radial-gradient(circle at 40% 45%,rgba(106,185,214,.07),transparent 45%)}:global(.solver-cell){position:relative;display:grid;aspect-ratio:1;place-items:center;border:1px solid rgba(87,110,122,.13);background:#101a20;color:#647783;font:clamp(.5rem,1.3vw,.86rem)/1 ui-monospace,monospace;transition:background .16s ease,transform .16s ease}:global(.solver-cell.wall){background:#26343c;border-color:#3b4b54}:global(.solver-cell.box){background:#b98131;color:#17120a}:global(.solver-cell.box.completed){box-shadow:inset 0 0 0 3px var(--lime)}:global(.solver-cell.bomb){border-radius:50%;background:#b64242;color:#fff;transform:scale(.72)}:global(.solver-cell.exit){border:2px solid var(--blue);background:rgba(106,185,214,.08);color:var(--blue)}:global(.solver-cell.trail)::after{content:'';width:.24rem;height:.24rem;border-radius:50%;background:rgba(157,209,125,.36)}:global(.solver-cell.actor)::before{content:'▲';position:absolute;z-index:4;display:grid;inset:8%;place-items:center;border-radius:50%;background:var(--lime);color:#0b1217;font-size:clamp(.55rem,1.2vw,.9rem);box-shadow:0 0 0 .25rem rgba(157,209,125,.13)}:global(.solver-cell.pushed){animation:solver-push .34s ease}:global(.solver-cell.cleared){background:rgba(242,183,94,.22);box-shadow:inset 0 0 0 1px var(--amber)}:global(.solver-cell.explosion)::before{content:'';position:absolute;z-index:5;width:170%;aspect-ratio:1;border:2px solid var(--amber);border-radius:50%;background:radial-gradient(circle,#fff 0 8%,var(--amber) 9% 24%,rgba(228,108,102,.72) 25% 44%,transparent 46%);animation:solver-blast .7s ease-out both;pointer-events:none}@keyframes solver-push{50%{transform:scale(.82)}}@keyframes solver-blast{from{opacity:1;transform:scale(.2)}to{opacity:0;transform:scale(1.25)}}.solver-timeline{display:grid;grid-template-columns:minmax(8rem,1fr) auto minmax(8rem,1fr);gap:1rem;align-items:center;padding:1rem 1.2rem;border-top:1px solid var(--line)}.solver-timeline>div>span{color:#71848f;font:.52rem/1 ui-monospace,monospace}.solver-timeline>div>strong{display:block;margin-top:.35rem;color:var(--lime);font:.64rem/1 ui-monospace,monospace}.solver-timeline dl{display:flex;gap:1rem;margin:0}.solver-timeline dt{color:#657780;font:.48rem/1 ui-monospace,monospace}.solver-timeline dd{margin:.35rem 0 0;color:#dfe7e2;font:.62rem/1 ui-monospace,monospace}.solver-timeline input{width:100%;accent-color:var(--lime)}
  .solver-path-track{display:flex;gap:.18rem;min-height:3.3rem;padding:.65rem 1rem;overflow-x:auto;border-top:1px solid var(--line);scrollbar-color:#405561 transparent}.solver-path-track p{margin:auto 0!important;color:#657780!important;font:.54rem/1.4 ui-monospace,monospace!important}.solver-path-track :global(button){flex:0 0 1.5rem;height:1.8rem;padding:0;border:1px solid #2d414c;color:#7f949e;background:#0d171d;font:.52rem/1 ui-monospace,monospace;cursor:pointer}.solver-path-track :global(button.push){border-color:rgba(242,183,94,.5);color:var(--amber)}.solver-path-track :global(button.past){background:#1d2d34;color:#b7c7bf}.solver-path-track :global(button.active){border-color:var(--lime);color:#08110d;background:var(--lime)}
  .solver-console{padding:1.2rem}.solver-console label{display:grid;gap:.35rem}.solver-console label span,.solver-paths span{color:var(--lime);font:.56rem/1 ui-monospace,monospace;letter-spacing:.09em}.solver-console label small{color:#71828a;font:.53rem/1.4 ui-monospace,monospace}.solver-console textarea{width:100%;margin-top:.75rem;padding:.85rem;resize:vertical;border:1px solid #384b55;background:#0e181e;color:#cfddd5;font:.66rem/1.48 ui-monospace,monospace;tab-size:2}.solver-console textarea:focus{outline:2px solid var(--blue);outline-offset:2px}.solver-run{display:grid;grid-template-columns:1fr 1.35fr auto;gap:.45rem;margin-top:.65rem}.solver-run button,.solver-controls button,.solver-controls select{border:1px solid #455965;background:#111d24;color:#dce6e0;padding:.6rem .7rem;font:.58rem/1 ui-monospace,monospace;cursor:pointer}.solver-run button:nth-child(2){border-color:var(--lime);background:var(--lime);color:#0b1217}.solver-run button:disabled,.solver-controls button:disabled{cursor:not-allowed;opacity:.4}.solver-message{min-height:3.3rem;margin:.8rem 0 0!important;padding:.7rem;border-left:3px solid var(--blue);background:rgba(106,185,214,.06);color:#98a8b0!important;font:.6rem/1.65 ui-monospace,monospace!important}.solver-message.error{border-color:var(--red);color:#e8aaa6!important}.solver-metrics{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin:.8rem 0;background:var(--line)}.solver-metrics>div{min-width:0;padding:.65rem;background:#0d161b}.solver-metrics dt{color:#6d808a;font:.48rem/1 ui-monospace,monospace}.solver-metrics dd{margin:.4rem 0 0;overflow-wrap:anywhere;color:#e2eae5;font:.6rem/1.4 ui-monospace,monospace}.solver-paths{display:grid;gap:.5rem}.solver-paths>div{padding:.7rem;border:1px solid var(--line)}.solver-paths code{display:block;max-height:5.6rem;margin-top:.5rem!important;padding:0!important;overflow:auto;overflow-wrap:anywhere;background:transparent!important;color:var(--amber)!important;font:.58rem/1.6 ui-monospace,monospace}.solver-legend{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:.8rem;color:#71838c;font:.52rem/1 ui-monospace,monospace}.solver-legend span{display:flex;gap:.35rem;align-items:center}.solver-legend i{width:.62rem;height:.62rem;border:1px solid #4d626d}.solver-legend .box{background:#b98131}.solver-legend .bomb{border-radius:50%;background:#b64242}.solver-legend .exit{border:2px solid var(--blue)}.solver-legend .blast{border-color:var(--amber);background:rgba(242,183,94,.22)}
  .solver-controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;padding:1rem 1.5rem;border-top:1px solid var(--line)}.solver-controls label{display:flex;gap:.5rem;align-items:center;margin-left:auto;color:#788b95;font:.55rem/1 ui-monospace,monospace}.solver-viz__note{margin:0!important;padding:.8rem 1.5rem;border-top:1px solid var(--line);color:#72858f!important;font:.58rem/1.7 ui-monospace,monospace!important}
  @media(max-width:850px){.solver-viz__head{align-items:start;flex-direction:column}.solver-mode{grid-template-columns:1fr 1fr}.solver-mode>p{grid-column:1/-1;justify-content:space-between}.solver-viz__workspace{grid-template-columns:1fr}.solver-stage{border-right:0;border-bottom:1px solid var(--line)}.solver-board{min-height:auto}.solver-timeline{grid-template-columns:1fr}.solver-timeline dl{justify-content:space-between}.solver-controls label{width:100%;margin-left:0}}@media(max-width:520px){.solver-run{grid-template-columns:1fr 1fr}.solver-run button:last-child{grid-column:1/-1}.solver-metrics{grid-template-columns:1fr}.solver-timeline{padding:.8rem}.solver-controls{padding:.8rem}.solver-status{align-self:stretch;text-align:center}}
</style>

<script>
  type Point={x:number;y:number};type ReplayEvent={type:'input'|'walk'|'push-box'|'push-bomb'|'explode'|'error';label:string;point?:Point|undefined;cleared?:string[]|undefined};type ReplayState={width:number;height:number;actor:Point;walls:Set<string>;exits:Set<string>;boxes:Point[];bombs:Point[];event:ReplayEvent;move:string};type Trace={label:string;path:string;states:ReplayState[];error?:string|undefined};
  const root=document.querySelector<HTMLElement>('[data-solver-viz]');
  if(root){
    function q<T extends Element>(value:string){return root!.querySelector<T>(value)!}const mapInput=q<HTMLTextAreaElement>('[data-map]'),board=q<HTMLElement>('[data-board]'),status=q<HTMLElement>('[data-status]'),message=q<HTMLElement>('[data-message]'),range=q<HTMLInputElement>('[data-range]'),speed=q<HTMLSelectElement>('[data-speed]'),play=q<HTMLButtonElement>('[data-action="play"]'),stepButton=q<HTMLButtonElement>('[data-action="step"]'),stopButton=q<HTMLButtonElement>('[data-action="stop"]'),endMapButton=q<HTMLButtonElement>('[data-action="end-map"]'),finalMapButton=q<HTMLButtonElement>('[data-action="final-map"]'),recPathOut=q<HTMLElement>('[data-rec-path]'),planPathOut=q<HTMLElement>('[data-plan-path]'),recMetric=q<HTMLElement>('[data-rec-metric]'),planMetric=q<HTMLElement>('[data-plan-metric]'),timeMetric=q<HTMLElement>('[data-time]'),entityMetric=q<HTMLElement>('[data-entities]'),stepOut=q<HTMLElement>('[data-step]'),turnOut=q<HTMLElement>('[data-turns]'),positionOut=q<HTMLElement>('[data-position]'),phaseOut=q<HTMLElement>('[data-phase]'),eventOut=q<HTMLElement>('[data-event]'),traceSummary=q<HTMLElement>('[data-trace-summary]'),pathTrack=q<HTMLElement>('[data-path-track]');const traceButtons=[...root.querySelectorAll<HTMLButtonElement>('[data-trace]')];
    const defaultMap=mapInput.value.trim(),cellKey=(point:Point)=>`${point.x},${point.y}`,same=(a:Point,b:Point)=>a.x===b.x&&a.y===b.y,parseRows=(source:string)=>source.trim().split(/\r?\n/).map(row=>row.trim()).filter(Boolean);let worker:Worker,timeout=0,timer=0,requestId=0,current=0,mode:'recognition'|'planning'='recognition';let traces:Record<'recognition'|'planning',Trace|undefined>={recognition:undefined,planning:undefined};
    const clone=(state:ReplayState):ReplayState=>({...state,actor:{...state.actor},walls:new Set(state.walls),exits:new Set(state.exits),boxes:state.boxes.map(item=>({...item})),bombs:state.bombs.map(item=>({...item})),event:{...state.event,point:state.event.point?{...state.event.point}:undefined,cleared:state.event.cleared?[...state.event.cleared]:undefined}});
    const validate=(rows:string[])=>{if(rows.length<3||rows.length>12)return'地图高度必须在 3–12 行之间。';const width=rows[0]?.length??0;if(width<3||width>16||rows.some(row=>row.length!==width))return'每行必须等宽，宽度在 3–16 格之间。';if(rows.some(row=>/[^#\-@$.+*]/.test(row)))return'地图包含不支持的字符。';const source=rows.join('');if((source.match(/[@+]/g)??[]).length!==1)return'地图必须恰好有一个小车 @（或站在出口上的 +）。';if((source.match(/\$/g)??[]).length>6||(source.match(/\*/g)??[]).length>6||(source.match(/\./g)??[]).length>6)return'箱子、炸弹和出口各不能超过 6 个。';return''};
    const parseState=(rows:string[]):ReplayState=>{const walls=new Set<string>(),exits=new Set<string>(),boxes:Point[]=[],bombs:Point[]=[];let actor={x:0,y:0};rows.forEach((row,y)=>[...row].forEach((cell,x)=>{const point={x,y};if(cell==='#')walls.add(cellKey(point));if(cell==='.'||cell==='+')exits.add(cellKey(point));if(cell==='$')boxes.push(point);if(cell==='*')bombs.push(point);if(cell==='@'||cell==='+')actor=point}));return{width:rows[0]?.length??1,height:rows.length,actor,walls,exits,boxes,bombs,event:{type:'input',label:'INPUT'},move:''}};
    const deltas:Record<string,Point>={U:{x:0,y:-1},D:{x:0,y:1},L:{x:-1,y:0},R:{x:1,y:0}};
    const applyMove=(source:ReplayState,move:string,step:number):ReplayState=>{const state=clone(source),delta=deltas[move.toUpperCase()];if(!delta){state.event={type:'error',label:`STEP ${step}: INVALID ${move}`};return state}const target={x:state.actor.x+delta.x,y:state.actor.y+delta.y},targetKey=cellKey(target);const fail=(reason:string)=>{state.event={type:'error',label:`STEP ${step}: ${reason}`,point:target};return state};if(target.x<0||target.x>=state.width||target.y<0||target.y>=state.height)return fail('OUT OF BOUNDS');if(state.walls.has(targetKey))return fail('WALK INTO WALL');if(move===move.toLowerCase()){const boxIndex=state.boxes.findIndex(item=>same(item,target)),bombIndex=state.bombs.findIndex(item=>same(item,target));if(boxIndex<0&&bombIndex<0)return fail('PUSH WITH NOTHING');const destination={x:target.x+delta.x,y:target.y+delta.y},destinationKey=cellKey(destination);if(destination.x<0||destination.x>=state.width||destination.y<0||destination.y>=state.height)return fail('PUSH OUT OF BOUNDS');if(boxIndex>=0){if(state.walls.has(destinationKey)||state.boxes.some((item,index)=>index!==boxIndex&&same(item,destination))||state.bombs.some(item=>same(item,destination)))return fail('BOX PUSH BLOCKED');state.boxes[boxIndex]=destination;state.actor=target;state.move=move;state.event={type:'push-box',label:state.exits.has(destinationKey)?'BOX → EXIT':'PUSH BOX',point:destination};return state}if(state.walls.has(destinationKey)){state.bombs.splice(bombIndex,1);const cleared:string[]=[];for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const clearedKey=cellKey({x:destination.x+dx,y:destination.y+dy});if(state.walls.delete(clearedKey))cleared.push(clearedKey)}state.actor=target;state.move=move;state.event={type:'explode',label:`BOMB / ${cleared.length} WALLS CLEARED`,point:destination,cleared};return state}if(state.boxes.some(item=>same(item,destination))||state.bombs.some((item,index)=>index!==bombIndex&&same(item,destination)))return fail('BOMB PUSH BLOCKED');state.bombs[bombIndex]=destination;state.actor=target;state.move=move;state.event={type:'push-bomb',label:'PUSH BOMB',point:destination};return state}if(state.boxes.some(item=>same(item,target))||state.bombs.some(item=>same(item,target)))return fail('WALK INTO ENTITY');state.actor=target;state.move=move;state.event={type:'walk',label:'WALK',point:target};return state};
    const buildTrace=(rows:string[],path:string,label:string):Trace=>{const states=[parseState(rows)];let error='';for(let index=0;index<path.length;index++){const next=applyMove(states.at(-1)!,path[index]!,index+1);states.push(next);if(next.event.type==='error'){error=next.event.label;break}}return{label,path,states,error:error||undefined}};const selected=()=>traces[mode];const setStatus=(text:string,state:'loading'|'ready'|'running'|'error')=>{status.textContent=text;status.dataset.state=state};const stopPlayback=()=>{window.clearInterval(timer);timer=0;play.textContent='回放当前路径'};const setBusy=(busy:boolean)=>{root.querySelectorAll<HTMLButtonElement>('[data-action="recognize"],[data-action="solve"]').forEach(button=>button.disabled=busy);stopButton.disabled=!busy};
    const renderPath=()=>{const trace=selected();pathTrack.replaceChildren();if(!trace?.path){const p=document.createElement('p');p.textContent='当前阶段没有可回放路径。';pathTrack.append(p);return}for(let index=0;index<trace.path.length;index++){const token=document.createElement('button');token.type='button';token.textContent=trace.path[index]!;token.className=trace.path[index]===trace.path[index]!.toLowerCase()?'push':'';token.title=`第 ${index+1} 步`;token.addEventListener('click',()=>{stopPlayback();current=index+1;render()});pathTrack.append(token)}};
    const render=()=>{const trace=selected();if(!trace){board.innerHTML='';return}const state=trace.states[Math.min(current,trace.states.length-1)]!,trail=new Set(trace.states.slice(0,current).map(item=>cellKey(item.actor)));board.innerHTML='';board.style.gridTemplateColumns=`repeat(${state.width},1fr)`;for(let y=0;y<state.height;y++)for(let x=0;x<state.width;x++){const point={x,y},pointKey=cellKey(point),cell=document.createElement('span');cell.className='solver-cell';if(state.walls.has(pointKey)){cell.classList.add('wall');cell.textContent='#'}if(state.exits.has(pointKey)){cell.classList.add('exit');cell.textContent='.'}if(state.boxes.some(item=>same(item,point))){cell.classList.add('box');if(state.exits.has(pointKey))cell.classList.add('completed');cell.textContent='$'}if(state.bombs.some(item=>same(item,point))){cell.classList.add('bomb');cell.textContent='*'}if(trail.has(pointKey))cell.classList.add('trail');if(same(state.actor,point))cell.classList.add('actor');if(state.event.point&&same(state.event.point,point)){if(state.event.type==='explode')cell.classList.add('explosion');if(state.event.type==='push-box'||state.event.type==='push-bomb')cell.classList.add('pushed')}if(state.event.cleared?.includes(pointKey))cell.classList.add('cleared');board.append(cell)}range.value=String(current);range.max=String(trace.states.length-1);stepOut.textContent=`${String(current).padStart(2,'0')} / ${trace.path.length}`;positionOut.textContent=`(${state.actor.x}, ${state.actor.y})`;let turns=0;for(let i=1;i<current;i++)if(trace.path[i]?.toUpperCase()!==trace.path[i-1]?.toUpperCase())turns++;turnOut.textContent=String(turns);phaseOut.textContent=`${mode==='recognition'?'RECOGNITION':'PLANNING'} ${current===trace.path.length?'COMPLETE':'TRACE'}`;eventOut.textContent=state.event.label;traceSummary.textContent=`${trace.label} · ${trace.path.length} 步 · ${trace.states.filter(item=>item.event.type==='push-box').length} 次推箱 · ${trace.states.filter(item=>item.event.type==='explode').length} 次引爆`;[...pathTrack.querySelectorAll('button')].forEach((token,index)=>{token.classList.toggle('past',index<current);token.classList.toggle('active',index===current-1)});pathTrack.querySelector('.active')?.scrollIntoView({block:'nearest',inline:'center'});if(state.event.type==='error'){stopPlayback();message.textContent=`展示器拒绝继续：${state.event.label}`;message.classList.add('error');setStatus('TRACE INVALID','error')}};
    const selectTrace=(next:'recognition'|'planning',step=0)=>{if(!traces[next])return;stopPlayback();mode=next;current=Math.min(step,traces[next]!.states.length-1);traceButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.trace===next)));renderPath();render()};const tick=()=>{const trace=selected();if(!trace||current>=trace.states.length-1){stopPlayback();return}current++;render()};
    const createWorker=()=>{worker=new Worker('/solver/solver-worker.js',{type:'module'});worker.addEventListener('message',(event)=>{if(event.data?.type==='ready'){setStatus('WASM READY','ready');message.textContent='内核已就绪。完整规划返回后可观察真实推箱与爆破。';return}if(event.data?.type==='boot-error'){setStatus('WASM ERROR','error');message.textContent=event.data.message;message.classList.add('error');return}if(event.data?.id!==requestId)return;window.clearTimeout(timeout);setBusy(false);if(event.data.type==='error'){setStatus('WASM ERROR','error');message.textContent=event.data.message;message.classList.add('error');return}const result=event.data,inputRows=parseRows(mapInput.value);traces.recognition=buildTrace(inputRows,result.recognition.path,'识别路径');traces.planning=result.planning.path?buildTrace(result.endMap,result.planning.path,'完整规划'):undefined;recPathOut.textContent=result.recognition.path||'无识别路径';planPathOut.textContent=result.planning.path||'未运行完整规划';recMetric.textContent=result.recognition.solved?`${result.recognition.length} 步 / ${result.recognition.turns} 转向`:`失败 / reason ${result.failReason}`;planMetric.textContent=result.planning.solved?`${result.planning.length} 步 / ${result.planning.turns} 转向`:result.status===1?'未运行或未解出':`失败 / reason ${result.failReason}`;timeMetric.textContent=`${result.engineMs.toFixed(1)} ms`;entityMetric.textContent=`BOX ${result.entities.boxes[0]}/${result.entities.boxes[1]} · BOMB ${result.entities.bombs[0]}/${result.entities.bombs[1]}`;play.disabled=!result.recognition.path;stepButton.disabled=!result.recognition.path;endMapButton.disabled=!traces.recognition;finalMapButton.disabled=!traces.planning;const planningButton=traceButtons.find(button=>button.dataset.trace==='planning');if(planningButton)planningButton.disabled=!traces.planning;const replayError=traces.recognition.error||traces.planning?.error;if(replayError){setStatus('TRACE CHECK FAILED','error');message.textContent=`C 内核返回路径，但浏览器规则回放在 ${replayError} 中止。`;message.classList.add('error')}else{setStatus(result.planning.solved?'FULL PLAN READY':'RECOGNITION READY','ready');message.textContent=result.planning.solved?'C 内核已完成规划；当前自动切到完整规划轨迹。':'C 内核已生成识别路径；可逐步检查。';message.classList.remove('error')}selectTrace(traces.planning?'planning':'recognition')});setStatus('LOADING WASM','loading');message.textContent='正在加载由真实 C99 源文件编译的 Wasm 内核…'};
    const run=(planning:boolean)=>{const rows=parseRows(mapInput.value),problem=validate(rows);if(problem){message.textContent=problem;message.classList.add('error');setStatus('INVALID MAP','error');return}stopPlayback();traces={recognition:buildTrace(rows,'','输入地图'),planning:undefined};selectTrace('recognition');requestId++;setBusy(true);setStatus(planning?'FULL CORE RUNNING':'RECOGNITION RUNNING','running');message.classList.remove('error');message.textContent=planning?'正在 Worker 中执行识别、配对、炸障、推箱、返航和最终验证…':'正在 Worker 中计算识别路径…';worker.postMessage({type:'solve',id:requestId,map:rows.join('\n'),planning});timeout=window.setTimeout(()=>{worker.terminate();setBusy(false);setStatus('TIMEOUT / STOPPED','error');message.textContent='求解超过 60 秒，Worker 已被终止。';message.classList.add('error');createWorker()},60000)};
    q('[data-action="recognize"]').addEventListener('click',()=>run(false));q('[data-action="solve"]').addEventListener('click',()=>run(true));stopButton.addEventListener('click',()=>{worker.terminate();window.clearTimeout(timeout);setBusy(false);setStatus('STOPPED','error');message.textContent='求解已由用户中断，没有部分结果被冒充为完整解。';createWorker()});traceButtons.forEach(button=>button.addEventListener('click',()=>selectTrace(button.dataset.trace as 'recognition'|'planning')));play.addEventListener('click',()=>{if(timer){stopPlayback();return}const trace=selected();if(!trace)return;if(current>=trace.states.length-1)current=0;play.textContent='暂停';timer=window.setInterval(tick,Number(speed.value))});stepButton.addEventListener('click',()=>{stopPlayback();tick()});range.addEventListener('input',()=>{stopPlayback();current=Number(range.value);render()});speed.addEventListener('change',()=>{if(timer){stopPlayback();play.click()}});q('[data-action="start-map"]').addEventListener('click',()=>selectTrace('recognition',0));endMapButton.addEventListener('click',()=>selectTrace('recognition',traces.recognition?.states.length??1));finalMapButton.addEventListener('click',()=>selectTrace('planning',traces.planning?.states.length??1));q('[data-action="reset"]').addEventListener('click',()=>{stopPlayback();mapInput.value=defaultMap;traces={recognition:buildTrace(parseRows(defaultMap),'','输入地图'),planning:undefined};recPathOut.textContent='等待求解';planPathOut.textContent='完整规划模式才会产生';play.disabled=true;stepButton.disabled=true;endMapButton.disabled=true;finalMapButton.disabled=true;traceButtons.find(button=>button.dataset.trace==='planning')!.disabled=true;selectTrace('recognition')});mapInput.addEventListener('input',()=>{const rows=parseRows(mapInput.value);if(!validate(rows)){traces={recognition:buildTrace(rows,'','输入地图'),planning:undefined};selectTrace('recognition')}});traces.recognition=buildTrace(parseRows(defaultMap),'','输入地图');selectTrace('recognition');createWorker();
  }
</script>
