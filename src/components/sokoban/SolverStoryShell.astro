---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { title:string; deck:string; image:ImageMetadata; }
const { title, deck, image } = Astro.props;
---
<main class="solver-story" data-pagefind-body>
  <nav><a href="/columns/tools/">TOOLS · 工具</a><div><a href="#live-solver">求解器</a><a href="#architecture">架构</a><a href="#review">审查</a></div><a href="/">返回小站 ↗</a></nav>
  <header><div><p>C99 / BOUNDED SEARCH / ROBOT PLANNING</p><h1>{title}</h1><p>{deck}</p><dl><div><dt>地图上限</dt><dd>16 × 12</dd></div><div><dt>对象上限</dt><dd>6 / 6 / 6</dd></div><div><dt>目标函数</dt><dd>完成 → 转向 → 步数</dd></div></dl></div><figure><Image src={image} alt="推箱炸障求解器内置地图与真实识别路径" widths={[640,960,1600]} sizes="(max-width:800px) 100vw, 50vw" loading="eager" /></figure></header>
  <article><slot /></article>
  <footer><a href="https://github.com/o-1717986918/sokoban-recognition-bomb-solver" rel="noreferrer">SOURCE / GITHUB ↗</a><span>VERIFIED WITH REPOSITORY GCC TOOLCHAIN</span></footer>
</main>
<style>
  :global(html){background:#e4dec9;scroll-behavior:smooth}:global(body){margin:0;background:#e4dec9;color:#152028;font-family:Inter,'Segoe UI','PingFang SC',sans-serif}:global(*){box-sizing:border-box}.solver-story{--ink:#152028;--green:#436552;--red:#b94f49;--gold:#a36f2c;--line:rgba(21,32,40,.24);min-height:100vh;background:linear-gradient(rgba(21,32,40,.035) 1px,transparent 1px),#e4dec9;background-size:100% 40px}.solver-story>nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:4rem;padding:0 clamp(1rem,4vw,4rem);border-bottom:1px solid var(--line);font:.63rem/1 ui-monospace,monospace;letter-spacing:.1em}.solver-story nav a{color:inherit;text-decoration:none}.solver-story nav div{display:flex;gap:1.4rem}.solver-story nav>a:last-child{justify-self:end}.solver-story>header{display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 4rem);border-bottom:1px solid var(--line)}.solver-story>header>div{display:flex;flex-direction:column;justify-content:center;padding:clamp(4rem,8vw,8rem) clamp(1.2rem,5vw,6rem);border-right:1px solid var(--line)}.solver-story>header>div>p:first-child{color:var(--green);font:.65rem/1.5 ui-monospace,monospace;letter-spacing:.11em}.solver-story h1{margin:1.3rem 0;font-size:clamp(3.5rem,7vw,8rem);line-height:.92;letter-spacing:-.075em}.solver-story>header>div>p:nth-of-type(2){max-width:33rem;color:#536067;font-size:1rem;line-height:1.9}.solver-story header dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:auto 0 0;padding-top:2rem;border-top:1px solid var(--line)}.solver-story dt{color:#68747a;font:.55rem/1 ui-monospace,monospace}.solver-story dd{margin:.45rem 0 0;color:var(--red);font:.72rem/1.3 ui-monospace,monospace}.solver-story header figure{display:grid;min-width:0;margin:0;background:#0c1216}.solver-story header figure :global(img){align-self:center;width:100%;height:auto;object-fit:contain}.solver-story>article{max-width:74rem;margin:auto;padding:clamp(4rem,9vw,9rem) clamp(1.2rem,5vw,5rem)}.solver-story article :global(h2){margin:5rem 0 1rem;padding-top:1rem;border-top:1px solid var(--line);font-size:clamp(2rem,4vw,4.4rem);line-height:1.08;letter-spacing:-.055em}.solver-story article :global(h2:first-child){margin-top:0}.solver-story article :global(h3){margin:3rem 0 .8rem;color:var(--green);font-size:1.35rem}.solver-story article :global(p),.solver-story article :global(li){max-width:47rem;color:#34434b;font-size:1rem;line-height:2}.solver-story article :global(table){width:100%;margin:2rem 0;border-collapse:collapse;font-size:.82rem}.solver-story article :global(th),.solver-story article :global(td){padding:.8rem;border:1px solid var(--line);text-align:left;vertical-align:top}.solver-story article :global(blockquote){margin:2rem 0;padding:1rem 1.4rem;border-left:.3rem solid var(--red);background:rgba(185,79,73,.07)}.solver-story article :global(blockquote p){margin:0;color:#613633}.solver-story article :global(code){padding:.12em .3em;background:rgba(67,101,82,.1);font-family:ui-monospace,monospace}.solver-story>footer{display:flex;justify-content:space-between;gap:2rem;padding:2rem clamp(1.2rem,5vw,5rem);border-top:1px solid var(--line);font:.6rem/1.4 ui-monospace,monospace;letter-spacing:.09em}.solver-story footer a{color:var(--red);text-decoration:none}.solver-story footer span{color:#66747b}@media(max-width:800px){.solver-story>nav{grid-template-columns:1fr auto}.solver-story nav div{display:none}.solver-story>header{grid-template-columns:1fr}.solver-story>header>div{min-height:80vh;border-right:0}.solver-story header figure{min-height:56vw}}@media(max-width:560px){.solver-story h1{font-size:clamp(3.2rem,16vw,5.2rem)}.solver-story header dl{grid-template-columns:1fr}.solver-story>footer{display:grid}}
</style>

<style>
  .solver-story article :global(a) { color: #8b3f3a; text-decoration-color: rgba(139, 63, 58, .4); text-underline-offset: .18em; }
  .solver-story article :global(pre) { max-width: 100%; margin: 2rem 0; padding: 1.15rem 1.25rem; overflow: auto; border: 1px solid #314047; border-top: 3px solid #799a7f; background: #10181b; color: #dce7df; box-shadow: .55rem .55rem 0 rgba(67, 101, 82, .12); }
  .solver-story article :global(pre code) { padding: 0; background: transparent; color: inherit; font-size: .78rem; line-height: 1.75; }
</style>
