---
import SearchIndex from './SearchIndex.astro';
---

<dialog class="search-overlay" data-search-dialog data-pagefind-ignore>
  <div class="search-surface">
    <header class="search-overlay__head">
      <div><span>DISCOVER</span><h2>搜索这座小站</h2></div>
      <form method="dialog"><button type="submit" aria-label="关闭搜索">关闭 <kbd>ESC</kbd></button></form>
    </header>
    <SearchIndex />
    <footer><span>全文索引留在浏览器本地</span><span><kbd>↑</kbd><kbd>↓</kbd> 浏览 · <kbd>↵</kbd> 打开</span></footer>
  </div>
</dialog>

<style>
  .search-overlay { width: min(48rem, calc(100% - 2rem)); max-height: min(48rem, calc(100dvh - 2rem)); padding: 0; border: 0; border-radius: 1.15rem; overflow: visible; color: rgb(var(--text-rgb)); background: transparent; }
  .search-overlay::backdrop { background: rgba(5, 12, 18, .6); backdrop-filter: blur(14px) saturate(.8); }
  .search-surface { position: relative; max-height: min(48rem, calc(100dvh - 2rem)); padding: 1.25rem; overflow: auto; border: 1px solid rgba(var(--text-rgb), .2); border-radius: 1.15rem; background: linear-gradient(145deg, rgba(var(--raised-rgb), .94), rgba(var(--surface-rgb), .98)); box-shadow: 0 2.5rem 7rem rgba(0, 0, 0, .42), inset 0 1px rgba(255, 255, 255, .12); }
  .search-surface::before { content: ''; position: absolute; inset: -.55rem 2.5rem auto; z-index: -1; height: 2.5rem; border-radius: 50%; background: linear-gradient(90deg, rgba(var(--spectrum-aqua-rgb), .5), rgba(var(--spectrum-violet-rgb), .55), rgba(var(--spectrum-coral-rgb), .45)); filter: blur(1.1rem); }
  .search-overlay__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; padding-bottom: .9rem; border-bottom: 1px solid var(--line); }
  .search-overlay__head span { color: rgb(var(--spectrum-aqua-rgb)); font-family: var(--font-mono); font-size: .55rem; letter-spacing: .12em; }
  .search-overlay__head h2 { margin-top: .15rem; font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -.035em; }
  .search-overlay__head button { padding: .45rem .6rem; border: 1px solid var(--line); border-radius: .4rem; color: rgba(var(--text-rgb), .62); background: rgba(var(--bg-rgb), .18); font-size: .65rem; cursor: pointer; }
  kbd { padding: .08rem .3rem; border: 1px solid var(--line-strong); border-radius: .22rem; font-family: var(--font-mono); font-size: .55rem; }
  footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--line); color: rgba(var(--text-rgb), .42); font-family: var(--font-mono); font-size: .53rem; }
  footer kbd + kbd { margin-left: .2rem; }
  @media (max-width: 620px) { .search-overlay { width: calc(100% - 1rem); max-height: calc(100dvh - 1rem); } .search-surface { max-height: calc(100dvh - 1rem); padding: 1rem; } footer span:last-child { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-search-dialog]').forEach((dialog) => {
    let returnTarget: HTMLElement | null = null;
    const open = () => {
      if (dialog.open) return;
      returnTarget = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      dialog.showModal();
      requestAnimationFrame(() => dialog.querySelector<HTMLInputElement>('[data-search-input]')?.focus());
    };
    const close = () => { if (dialog.open) dialog.close(); };
    document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach((trigger) => trigger.addEventListener('click', open));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dialog.open) { event.preventDefault(); close(); return; }
      const editable = event.target instanceof HTMLElement && Boolean(event.target.closest('input, textarea, select, [contenteditable="true"]'));
      if ((event.key === '/' && !editable) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
        event.preventDefault();
        dialog.open ? close() : open();
      }
    });
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); close(); });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    dialog.addEventListener('close', () => returnTarget?.focus());
    if (new URLSearchParams(location.search).has('search')) open();
  });
</script>
