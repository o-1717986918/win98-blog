---
import type { ColumnEntry, PostEntry } from '../lib/content';
import { formatDate } from '../lib/content';
import { withBase } from '../lib/site-path';
import { accentStyle, postAccent } from '../lib/visual';

interface Props {
  posts: PostEntry[];
  columns: ColumnEntry[];
}

const { posts, columns } = Astro.props;
const columnMap = new Map(columns.map((column) => [column.id, column]));
---

<ol class="home-post-stream" data-home-post-stream data-initial-limit="6">
  {posts.map((post, index) => {
    const column = post.data.columns[0] ? columnMap.get(post.data.columns[0].id) : undefined;
    const dateKey = post.data.date.toISOString().slice(0, 10);
    return (
      <li style={accentStyle(postAccent(post, columnMap))} data-stream-item data-post-date={dateKey}>
        <span class="home-post-stream__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <i class="home-post-stream__node" aria-hidden="true"></i>
        <a href={withBase(`/posts/${post.id}/`)}>
          <div class="home-post-stream__meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {column && <span>{column.data.title}</span>}
            <small>{post.data.minutes ?? '—'} MIN</small>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="home-post-stream__tags">
            {post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      </li>
    );
  })}
</ol>
<div class="home-post-stream__controls" data-stream-controls hidden>
  <p data-stream-status></p>
  <div>
    <button type="button" data-stream-reset hidden>清除日期筛选</button>
    <button type="button" data-stream-more>加载更多</button>
  </div>
</div>

<style>
  .home-post-stream { position: relative; display: grid; gap: 0; padding: 0; list-style: none; }
  .home-post-stream::before { content: ''; position: absolute; top: .8rem; bottom: .8rem; left: 2.95rem; width: 1px; background: linear-gradient(rgb(var(--spectrum-violet-rgb)), rgba(var(--spectrum-violet-rgb), .12)); }
  li { position: relative; display: grid; grid-template-columns: 2.15rem 1.05rem minmax(0, 1fr); gap: .3rem .55rem; min-width: 0; }
  li[hidden] { display: none; }
  .home-post-stream__index { align-self: start; padding-top: 1.14rem; color: rgba(var(--text-rgb), .42); font: .52rem/1 var(--font-mono); letter-spacing: .08em; text-align: right; }
  .home-post-stream__node { position: relative; z-index: 1; align-self: start; width: .48rem; aspect-ratio: 1; margin: 1.02rem auto 0; border: 1px solid rgb(var(--content-accent-rgb)); background: rgb(var(--surface-rgb)); box-shadow: 0 0 0 .22rem rgba(var(--content-accent-rgb), .09); transform: rotate(45deg); transition: background .2s var(--ease), transform .2s var(--ease); }
  a { position: relative; display: block; min-width: 0; padding: .88rem 2.2rem 1.05rem 1rem; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background .2s var(--ease), transform .2s var(--ease); }
  a::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 2px; background: rgb(var(--content-accent-rgb)); opacity: 0; transform: scaleY(.35); transition: opacity .2s var(--ease), transform .25s var(--ease); }
  a:is(:hover, :focus-visible) { background: linear-gradient(90deg, rgba(var(--content-accent-rgb), .11), transparent 76%); transform: translateX(.18rem); }
  a:is(:hover, :focus-visible)::before { opacity: 1; transform: scaleY(1); }
  li:has(a:is(:hover, :focus-visible)) .home-post-stream__node { background: rgb(var(--content-accent-rgb)); transform: rotate(45deg) scale(1.12); }
  .home-post-stream__meta { display: flex; flex-wrap: wrap; gap: .3rem .8rem; align-items: center; color: rgba(var(--text-rgb), .48); font: .53rem/1.35 var(--font-mono); letter-spacing: .04em; }
  .home-post-stream__meta time { color: rgb(var(--content-accent-rgb)); }
  .home-post-stream__meta span { color: rgb(var(--content-secondary-rgb)); }
  .home-post-stream__meta small { margin-left: auto; font: inherit; }
  h3 { max-width: 24ch; margin-top: .48rem; font: 620 clamp(1.2rem, 1.7vw, 1.55rem)/1.25 var(--font-display); letter-spacing: -.035em; text-wrap: balance; }
  p { display: -webkit-box; max-width: 46rem; margin-top: .44rem; overflow: hidden; color: rgba(var(--text-rgb), .63); font-size: .72rem; line-height: 1.7; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .home-post-stream__tags { display: flex; flex-wrap: wrap; gap: .3rem .7rem; margin-top: .55rem; color: rgba(var(--text-rgb), .46); font: .53rem/1.35 var(--font-mono); }
  a > b { position: absolute; top: 50%; right: .72rem; color: rgb(var(--content-accent-rgb)); font-weight: 500; opacity: .45; transform: translateY(-50%); transition: opacity .2s var(--ease), transform .2s var(--ease); }
  a:is(:hover, :focus-visible) > b { opacity: 1; transform: translate(.12rem, calc(-50% - .12rem)); }
  .home-post-stream__controls { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-left: 3.55rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .home-post-stream__controls[hidden] { display: none; }
  .home-post-stream__controls p { margin: 0; color: rgba(var(--text-rgb), .48); font: .54rem/1.5 var(--font-mono); }
  .home-post-stream__controls > div { display: flex; gap: .45rem; }
  .home-post-stream__controls button { padding: .42rem .58rem; border: 1px solid var(--line); color: rgba(var(--text-rgb), .7); background: rgba(var(--surface-rgb), .72); font-size: .61rem; cursor: pointer; }
  .home-post-stream__controls button:hover { border-color: rgba(var(--spectrum-aqua-rgb), .55); color: rgb(var(--spectrum-aqua-rgb)); }
  .home-post-stream__controls [data-stream-reset] { border-color: rgba(var(--spectrum-coral-rgb), .35); color: rgb(var(--spectrum-coral-rgb)); }
  :global(html[data-portal-density='compact']) .home-post-stream p,
  :global(html[data-portal-density='compact']) .home-post-stream__tags { display: none; }
  :global(html[data-portal-density='compact']) .home-post-stream a { padding-block: .68rem; }
  @media (max-width: 520px) {
    .home-post-stream::before { left: .27rem; }
    li { grid-template-columns: .55rem minmax(0, 1fr); column-gap: .55rem; }
    .home-post-stream__index { display: none; }
    .home-post-stream__node { grid-column: 1; width: .42rem; }
    a { grid-column: 2; padding-left: .55rem; }
    .home-post-stream__meta small { display: none; }
    .home-post-stream__controls { align-items: start; margin-left: 1.1rem; }
    .home-post-stream__controls > div { flex-direction: column-reverse; }
  }
  @media (prefers-reduced-motion: reduce) {
    a, a::before, a > b, .home-post-stream__node { transition: none; }
  }
</style>
