---
import { getCollection } from 'astro:content';
import ContentCover from './ContentCover.astro';
import { formatDate, isPublished, type PostEntry } from '../lib/content';
import { accentStyle, postAccent } from '../lib/visual';
import { withBase } from '../lib/site-path';

interface Props {
  posts: PostEntry[];
  showDescription?: boolean;
  compact?: boolean;
}
const { posts, showDescription = true, compact = false } = Astro.props;
const columns = (await getCollection('columns')).filter(isPublished);
const columnMap = new Map(columns.map((column) => [column.id, column]));
---

<div class:list={['post-list', { 'post-list--compact': compact }]}>
  {posts.length === 0 ? <p class="empty-state">这个主题还没有文章。</p> : posts.map((post) => (
    <a class="post-row" href={withBase(`/posts/${post.id}/`)} style={accentStyle(postAccent(post, columnMap))} data-post-row data-tags={post.data.tags.map((tag) => tag.toLowerCase()).join('|')} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.columns.map((reference) => columnMap.get(reference.id)?.data.title ?? '').join(' ')}`.toLowerCase()}>
      <ContentCover className="post-cover" title={post.data.title} seed={post.id} kind="post" accent={postAccent(post, columnMap)} cover={post.data.cover} variant="list" />
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div class="post-copy">
        <h3 aria-label={post.data.title}><span class="post-title__full">{post.data.title}</span>{post.data.shortTitle && <span class="post-title__short" aria-hidden="true">{post.data.shortTitle}</span>}</h3>
        {showDescription && <p>{post.data.description}</p>}
        <div class="post-taxonomy">
          {post.data.columns.map((reference) => {
            const column = columnMap.get(reference.id);
            return column && <span>{column.data.title}</span>;
          })}
          {post.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </div>
      <span class="post-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .post-list { display: grid; gap: .72rem; }
  .post-row { position: relative; isolation: isolate; display: grid; grid-template-columns: 11rem 6.3rem minmax(0, 1fr) 1.5rem; gap: 1.15rem; align-items: center; min-height: 9rem; padding: .72rem .95rem .72rem .72rem; overflow: hidden; border: 1px solid rgba(var(--content-accent-rgb), .24); border-radius: .3rem; color: inherit; background: linear-gradient(112deg, rgba(var(--content-accent-rgb), .13), rgba(var(--surface-rgb), .86) 31%, rgba(var(--content-secondary-rgb), .07)); box-shadow: 0 .55rem 1.5rem rgba(0, 0, 0, .055), inset 0 1px rgba(255, 255, 255, .09); text-decoration: none; transition: transform .22s var(--ease), border-color .22s var(--ease), background .22s var(--ease), box-shadow .22s var(--ease); cursor: pointer; }
  .post-row::before { content: ''; position: absolute; inset: 0 auto 0 0; width: .24rem; background: rgb(var(--content-accent-rgb)); transform: scaleY(.34); transform-origin: bottom; transition: transform .3s var(--ease); }
  .post-row::after { content: ''; position: absolute; right: .66rem; bottom: .62rem; width: 1.8rem; height: 2px; background: linear-gradient(90deg, rgb(var(--content-accent-rgb)) 0 58%, rgb(var(--content-secondary-rgb)) 58%); opacity: .72; }
  .post-row:hover::before, .post-row:focus-visible::before { transform: scaleY(1); }
  .post-row:hover, .post-row:focus-visible { z-index: 1; border-color: rgba(var(--content-accent-rgb), .58); background: linear-gradient(112deg, rgba(var(--content-accent-rgb), .2), rgba(var(--surface-rgb), .94) 35%, rgba(var(--content-secondary-rgb), .11)); box-shadow: .38rem .45rem 0 rgba(var(--content-secondary-rgb), .1), 0 1rem 2.2rem rgba(0, 0, 0, .1); transform: translateX(.24rem); }
  .post-row:focus-visible { outline: 2px solid rgb(var(--content-accent-rgb)); outline-offset: 3px; }
  :global(.post-cover) { align-self: center; width: 11rem; height: auto; aspect-ratio: 16 / 9; }
  time { align-self: start; padding-top: .28rem; color: rgb(var(--content-accent-rgb)); font-family: var(--font-mono); font-size: .66rem; }
  h3 { font-family: var(--font-display); font-size: clamp(1.18rem, 2.2vw, 1.55rem); font-weight: 610; line-height: 1.35; letter-spacing: -.032em; }
  .post-title__short { display: none; }
  .post-row:hover h3, .post-row:focus-visible h3 { color: rgb(var(--content-accent-rgb)); }
  p { max-width: 48rem; margin-top: .45rem; color: rgba(var(--text-rgb), .68); font-size: .84rem; line-height: 1.75; }
  .post-taxonomy { display: flex; flex-wrap: wrap; gap: .4rem .75rem; margin-top: .72rem; color: rgba(var(--text-rgb), .67); font-family: var(--font-mono); font-size: .63rem; }
  .post-arrow { align-self: center; color: rgb(var(--content-accent-rgb)); opacity: .58; transition: opacity .2s var(--ease), transform .2s var(--ease); }
  .post-row:hover .post-arrow, .post-row:focus-within .post-arrow { opacity: 1; transform: translate(.15rem, -.15rem); }
  .post-list--compact { gap: .58rem; }
  .post-list--compact .post-row { grid-template-columns: 8.5rem minmax(0, 1fr) auto; grid-template-rows: auto 1fr; gap: .38rem .8rem; min-height: 8.7rem; padding: .62rem .7rem .62rem .62rem; }
  .post-list--compact :global(.post-cover) { grid-column: 1; grid-row: 1 / 3; align-self: center; width: 8.5rem; height: auto; aspect-ratio: 16 / 9; }
  .post-list--compact time { grid-column: 2; grid-row: 1; align-self: end; padding: 0; font-size: .56rem; }
  .post-list--compact .post-copy { grid-column: 2; grid-row: 2; align-self: start; min-width: 0; }
  .post-list--compact h3 { display: -webkit-box; overflow: hidden; font-size: 1.08rem; line-height: 1.32; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .post-list--compact .post-copy > p, .post-list--compact .post-taxonomy { display: none; }
  .post-list--compact .post-arrow { grid-column: 3; grid-row: 1 / 3; }
  @media (max-width: 660px) {
    h3:has(.post-title__short) .post-title__full { display: none; }
    .post-title__short { display: inline; }
    .post-row { grid-template-columns: 5.4rem minmax(0, 1fr) auto; gap: .45rem .8rem; min-height: 6.65rem; padding: .58rem .65rem .58rem .58rem; }
    :global(.post-cover) { grid-row: 1 / 3; width: 5.4rem; min-height: 0; }
    time { grid-column: 2; grid-row: 1; }
    .post-copy { grid-column: 2 / 4; grid-row: 2; }
    .post-copy > p, .post-taxonomy { display: none; }
    h3 { font-size: 1.03rem; }
    .post-arrow { grid-column: 3; grid-row: 1; }
    .post-list--compact .post-row { grid-template-columns: 6.4rem minmax(0, 1fr) auto; }
    .post-list--compact :global(.post-cover) { width: 6.4rem; min-height: 0; }
  }
</style>
