<section class="mastery-planner" data-mastery-planner aria-labelledby="mastery-title">
  <div><p>INTERACTIVE / REVIEW ROUTER</p><h2 id="mastery-title">把一次错误路由到下一次学习动作</h2><span>这是依据仓库规则制作的教学演示，不会修改本地 Skill 数据。</span></div>
  <form>
    <label>错误类型<select name="type"><option value="concept">概念混淆</option><option value="calculation">计算失误</option><option value="formula">公式误用</option><option value="strategy">策略错误</option><option value="intuition">物理直觉缺失</option></select></label>
    <label>当前把握 <output data-confidence>2 / 5</output><input name="confidence" type="range" min="1" max="5" value="2" /></label>
    <label>连续正确<select name="streak"><option value="0">0 次</option><option value="1">1 次</option><option value="2">2 次</option><option value="3">3 次</option><option value="5">5 次</option></select></label>
  </form>
  <div class="mastery-result"><span>NEXT ACTION</span><strong data-action>diagnose → feynman</strong><p data-reason>先定位混淆概念，再用自己的话解释边界与反例。</p><dl><div><dt>复习间隔</dt><dd data-interval>1 天</dd></div><div><dt>掌握度建议</dt><dd data-level>🟥 初识</dd></div></dl></div>
</section>
<style>
  .mastery-planner{display:grid;grid-template-columns:1fr .85fr .9fr;gap:1px;margin:3rem 0;border:1px solid rgba(var(--content-accent-rgb),.35);background:rgba(var(--content-accent-rgb),.28)}.mastery-planner>div,.mastery-planner form{padding:1.25rem;background:rgb(var(--surface-rgb))}.mastery-planner p{margin:0!important;color:rgb(var(--content-accent-rgb))!important;font:.58rem/1.4 var(--font-mono)!important;letter-spacing:.1em}.mastery-planner h2{margin:.8rem 0!important;padding:0!important;border:0!important;font-size:clamp(1.5rem,3vw,2.3rem)!important}.mastery-planner>div>span{color:rgba(var(--text-rgb),.55);font-size:.72rem;line-height:1.7}.mastery-planner form{display:grid;gap:1rem}.mastery-planner label{display:grid;gap:.45rem;color:rgba(var(--text-rgb),.65);font:.62rem/1.3 var(--font-mono)}.mastery-planner select{width:100%;padding:.55rem;border:1px solid var(--line);background:rgb(var(--bg-rgb));color:rgb(var(--text-rgb))}.mastery-planner input{width:100%;accent-color:rgb(var(--content-accent-rgb))}.mastery-planner output{justify-self:end;color:rgb(var(--content-accent-rgb))}.mastery-result>span{color:rgba(var(--text-rgb),.48);font:.55rem/1 var(--font-mono);letter-spacing:.1em}.mastery-result strong{display:block;margin:1.6rem 0 .8rem;color:rgb(var(--content-accent-rgb));font:1rem/1.4 var(--font-mono)}.mastery-result p{min-height:4rem;color:rgba(var(--text-rgb),.7)!important;font:.75rem/1.8 sans-serif!important;letter-spacing:0}.mastery-result dl{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin:1rem 0 0}.mastery-result dt{color:rgba(var(--text-rgb),.48);font:.54rem/1 var(--font-mono)}.mastery-result dd{margin:.4rem 0 0;font:.7rem/1.3 var(--font-mono)}@media(max-width:780px){.mastery-planner{grid-template-columns:1fr}}
</style>
<script>
  const root=document.querySelector<HTMLElement>('[data-mastery-planner]');
  if(root){
    const type=root.querySelector<HTMLSelectElement>('[name="type"]')!;
    const confidence=root.querySelector<HTMLInputElement>('[name="confidence"]')!;
    const streak=root.querySelector<HTMLSelectElement>('[name="streak"]')!;
    const routes:Record<string,readonly [string,string]>={
      concept:['diagnose → feynman','先定位混淆概念，再用自己的话解释边界与反例。'],
      calculation:['train → solve','用同类短题隔离计算步骤，并在完整解题中复查。'],
      formula:['solve → feynman','写出适用条件与反例，再回到原题选择公式。'],
      strategy:['diagnose → train','比较两条可行路径，训练识别题型线索与停止条件。'],
      intuition:['visualize → feynman','先建立图像或极限情形，再用自然语言解释方向与量级。'],
    };
    const setText=(selector:string,value:string)=>{const node=root.querySelector<HTMLElement>(selector);if(node)node.textContent=value};
    const render=()=>{
      setText('[data-confidence]',`${confidence.value} / 5`);
      const [action,reason]=routes[type.value] ?? routes.concept!;
      setText('[data-action]',action);
      setText('[data-reason]',reason);
      const score=Math.min(5,Math.max(1,Number(confidence.value)+(Number(streak.value)>=3?1:0)));
      setText('[data-interval]',['','1 天','2 天','4 天','7 天','14 天'][score] ?? '1 天');
      setText('[data-level]',['','🟥 初识','🟧 理解','🟨 应用','🟩 熟练','🟦 精通'][score] ?? '🟥 初识');
    };
    root.querySelectorAll('select,input').forEach((input)=>input.addEventListener('input',render));
    render();
  }
</script>
