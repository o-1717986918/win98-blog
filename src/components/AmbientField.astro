<div class="ambient-field" aria-hidden="true" data-ambient-field data-pagefind-ignore>
  <div class="ambient-lenses"><i></i><i></i><i></i></div>
  <div class="pixi-mount" data-pixi-mount></div>
</div>
<button class="motion-toggle" type="button" data-motion-toggle data-pagefind-ignore aria-pressed="false">
  <i aria-hidden="true"></i><span>暂停背景动效</span>
</button>

<style>
  .ambient-field {
    --view-x: 0;
    --view-y: 0;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: rgb(var(--bg-rgb));
  }
  .ambient-lenses {
    position: absolute;
    inset: -12%;
    z-index: 0;
    transform: perspective(900px)
      rotateX(calc(var(--view-y) * -.55deg))
      rotateY(calc(var(--view-x) * .7deg))
      translate3d(calc(var(--view-x) * -1.2rem), calc(var(--view-y) * -.9rem), 0)
      scale(1.035);
    transform-origin: center;
    transition: transform .42s cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
  }
  .ambient-lenses i { position: absolute; display: block; border-radius: 9rem 1rem 12rem 2rem; filter: blur(5rem); }
  .ambient-lenses i:nth-child(1) { top: -21%; left: -12%; width: min(31vw, 27rem); aspect-ratio: .7; background: rgba(var(--field-primary-rgb), .18); transform: rotate(-9deg); }
  .ambient-lenses i:nth-child(2) { top: 24%; right: -15%; width: min(29vw, 24rem); aspect-ratio: .62; background: rgba(var(--field-secondary-rgb), .14); transform: rotate(7deg); }
  .ambient-lenses i:nth-child(3) { bottom: -27%; left: 8%; width: min(42vw, 36rem); aspect-ratio: 2.2; background: rgba(var(--secondary-rgb), .1); transform: rotate(-3deg); }
  :global(:root[data-theme='mist']) .ambient-lenses i:nth-child(1) { opacity: .68; }
  :global(:root[data-theme='mist']) .ambient-lenses i:nth-child(2) { opacity: .61; }
  :global(:root[data-theme='mist']) .ambient-lenses i:nth-child(3) { opacity: .52; }
  .ambient-field::before {
    content: '';
    position: absolute;
    inset: -18%;
    z-index: 2;
    opacity: .05;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.84' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.58'/%3E%3C/svg%3E");
    transform: translate3d(calc(var(--view-x) * .32rem), calc(var(--view-y) * .24rem), 0) rotate(3deg);
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }
  .ambient-field::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(180deg, rgba(var(--bg-rgb), .02), transparent 28%, rgba(var(--bg-rgb), .10)),
      radial-gradient(ellipse at 50% 42%, transparent 36%, rgba(var(--bg-rgb), .14) 100%);
  }
  .pixi-mount {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(.22, 1, .36, 1);
  }
  .ambient-field[data-ready='true'] .pixi-mount { opacity: .96; }
  .pixi-mount :global(.pixi-field-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .motion-toggle {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 44;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.15rem;
    padding: .42rem .68rem;
    border: 1px solid rgba(var(--text-rgb), .15);
    border-radius: 999px;
    color: rgba(var(--text-rgb), .62);
    background: rgba(var(--surface-rgb), .66);
    box-shadow: 0 .7rem 2rem rgba(var(--bg-rgb), .2), inset 0 1px rgba(255, 255, 255, .14);
    font-family: var(--font-mono);
    font-size: .55rem;
    letter-spacing: .04em;
    backdrop-filter: blur(18px) saturate(150%);
    cursor: pointer;
    transition: color .25s ease, border-color .25s ease, transform .25s ease, background .25s ease;
  }
  .motion-toggle i {
    width: .72rem;
    height: 2px;
    border-radius: 0;
    background: rgb(var(--signal-rgb));
    box-shadow: .22rem .22rem 0 rgba(var(--signal-rgb), .32);
  }
  .motion-toggle[aria-pressed='true'] i { background: rgba(var(--text-rgb), .34); box-shadow: none; }
  .motion-toggle:hover { border-color: rgba(var(--signal-rgb), .62); color: rgb(var(--signal-rgb)); transform: translateY(-2px); background: rgba(var(--surface-rgb), .82); }
  .motion-toggle:focus-visible { outline: 2px solid rgb(var(--signal-rgb)); outline-offset: 3px; }
  @media (min-width: 1101px) { :global(body:has(.site-header)) .motion-toggle { display: none; } }
  @media (max-width: 520px) {
    .ambient-lenses { inset: -5% -30%; }
    .ambient-lenses i { filter: blur(3rem); }
    .motion-toggle { bottom: max(.65rem, env(safe-area-inset-bottom)); left: .65rem; min-height: 2rem; padding-inline: .55rem; }
    .motion-toggle span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    :global(body:has(.site-header)) .motion-toggle { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-lenses, .ambient-field::before { transition: none; transform: none; }
    .pixi-mount { transition: none; opacity: .68; }
    .motion-toggle { transition: none; }
  }
</style>

<script>
  import type { FieldController, FieldPalette, Rgb } from '../lib/pixi-field';
  import { storageGet, storageSet } from '../lib/browser-storage';

  const motionKey = 'someone-site:ambient-paused';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let manualPause = storageGet('localStorage', motionKey) === 'true';
  let hiddenPause = document.hidden;
  let introPause = Boolean(document.querySelector('[data-site-intro]:not([hidden])'));
  let controller: FieldController | undefined;
  let controllerPromise: Promise<void> | undefined;
  let disposed = false;

  const readRgb = (name: string): Rgb => {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name);
    const parts = value.split(',').map((part) => Number(part.trim()) / 255);
    return [parts[0] ?? 1, parts[1] ?? 1, parts[2] ?? 1];
  };
  const readPalette = (): FieldPalette => ({
    primary: readRgb('--field-primary-rgb'),
    secondary: readRgb('--field-secondary-rgb'),
    warm: readRgb('--field-warm-rgb'),
    light: getComputedStyle(document.documentElement).colorScheme.includes('light') ? 1 : 0,
  });
  const active = () => !manualPause && !hiddenPause && !introPause && !reduced.matches;
  const ensureController = () => {
    if (controller || controllerPromise || !active() || disposed) return controllerPromise;
    const host = document.querySelector<HTMLElement>('[data-pixi-mount]');
    if (!host) return undefined;
    controllerPromise = import('../lib/pixi-field').then(async ({ mountPixiField }) => {
      if (disposed || !active()) return;
      controller = await mountPixiField(host, readPalette());
      if (disposed) { controller.destroy(); controller = undefined; return; }
      host.closest<HTMLElement>('[data-ambient-field]')?.setAttribute('data-ready', 'true');
      controller.setRunning(active());
    }).catch((error) => {
      console.warn('[ambient-field] WebGL background unavailable; keeping the CSS color field.', error);
    }).finally(() => { controllerPromise = undefined; });
    return controllerPromise;
  };
  const syncController = () => {
    if (disposed) return;
    if (active()) ensureController();
    controller?.setRunning(active());
  };
  const syncButtons = () => {
    const paused = manualPause || reduced.matches;
    document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(paused));
      const label = button.querySelector('span');
      if (label) label.textContent = paused ? '启用背景动效' : '暂停背景动效';
      button.title = reduced.matches ? '系统已启用减弱动态' : (paused ? '启用背景动效' : '暂停背景动效');
    });
  };

  syncButtons();
  syncController();

  document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      manualPause = button.getAttribute('aria-pressed') !== 'true';
      storageSet('localStorage', motionKey, String(manualPause));
      syncButtons();
      syncController();
    });
  });
  addEventListener('site:theme', () => {
    if (!disposed) controller?.setPalette(readPalette());
  });
  addEventListener('site:intro-start', () => {
    introPause = true;
    syncController();
  });
  addEventListener('site:intro-end', () => {
    introPause = false;
    syncController();
  });
  document.addEventListener('visibilitychange', () => {
    hiddenPause = document.hidden;
    syncController();
  });
  reduced.addEventListener('change', () => {
    syncButtons();
    syncController();
  });
  addEventListener('pagehide', () => {
    disposed = true;
    const activeController = controller;
    controller = undefined;
    activeController?.destroy();
  }, { once: true });
</script>
