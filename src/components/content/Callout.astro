---
interface Props { type?: 'note' | 'tip' | 'warning'; title?: string; }
const { type = 'note', title } = Astro.props;
const labels = { note: '旁注', tip: '方法', warning: '注意' } as const;
---

<aside class:list={['content-callout', `content-callout--${type}`]} role="note">
  <p class="content-callout__label"><span aria-hidden="true"></span>{title ?? labels[type]}</p>
  <div class="content-callout__body"><slot /></div>
</aside>

<style>
  .content-callout { --callout-color: var(--spectrum-aqua-rgb); position: relative; display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; margin: 2rem 0; padding: 1.15rem 1.25rem; overflow: hidden; border: 1px solid rgba(var(--callout-color), .38); background: linear-gradient(118deg, rgba(var(--callout-color), .13), rgba(var(--surface-rgb), .76) 54%); }
  .content-callout::after { content: ''; position: absolute; top: 0; right: 0; width: 2.5rem; height: .24rem; background: rgb(var(--callout-color)); }
  .content-callout--tip { --callout-color: var(--spectrum-gold-rgb); }
  .content-callout--warning { --callout-color: var(--spectrum-coral-rgb); }
  .content-callout__label { display: flex; align-items: center; align-self: start; gap: .45rem; margin: 0; color: rgb(var(--callout-color)); font-family: var(--font-mono); font-size: .62rem; font-weight: 700; letter-spacing: .08em; }
  .content-callout__label span { width: .65rem; height: .65rem; border: 1px solid currentColor; transform: rotate(45deg); }
  .content-callout__body { color: rgba(var(--text-rgb), .82); font-size: .92em; }
  .content-callout__body :global(> :last-child) { margin-bottom: 0; }
  @media (max-width: 520px) { .content-callout { grid-template-columns: 1fr; gap: .55rem; } }
</style>
