<div class="reader-controls" aria-label="阅读设置" data-reader-controls data-pagefind-ignore>
  <div class="reader-panel" id="reader-settings-panel" data-reader-panel hidden>
    <div class="reader-panel__group" aria-label="字号">
      <button type="button" data-reader="smaller" aria-label="减小字号">A−</button>
      <button type="button" data-reader="larger" aria-label="增大字号">A+</button>
    </div>
    <button type="button" data-reader="leading" aria-label="切换行距">行距·中</button>
    <button type="button" data-reader="resume" hidden>续读</button>
    <button type="button" data-reader="focus" aria-label="切换沉浸阅读">专注</button>
    <output class="reader-status" data-reader-status aria-live="polite"></output>
  </div>
  <button class="reader-trigger" type="button" aria-expanded="false" aria-controls="reader-settings-panel" data-reader-trigger>
    <span aria-hidden="true">Aa</span><span>阅读</span>
  </button>
</div>

<style>
  .reader-controls { position: fixed; right: 1rem; bottom: 1rem; z-index: 45; }
  .reader-trigger, .reader-panel { border: 1px solid var(--line-strong); border-radius: 3px; background: rgba(var(--surface-rgb), .92); box-shadow: 0 .7rem 2rem rgba(0, 0, 0, .16); backdrop-filter: blur(14px); }
  .reader-trigger { display: flex; align-items: center; gap: .45rem; height: 2.35rem; padding: 0 .72rem; color: rgba(var(--text-rgb), .68); font-family: var(--font-mono); font-size: .6rem; cursor: pointer; }
  .reader-trigger span:first-child { color: rgb(var(--signal-rgb)); font-family: var(--font-reading); font-size: .88rem; }
  .reader-trigger[aria-expanded='true'] { border-color: rgba(var(--signal-rgb), .68); color: rgb(var(--text-rgb)); }
  .reader-panel { position: absolute; right: 0; bottom: calc(100% + .48rem); display: flex; align-items: center; gap: .3rem; min-width: max-content; padding: .34rem; }
  .reader-panel[hidden] { display: none; }
  .reader-panel__group { display: flex; gap: .2rem; padding-right: .3rem; border-right: 1px solid var(--line); }
  .reader-panel button { min-width: 2.25rem; height: 2.25rem; padding: 0 .55rem; border: 1px solid var(--line); border-radius: 2px; color: rgba(var(--text-rgb), .66); background: transparent; font-family: var(--font-mono); font-size: .61rem; cursor: pointer; }
  .reader-panel button:hover, .reader-panel button:focus-visible { border-color: rgb(var(--signal-rgb)); color: rgb(var(--signal-rgb)); }
  .reader-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(body[data-immersive='true'] .site-header), :global(body[data-immersive='true'] .site-footer), :global(body[data-immersive='true'] .toc) { opacity: 0; visibility: hidden; pointer-events: none; }
  :global(body[data-immersive='true'] .shell-main) { padding-top: 0; }
  @media (max-width: 520px) {
    .reader-controls { right: .65rem; bottom: max(.65rem, env(safe-area-inset-bottom)); }
    .reader-panel { max-width: calc(100vw - 1.3rem); }
    .reader-panel button { min-width: 2rem; height: 2rem; padding-inline: .42rem; }
  }
</style>

<script>
  import { storageGet, storageRemove, storageSet } from '../../lib/browser-storage';

  const scaleKey = 'someone-site:reader-scale';
  const leadingKey = 'someone-site:reader-leading';
  const focusKey = 'someone-site:immersive';
  const positionKey = `someone-site:reading-position:${location.pathname}`;
  const store = {
    get(key: string) { return storageGet('localStorage', key); },
    set(key: string, value: string) { storageSet('localStorage', key, value); },
    remove(key: string) { storageRemove('localStorage', key); },
  };
  const clamp = (value: number) => Math.min(1.2, Math.max(.9, value));
  const leadingModes = ['compact', 'normal', 'relaxed'] as const;
  const leadingLabels = { compact: '紧', normal: '中', relaxed: '松' } as const;
  let scale = clamp(Number(store.get(scaleKey)) || 1);
  const savedLeading = store.get(leadingKey);
  let leading = leadingModes.includes(savedLeading as typeof leadingModes[number]) ? savedLeading as typeof leadingModes[number] : 'normal';
  const applyScale = () => document.documentElement.style.setProperty('--reader-scale', String(scale));
  const applyLeading = () => { document.documentElement.dataset.readerLeading = leading; };
  applyScale();
  applyLeading();
  document.body.dataset.immersive = store.get(focusKey) === 'true' ? 'true' : 'false';

  const toggleFocus = () => {
    const next = document.body.dataset.immersive !== 'true';
    document.body.dataset.immersive = String(next);
    store.set(focusKey, String(next));
  };

  document.querySelectorAll<HTMLElement>('[data-reader-controls]').forEach((controls) => {
    const trigger = controls.querySelector<HTMLButtonElement>('[data-reader-trigger]');
    const panel = controls.querySelector<HTMLElement>('[data-reader-panel]');
    const leadingButton = controls.querySelector<HTMLButtonElement>('[data-reader="leading"]');
    const resumeButton = controls.querySelector<HTMLButtonElement>('[data-reader="resume"]');
    const status = controls.querySelector<HTMLOutputElement>('[data-reader-status]');
    const setPanel = (open: boolean) => { if (panel && trigger) { panel.hidden = !open; trigger.ariaExpanded = String(open); } };
    trigger?.addEventListener('click', () => setPanel(trigger.ariaExpanded !== 'true'));
    controls.querySelector('[data-reader="smaller"]')?.addEventListener('click', () => { scale = clamp(scale - .1); store.set(scaleKey, String(scale)); applyScale(); if (status) status.value = `字号 ${Math.round(scale * 100)}%`; });
    controls.querySelector('[data-reader="larger"]')?.addEventListener('click', () => { scale = clamp(scale + .1); store.set(scaleKey, String(scale)); applyScale(); if (status) status.value = `字号 ${Math.round(scale * 100)}%`; });
    const updateLeadingLabel = () => { if (leadingButton) leadingButton.textContent = `行距·${leadingLabels[leading]}`; };
    updateLeadingLabel();
    leadingButton?.addEventListener('click', () => {
      leading = leadingModes[(leadingModes.indexOf(leading) + 1) % leadingModes.length]!;
      store.set(leadingKey, leading);
      applyLeading();
      updateLeadingLabel();
      if (status) status.value = `行距${leadingLabels[leading]}`;
    });
    const saved = Number(store.get(positionKey));
    const maximum = Math.max(0, document.documentElement.scrollHeight - innerHeight);
    if (resumeButton && Number.isFinite(saved) && saved > 240 && saved < maximum - 120) {
      resumeButton.hidden = false;
      resumeButton.textContent = `续读 ${Math.round(saved / maximum * 100)}%`;
      resumeButton.addEventListener('click', () => {
        scrollTo({ top: saved, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        resumeButton.hidden = true;
        if (status) status.value = '已回到上次阅读位置';
      });
    }
    controls.querySelector('[data-reader="focus"]')?.addEventListener('click', toggleFocus);
    addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('input, textarea, select') || event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key.toLowerCase() === 't') toggleFocus();
      if (event.key === 'Escape' && trigger?.ariaExpanded === 'true') { setPanel(false); trigger.focus(); }
      else if (event.key === 'Escape' && document.body.dataset.immersive === 'true') toggleFocus();
    });
  });

  let saveTimer = 0;
  addEventListener('scroll', () => {
    if (saveTimer) return;
    saveTimer = window.setTimeout(() => {
      saveTimer = 0;
      const maximum = document.documentElement.scrollHeight - innerHeight;
      if (scrollY < 160 || scrollY > maximum - 80) store.remove(positionKey);
      else store.set(positionKey, String(Math.round(scrollY)));
    }, 700);
  }, { passive: true });
</script>
