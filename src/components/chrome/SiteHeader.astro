---
import { getCollection } from 'astro:content';
import SearchIndex from '../SearchIndex.astro';
import { PORTAL_FEATURES } from '../../config/portal';
import { SITE } from '../../config/site';
import { isPublished, sortColumns } from '../../lib/content';
import { withBase } from '../../lib/site-path';

const columns = sortColumns((await getCollection('columns')).filter(isPublished).filter((column) => column.data.nav));
const pathname = Astro.url.pathname;
const current = (href: string) => {
  const resolved = withBase(href);
  return href === '/' ? pathname === resolved : pathname.startsWith(resolved);
};
const portalLinks = [
  { label: '项目', href: '/projects/', enabled: PORTAL_FEATURES.projects },
  { label: '能力', href: '/skills/', enabled: PORTAL_FEATURES.skills },
  { label: '时间线', href: '/timeline/', enabled: PORTAL_FEATURES.timeline },
  { label: '标签索引', href: '/tags/', enabled: true },
].filter((item) => item.enabled);
const portalCurrent = portalLinks.some((item) => current(item.href));
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="header-inner">
    <a class="site-brand" href={withBase('/')} aria-label={`${SITE.title} · 返回首页`}>
      <span class="brand-mark" aria-hidden="true"><img src={withBase('/brand/logo.jpg')} alt="" width="640" height="640" decoding="async" /></span>
      <span>{SITE.title}<small>ESSAYS · NOTES · EXPERIMENTS</small></span>
      <i class="brand-home" aria-hidden="true">HOME</i>
    </a>
    <button class="menu-button" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-navigation" data-menu-button>
      <i></i><i></i>
    </button>
    <div class="navigation-shell" id="site-navigation" data-navigation-shell>
      <nav class="site-navigation" aria-label="主导航">
        <a href={withBase('/')} aria-current={current('/') ? 'page' : undefined}>首页</a>
        <a href={withBase('/archive/')} aria-current={current('/archive/') ? 'page' : undefined}>文章</a>
        <details class="column-menu">
          <summary data-current={current('/columns/') ? 'true' : undefined}>主题 <span aria-hidden="true">⌄</span></summary>
          <div class="column-menu__panel">
            {columns.map((column) => (
              <a href={withBase(`/columns/${column.id}/`)} aria-current={current(`/columns/${column.id}/`) ? 'page' : undefined}>
                <span>{column.data.navLabel ?? column.data.title}</span><i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </details>
        <a href={withBase('/notes/')} aria-current={current('/notes/') ? 'page' : undefined}>笔记</a>
        <details class="column-menu explore-menu">
          <summary data-current={portalCurrent ? 'true' : undefined}>探索 <span aria-hidden="true">⌄</span></summary>
          <div class="column-menu__panel">
            {portalLinks.map((item) => (
              <a href={withBase(item.href)} aria-current={current(item.href) ? 'page' : undefined}>
                <span>{item.label}</span><i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </details>
        <a href={withBase('/about/')} aria-current={current('/about/') ? 'page' : undefined}>关于</a>
      </nav>
      <div class="header-search-slot"><SearchIndex /></div>
      <button class="header-motion" type="button" data-motion-toggle aria-pressed="false"><i aria-hidden="true"></i><span>暂停背景动效</span></button>
      <button class="theme-button" type="button" data-theme-button aria-label="切换配色">
        <span data-theme-name>MIST</span>
        <span class="theme-register" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; height: var(--header); border-bottom: 1px solid rgba(var(--brand-primary-rgb), .34); background: rgba(var(--header-panel-rgb), .96); box-shadow: 0 .8rem 2.6rem rgba(4, 12, 22, .16); backdrop-filter: blur(18px); }
  .header-inner { position: relative; display: flex; align-items: center; width: min(var(--content), calc(100% - clamp(2.5rem, 5vw, 6rem))); height: 100%; margin-inline: auto; }
  .site-brand { display: flex; align-items: center; gap: .72rem; margin-right: auto; padding: 0 1rem 0 0; border-right: 1px solid rgba(var(--brand-primary-rgb), .38); color: rgb(var(--text-rgb)); font-family: var(--font-signature); font-size: .88rem; font-weight: 680; letter-spacing: .06em; text-align: left; text-decoration: none; }
  .site-brand small { display: block; margin-top: .12rem; color: rgba(var(--text-rgb), .42); font-family: var(--font-mono); font-size: .49rem; font-weight: 500; letter-spacing: .12em; }
  .brand-mark { position: relative; display: block; flex: 0 0 auto; width: 2rem; height: 2rem; padding: 2px; overflow: hidden; border: 1px solid rgba(var(--brand-primary-rgb), .52); border-radius: .42rem; background: linear-gradient(145deg, rgb(var(--brand-primary-rgb)), rgb(var(--brand-secondary-rgb))); box-shadow: 0 .35rem 1rem rgba(var(--bg-rgb), .18), 0 0 1.1rem rgba(var(--brand-primary-rgb), .08); }
  .brand-mark::after { content: ''; position: absolute; inset: 2px; border: 1px solid rgba(255, 255, 255, .2); border-radius: .28rem; pointer-events: none; }
  .brand-mark img { display: block; width: 100%; height: 100%; border-radius: .28rem; object-fit: cover; object-position: center; }
  .brand-home { color: rgb(var(--brand-primary-rgb)); font: normal .47rem/1 var(--font-mono); letter-spacing: .08em; transition: color .2s var(--ease), transform .2s var(--ease); }
  .site-brand:hover .brand-home, .site-brand:focus-visible .brand-home { color: rgb(var(--brand-secondary-rgb)); transform: translateX(.15rem); }
  .navigation-shell, .site-navigation { display: flex; align-items: center; }
  .navigation-shell { gap: 1rem; margin-left: auto; }
  .header-search-slot { position: absolute; left: 50%; width: max-content; transform: translateX(-50%); }
  .site-navigation { gap: 1.1rem; }
  .site-navigation > a, .column-menu > summary { position: relative; padding: .6rem 0; border: 0; color: rgba(var(--text-rgb), .56); background: transparent; font-size: .78rem; text-decoration: none; cursor: pointer; }
  .column-menu { position: relative; }
  .column-menu > summary { display: flex; align-items: center; gap: .35rem; list-style: none; cursor: pointer; }
  .column-menu > summary::-webkit-details-marker { display: none; }
  .column-menu > summary span { color: rgb(var(--spectrum-violet-rgb)); transition: transform .2s var(--ease); }
  .column-menu[open] > summary span { transform: rotate(180deg); }
  .column-menu__panel { position: absolute; top: calc(100% + .8rem); left: 50%; display: grid; min-width: 14.5rem; padding: .45rem; border: 1px solid var(--line-strong); background: rgb(var(--surface-rgb)); box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .2); transform: translateX(-50%); }
  .column-menu__panel a { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem .75rem; color: rgba(var(--text-rgb), .68); font-size: .73rem; text-decoration: none; }
  .column-menu__panel a::after { display: none; }
  .column-menu__panel a:hover { color: rgb(var(--text-rgb)); background: rgba(var(--raised-rgb), .55); }
  .column-menu__panel i { color: rgb(var(--spectrum-violet-rgb)); font-style: normal; }
  .site-navigation a::after { content: ''; position: absolute; right: 0; bottom: .3rem; left: 0; height: 1px; background: rgb(var(--signal-rgb)); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  .site-navigation > a:hover, .site-navigation > a[aria-current='page'], .column-menu > summary:hover, .column-menu > summary[data-current='true'] { color: rgb(var(--text-rgb)); }
  .site-navigation a:hover::after, .site-navigation a[aria-current='page']::after { transform: scaleX(1); }
  .theme-button { display: inline-flex; align-items: center; gap: .7rem; min-width: 7.4rem; padding: .48rem .58rem; border: 1px solid rgba(var(--brand-secondary-rgb), .4); border-radius: .48rem; color: rgb(var(--text-rgb)); background: rgb(var(--card-warm-rgb)); font-family: var(--font-mono); font-size: .56rem; letter-spacing: .06em; cursor: pointer; }
  .header-motion { display: none; }
  .theme-register { display: grid; grid-template-columns: .72rem .42rem; gap: .18rem; align-items: center; width: 1.35rem; height: .8rem; margin-left: auto; }
  .theme-register i { display: block; width: 100%; height: 2px; border-radius: 0; }
  .theme-register i:first-child { background: rgb(var(--brand-primary-rgb)); transform: translateY(-.13rem); }
  .theme-register i:last-child { background: rgb(var(--brand-secondary-rgb)); transform: translateY(.14rem); }
  .menu-button { display: none; width: 2.35rem; height: 2.35rem; border: 1px solid var(--line); border-radius: var(--radius); background: transparent; cursor: pointer; }
  .menu-button i { display: block; width: 1rem; height: 1px; margin: .28rem auto; background: currentColor; transition: transform .22s var(--ease); }
  .menu-button[aria-expanded='true'] i:first-child { transform: translateY(.145rem) rotate(45deg); }
  .menu-button[aria-expanded='true'] i:last-child { transform: translateY(-.145rem) rotate(-45deg); }
  @media (min-width: 1101px) {
    .site-header { inset: 0 auto 0 0; width: var(--site-rail); height: 100dvh; border-right: 1px solid rgba(var(--brand-primary-rgb), .34); border-bottom: 0; box-shadow: .8rem 0 2.6rem rgba(4, 12, 22, .12); }
    .header-inner { flex-direction: column; align-items: stretch; width: 100%; height: 100%; margin: 0; padding: 1.15rem 1rem; }
    .site-brand { width: 100%; margin: 0; padding: 0 0 1rem; border-right: 0; border-bottom: 1px solid rgba(var(--brand-primary-rgb), .38); }
    .brand-home { margin-left: auto; }
    .navigation-shell { flex: 1; flex-direction: column; align-items: stretch; gap: .65rem; min-height: 0; margin: 1rem 0 0; }
    .site-navigation { display: grid; gap: .18rem; align-items: stretch; }
    .site-navigation > a, .column-menu > summary { display: flex; justify-content: space-between; width: 100%; padding: .62rem .25rem; border-bottom: 1px solid var(--line); font-size: .72rem; }
    .site-navigation a::after { right: auto; bottom: -.5px; width: 2.4rem; }
    .column-menu__panel { top: -.35rem; left: calc(100% + 1.75rem); min-width: 13rem; transform: none; }
    .header-search-slot { position: static; order: -1; width: 100%; transform: none; }
    :global(.header-search) { width: 100%; }
    :global(.header-search .search-results-panel) { top: 0; right: auto; left: calc(100% + 1rem); max-height: calc(100dvh - 2rem); }
    .header-motion { display: flex; align-items: center; gap: .55rem; width: 100%; margin-top: auto; padding: .62rem; border: 1px solid var(--line); color: rgba(var(--text-rgb), .68); background: transparent; font-family: var(--font-mono); font-size: .56rem; cursor: pointer; }
    .header-motion i { width: .72rem; height: 2px; background: rgb(var(--signal-rgb)); box-shadow: .22rem .22rem 0 rgba(var(--signal-rgb), .32); }
    .header-motion[aria-pressed='true'] i { background: rgba(var(--text-rgb), .34); box-shadow: none; }
    .theme-button { width: 100%; min-width: 0; }
  }
  @media (max-width: 1100px) {
    .menu-button { display: block; }
    .navigation-shell { position: fixed; top: calc(var(--header) + .5rem); right: 1rem; left: 1rem; display: block; padding: .5rem; border: 1px solid var(--line-strong); border-radius: .65rem; background: rgb(var(--header-panel-rgb)); opacity: 0; visibility: hidden; transform: translateY(-.5rem); pointer-events: none; transition: .22s var(--ease); }
    .navigation-shell[data-open='true'] { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }
    .site-navigation { display: grid; gap: 0; }
    .site-navigation > a, .column-menu > summary { width: 100%; padding: .8rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
    .site-navigation a::after { display: none; }
    .column-menu__panel { position: static; min-width: 0; padding: 0 0 0 .65rem; border: 0; border-bottom: 1px solid var(--line); background: transparent; box-shadow: none; transform: none; }
    .column-menu__panel a { padding: .65rem .75rem; border-left: 1px solid var(--line); }
    .header-search-slot { position: static; width: 100%; transform: none; }
    .theme-button { width: 100%; margin-top: .5rem; padding: .72rem; }
    .header-motion { display: flex; align-items: center; gap: .55rem; width: 100%; margin-top: .5rem; padding: .72rem; border: 1px solid var(--line); color: rgba(var(--text-rgb), .68); background: transparent; font-family: var(--font-mono); font-size: .6rem; cursor: pointer; }
    .header-motion i { width: .72rem; height: 2px; background: rgb(var(--signal-rgb)); box-shadow: .22rem .22rem 0 rgba(var(--signal-rgb), .32); }
    .header-motion[aria-pressed='true'] i { background: rgba(var(--text-rgb), .34); box-shadow: none; }
  }
  @media (max-width: 430px) { .site-brand small { display: none; } }

</style>

<script>
  const themeIds = ['mist', 'abyss'] as const;
  type ThemeId = (typeof themeIds)[number];
  const root = document.documentElement;
  const stored = localStorage.getItem('someone-site:theme');
  const compatibleStored = stored === 'paper' ? 'mist' : stored === 'graphite' || stored === 'night' || stored === 'indigo' ? 'abyss' : stored;
  if (compatibleStored && themeIds.includes(compatibleStored as ThemeId)) root.dataset.theme = compatibleStored;

  const themeNames: Record<ThemeId, string> = { mist: 'MIST', abyss: 'ABYSS' };
  const syncThemeLabel = () => {
    const name = (root.dataset.theme ?? 'mist') as ThemeId;
    document.querySelectorAll<HTMLElement>('[data-theme-name]').forEach((node) => { node.textContent = themeNames[name] ?? 'MIST'; });
  };
  syncThemeLabel();

  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const shell = header.querySelector<HTMLElement>('[data-navigation-shell]');
    const themeButton = header.querySelector<HTMLButtonElement>('[data-theme-button]');
    if (!button || !shell || !themeButton) return;

    const close = () => {
      shell.dataset.open = 'false';
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', '打开导航');
      header.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((details) => { details.open = false; });
    };
    button.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = shell.dataset.open !== 'true';
      shell.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    });
    themeButton.addEventListener('click', () => {
      const current = themeIds.indexOf((root.dataset.theme ?? 'mist') as ThemeId);
      const next = themeIds[(current + 1) % themeIds.length] ?? 'mist';
      root.dataset.theme = next;
      localStorage.setItem('someone-site:theme', next);
      syncThemeLabel();
      dispatchEvent(new CustomEvent('site:theme'));
      close();
    });
    header.querySelector('[data-motion-toggle]')?.addEventListener('click', close);
    header.querySelectorAll('a').forEach((control) => control.addEventListener('click', close));
    document.addEventListener('click', (event) => { if (!header.contains(event.target as Node)) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  });

  document.addEventListener('keydown', (event) => {
    const editable = event.target instanceof HTMLElement && Boolean(event.target.closest('input, textarea, select, [contenteditable="true"]'));
    if (editable || !((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') && event.key !== '/') return;
    event.preventDefault();
    document.querySelector<HTMLInputElement>('[data-search-input]')?.focus();
  });
</script>
