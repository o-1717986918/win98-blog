---
interface Props { href?: string; label?: string; }
const { href = '/', label = '返回上页' } = Astro.props;
---

<a class="back-badge" href={href} aria-label={label} data-history-back>← <span>{label}</span></a>

<style>
  .back-badge {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .62rem .76rem;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 2px;
    color: #eef0ef;
    background: rgba(10, 14, 20, .86);
    backdrop-filter: blur(12px);
    font: 600 .7rem/1.2 ui-monospace, 'Cascadia Code', monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .back-badge:hover { border-color: #62ccb8; color: #77dbc8; }
  .back-badge:focus-visible { outline: 2px solid #77dbc8; outline-offset: 3px; }
  @media (max-width: 520px) { .back-badge span { display: none; } }
</style>

<script>
  const bindHistoryBack = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-history-back]').forEach((link) => {
      if (link.dataset.bound === 'true') return;
      link.dataset.bound = 'true';
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (!document.referrer) return;
        const previous = new URL(document.referrer);
        const current = new URL(location.href);
        if (previous.origin !== current.origin || previous.pathname === current.pathname) return;
        event.preventDefault();
        history.back();
      });
    });
  };
  bindHistoryBack();
  document.addEventListener('astro:page-load', bindHistoryBack);
</script>
