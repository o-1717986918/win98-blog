---
import { SITE } from '../../config/site';
---

<footer class="site-footer" data-pagefind-ignore>
  <span>© {new Date().getFullYear()} {SITE.title}</span>
  <span>写作 / 系统 / 图形</span>
  <nav aria-label="页脚导航"><a href="#site-search">搜索</a><a href="/archive/">文章</a><a href="/rss.xml">RSS</a><a href="/privacy/">隐私</a></nav>
</footer>

<style>
  .site-footer { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; width: min(100% - 2rem, 78rem); margin-inline: auto; padding: 1.8rem 0 2.2rem; border-top: 1px solid var(--line); color: rgba(var(--text-rgb), .44); font-family: var(--font-mono); font-size: .6rem; }
  .site-footer::before { content: '·  ·  ·'; position: absolute; top: -.72rem; left: 0; padding-inline: .3rem; color: rgb(var(--brand-primary-rgb)); background: rgb(var(--bg-rgb)); font-size: .9rem; letter-spacing: .2rem; text-shadow: .55rem 0 rgb(var(--brand-secondary-rgb)), 1.1rem 0 rgb(var(--secondary-rgb)); }
  .site-footer nav { display: flex; justify-content: flex-end; gap: 1rem; }
  .site-footer a { padding: 0; border: 0; color: inherit; background: none; font: inherit; text-decoration: none; cursor: pointer; }
  .site-footer a:hover { color: rgb(var(--signal-rgb)); }
  @media (max-width: 620px) { .site-footer { grid-template-columns: 1fr; } .site-footer nav { justify-content: flex-start; } }
</style>
