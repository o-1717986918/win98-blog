---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { arcDocGroups, arcDocs } from './docs';
import { withBase } from '../../lib/site-path';

interface Props {
  index: string;
  section: string;
  title: string;
  deck: string;
  image: ImageMetadata;
  imageAlt: string;
  nextHref?: string;
  nextLabel?: string;
}
const { index, section, title, deck, image, imageAlt, nextHref, nextLabel } = Astro.props;
---

<main class="arc-doc" data-pagefind-body>
  <nav class="arc-doc__nav">
    <a class="arc-doc__brand" href={withBase('/columns/arcvellum/')}><b>AV</b><span>ARC VELLUM / TECHNICAL DOCUMENTS</span></a>
    <div><a href="https://github.com/o-1717986918/arcvellum" rel="noreferrer">SOURCE</a><a href="https://github.com/o-1717986918/arcvellum/releases" rel="noreferrer">v0.99.3</a><a href={withBase('/columns/arcvellum/#evidence')}>VERIFICATION</a></div>
    <a href={withBase('/')}>小站 ↗</a>
  </nav>
  <header class="arc-doc__hero">
    <div class="arc-doc__number"><span>{index}</span><small>{section}</small></div>
    <div class="arc-doc__title"><p>ARC VELLUM DOCUMENT / {index}</p><h1>{title}</h1><p>{deck}</p></div>
    <figure><Image src={image} alt={imageAlt} widths={[640, 960, 1280]} sizes="(max-width: 800px) 100vw, 44vw" loading="eager" /><figcaption>仓库内真实产品界面 / RELEASE EVIDENCE</figcaption></figure>
  </header>
  <div class="arc-doc__body">
    <aside class="arc-doc__sidebar"><div><span>DOCUMENT BASIS</span><p>本文依据当前源码、架构合同、真实项目运行与发布证据整理；已验证能力、当前边界和后续假设分开表述。</p></div><nav aria-label="ArcVellum 文章目录">{arcDocGroups.map((group) => <section><h2>{group}</h2>{arcDocs.filter((doc) => doc.group === group).map((doc) => <a class:list={{ active: doc.no === index }} href={withBase(`/posts/${doc.id}/`)} aria-current={doc.no === index ? 'page' : undefined}><i>{doc.no}</i><span>{doc.label}</span><b>{doc.title}</b></a>)}</section>)}</nav></aside>
    <article class="arc-prose"><slot /></article>
  </div>
  {nextHref && <a class="arc-doc__next" href={withBase(nextHref)}><span>NEXT DOCUMENT</span><strong>{nextLabel}</strong><i>↗</i></a>}
  <footer><a href={withBase('/columns/arcvellum/')}>← 返回 ArcVellum 文档入口</a><span>LOCAL-FIRST / HUMAN-IN-COMMAND</span></footer>
</main>

<style>
  :global(html){background:#e3e5dd;scroll-behavior:smooth}:global(body){margin:0;background:#e3e5dd;color:#17201c;font-family:Inter,'Segoe UI','PingFang SC',sans-serif}:global(*){box-sizing:border-box}
  .arc-doc{--green:#35594d;--rust:#a4523f;--gold:#8c7442;--line:rgba(23,32,28,.22);min-height:100vh;background:repeating-linear-gradient(90deg,transparent 0 99px,rgba(23,32,28,.025) 100px),#e3e5dd}
  .arc-doc__nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:4.3rem;padding:0 clamp(1rem,4vw,4.5rem);border-bottom:1px solid var(--line);font:.64rem/1 ui-monospace,monospace;letter-spacing:.1em}.arc-doc__nav a{color:inherit;text-decoration:none}.arc-doc__brand{display:flex;gap:.8rem;align-items:center}.arc-doc__brand b{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid var(--green);border-radius:50%;color:var(--green)}.arc-doc__nav>div{display:flex;gap:1.4rem}.arc-doc__nav>div a:hover{color:var(--rust)}.arc-doc__nav>a:last-child{justify-self:end}
  .arc-doc__hero{display:grid;grid-template-columns:.28fr .82fr .9fr;min-height:34rem;border-bottom:1px solid var(--line)}.arc-doc__number{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,5vw,5rem) clamp(1rem,3vw,3rem);border-right:1px solid var(--line)}.arc-doc__number span{color:var(--rust);font:clamp(4rem,8vw,9rem)/.8 ui-monospace,monospace;letter-spacing:-.1em}.arc-doc__number small{writing-mode:vertical-rl;color:var(--green);font:.62rem/1 ui-monospace,monospace;letter-spacing:.14em}.arc-doc__title{display:flex;flex-direction:column;justify-content:center;padding:clamp(3rem,7vw,7rem) clamp(1.5rem,4vw,5rem);border-right:1px solid var(--line)}.arc-doc__title>p:first-child{color:var(--green);font:.61rem/1.5 ui-monospace,monospace;letter-spacing:.12em}.arc-doc__title h1{margin:1.4rem 0;font-family:'Songti SC',SimSun,serif;font-size:clamp(3rem,5.5vw,6.7rem);font-weight:500;line-height:1.04;letter-spacing:-.065em;text-wrap:balance}.arc-doc__title>p:last-child{max-width:35rem;color:#526159;font-size:.94rem;line-height:1.9}.arc-doc__hero figure{position:relative;display:grid;min-width:0;margin:0;overflow:hidden;background:#101713}.arc-doc__hero figure :global(img){align-self:center;width:100%;height:auto;object-fit:contain;filter:saturate(.7) contrast(1.04)}.arc-doc__hero figcaption{position:absolute;right:1rem;bottom:1rem;padding:.5rem .7rem;color:#d7ded5;background:rgba(11,19,15,.8);font:.53rem/1 ui-monospace,monospace;letter-spacing:.08em}
  .arc-doc__body{display:grid;grid-template-columns:minmax(15rem,.44fr) minmax(0,1fr);gap:clamp(2rem,7vw,7rem);max-width:92rem;margin:auto;padding:clamp(4rem,9vw,9rem) clamp(1.2rem,5vw,5rem)}.arc-doc__sidebar{position:sticky;top:1.2rem;align-self:start;max-height:calc(100vh - 2.4rem);overflow:auto;padding-top:1rem;border-top:3px solid var(--rust);scrollbar-width:thin}.arc-doc__sidebar>div>span{color:var(--rust);font:.6rem/1 ui-monospace,monospace;letter-spacing:.12em}.arc-doc__sidebar>div>p{margin:1rem 0 1.4rem;color:#65736b;font-size:.72rem;line-height:1.8}.arc-doc__sidebar nav{border-top:1px solid var(--line)}.arc-doc__sidebar nav section{margin:0}.arc-doc__sidebar nav h2{margin:1rem .35rem .35rem;color:#7b857f;font:600 .48rem/1 ui-monospace,monospace;letter-spacing:.12em}.arc-doc__sidebar nav a{display:grid;grid-template-columns:2rem 1fr;gap:.2rem .45rem;padding:.7rem .35rem;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}.arc-doc__sidebar nav a:hover,.arc-doc__sidebar nav a.active{background:rgba(53,89,77,.07)}.arc-doc__sidebar nav a.active{box-shadow:inset 3px 0 var(--rust)}.arc-doc__sidebar nav i{grid-row:1/3;color:var(--rust);font:normal .65rem/1.4 ui-monospace,monospace}.arc-doc__sidebar nav span{color:var(--green);font:.5rem/1.4 ui-monospace,monospace;letter-spacing:.08em}.arc-doc__sidebar nav b{font-family:'Songti SC',serif;font-size:.78rem;font-weight:500;line-height:1.45}
  .arc-prose{max-width:48rem}.arc-prose :global(h2){margin:4.8rem 0 1.2rem;padding-top:1rem;border-top:1px solid var(--line);font-family:'Songti SC',serif;font-size:clamp(2rem,3.5vw,3.4rem);font-weight:500;line-height:1.18;letter-spacing:-.045em}.arc-prose :global(h2:first-child){margin-top:0}.arc-prose :global(h3){margin:2.8rem 0 .8rem;color:var(--green);font-family:'Songti SC',serif;font-size:1.45rem;font-weight:600}.arc-prose :global(p),.arc-prose :global(li){color:#34433b;font-size:1rem;line-height:2}.arc-prose :global(strong){color:#17201c}.arc-prose :global(a){color:var(--rust);text-decoration-thickness:1px;text-underline-offset:.2em}.arc-prose :global(blockquote){margin:2.5rem 0;padding:1.2rem 1.4rem;border-left:.28rem solid var(--rust);background:rgba(164,82,63,.07)}.arc-prose :global(blockquote p){margin:0;color:#623c31;font-family:'Songti SC',serif;font-size:1.15rem}.arc-prose :global(table){width:100%;margin:2rem 0;border-collapse:collapse;font-size:.82rem}.arc-prose :global(th),.arc-prose :global(td){padding:.8rem;border:1px solid var(--line);text-align:left;vertical-align:top}.arc-prose :global(th){color:var(--green);font-family:ui-monospace,monospace;font-weight:600}.arc-prose :global(code){padding:.12em .3em;background:rgba(53,89,77,.1);font-family:ui-monospace,monospace;font-size:.85em}.arc-prose :global(pre){overflow:auto;padding:1.2rem;background:#121a16;color:#dbe2da}.arc-prose :global(pre code){padding:0;background:none;color:inherit}.arc-prose :global(hr){margin:4rem 0;border:0;border-top:1px solid var(--line)}
  .arc-doc__next{display:grid;grid-template-columns:.5fr 1fr auto;gap:2rem;align-items:center;min-height:12rem;padding:2rem clamp(1.2rem,6vw,7rem);border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:inherit;text-decoration:none}.arc-doc__next span{color:var(--green);font:.6rem/1 ui-monospace,monospace;letter-spacing:.12em}.arc-doc__next strong{font-family:'Songti SC',serif;font-size:clamp(1.8rem,3.5vw,3.8rem);font-weight:500}.arc-doc__next i{color:var(--rust);font:normal 2rem/1 ui-monospace,monospace}.arc-doc__next:hover{background:rgba(53,89,77,.07)}footer{display:flex;justify-content:space-between;gap:2rem;padding:2rem clamp(1.2rem,6vw,7rem);font:.6rem/1.5 ui-monospace,monospace;letter-spacing:.09em}footer a{color:var(--green);text-decoration:none}footer span{color:#79857f}
  @media(max-width:850px){.arc-doc__nav{grid-template-columns:1fr auto}.arc-doc__nav>div{display:none}.arc-doc__hero{grid-template-columns:5rem 1fr}.arc-doc__title{border-right:0}.arc-doc__hero figure{grid-column:1/-1;min-height:55vw}.arc-doc__body{grid-template-columns:1fr}.arc-doc__body aside{position:static}.arc-doc__next{grid-template-columns:1fr auto}.arc-doc__next span{display:none}}
  @media(max-width:560px){.arc-doc__brand span{display:none}.arc-doc__hero{grid-template-columns:1fr}.arc-doc__number{display:none}.arc-doc__hero figure{grid-row:1;min-height:0;aspect-ratio:16/9}.arc-doc__title{grid-row:2;padding:3.2rem 1.2rem 4rem}.arc-doc__title h1{font-size:clamp(3rem,15vw,4.6rem)}.arc-doc__body{padding:4rem 1.2rem}.arc-doc__next{padding:2rem 1.2rem}.arc-doc__next strong{font-size:1.65rem}footer{display:grid}}
</style>
