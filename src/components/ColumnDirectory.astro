---
import type { ColumnEntry, PostEntry } from '../lib/content';
import { belongsToColumn } from '../lib/content';

interface Props { columns: ColumnEntry[]; posts: PostEntry[]; }
const { columns, posts } = Astro.props;
---

<div class="column-directory">
  {columns.map((column) => (
    <a class="column-card" href={`/columns/${column.id}/`}>
      <div class="column-copy"><h3>{column.data.title}</h3><p>{column.data.description}</p></div>
      <span class="column-meta">{posts.filter((post) => belongsToColumn(post, column.id)).length} 篇 · 进入栏目</span>
      <span class="column-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .column-directory { border-top: 1px solid var(--line); }
  .column-card { --column-accent: var(--spectrum-violet-rgb); position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; margin-top: .65rem; padding: 1.4rem 1rem 1.35rem 1.2rem; border: 1px solid var(--line); border-radius: .7rem; background: linear-gradient(145deg, rgba(var(--surface-rgb), .74), rgba(var(--raised-rgb), .38)); box-shadow: 0 .8rem 1.8rem rgba(0, 0, 0, .08), inset 0 1px rgba(255, 255, 255, .08); text-decoration: none; transition: transform .22s var(--ease), box-shadow .22s var(--ease), border-color .22s var(--ease); }
  .column-card:nth-child(4n + 2) { --column-accent: var(--spectrum-gold-rgb); }
  .column-card:nth-child(4n + 3) { --column-accent: var(--spectrum-aqua-rgb); }
  .column-card:nth-child(4n + 4) { --column-accent: var(--spectrum-coral-rgb); }
  .column-card::before { content: ''; position: absolute; inset: 1.15rem auto 1.15rem -.1rem; width: 4px; border-radius: 999px; background: rgb(var(--column-accent)); box-shadow: 0 0 1.1rem rgba(var(--column-accent), .42); }
  h3 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 620; letter-spacing: -.035em; }
  p { max-width: 28rem; margin-top: .4rem; color: rgba(var(--text-rgb), .55); font-size: .75rem; line-height: 1.7; }
  .column-meta { grid-column: 1; color: rgba(var(--text-rgb), .42); font-family: var(--font-mono); font-size: .55rem; }
  .column-arrow { grid-column: 2; grid-row: 1 / 3; align-self: center; color: rgb(var(--column-accent)); opacity: .5; transition: opacity .2s var(--ease), transform .2s var(--ease); }
  .column-card:hover { z-index: 1; border-color: rgba(var(--column-accent), .42); box-shadow: 0 1.3rem 2.6rem rgba(0, 0, 0, .15), inset 0 1px rgba(255, 255, 255, .12); transform: translateY(-4px) scale(1.012); }
  .column-card:hover h3 { color: rgb(var(--column-accent)); }
  .column-card:hover .column-arrow { opacity: 1; transform: translate(.15rem, -.15rem); }
</style>
