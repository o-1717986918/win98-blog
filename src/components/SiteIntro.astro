---
import { withBase } from '../lib/site-path';
import { SITE } from '../config/site';
---

<div class="site-intro" data-site-intro data-state="idle" data-pagefind-ignore role="dialog" aria-modal="true" aria-label={`进入${SITE.title}`}>
  <canvas class="intro-particles" data-intro-particles aria-hidden="true"></canvas>
  <div class="intro-grain" aria-hidden="true"></div>
  <div class="intro-scan" aria-hidden="true"></div>

  <header class="intro-header">
    <p><img src={withBase('/brand/logo.jpg')} alt="" width="640" height="640" decoding="async" /><span>WIN98'S SITE</span><i></i><span>SESSION / 001</span></p>
    <button class="intro-skip" type="button" data-intro-skip>跳过动画 <kbd>ESC</kbd></button>
  </header>

  <div class="intro-copy">
    <p class="intro-index"><span>ESSAYS</span><span>OBSERVATIONS</span><span>WORKS</span></p>
    <div class="intro-title-stack">
      <p class="intro-echo intro-echo--back" aria-hidden="true">{SITE.title}</p>
      <h1 aria-label={SITE.title}>{SITE.title}</h1>
      <p class="intro-echo intro-echo--front" aria-hidden="true">{SITE.title}</p>
    </div>
    <div class="intro-status">
      <div>
        <span>01</span>
        <p>记录，连接，继续生长。</p>
      </div>
      <div class="intro-progress" aria-hidden="true"><i></i><b></b></div>
      <small>LEAVING A TRAIL OF THOUGHT</small>
    </div>
  </div>

  <footer class="intro-footer" aria-hidden="true">
    <p>EST. 2026<br />31.2304° N / 121.4737° E</p>
    <p>WORDS IN MOTION<br />MADE TO BE READ</p>
  </footer>
</div>

<style>
  :global(body.intro-active) { overflow: hidden; }
  .site-intro {
    position: fixed;
    inset: 0;
    z-index: 120;
    overflow: hidden;
    color: rgb(var(--text-rgb));
    background:
      radial-gradient(ellipse at 62% 42%, rgba(var(--field-secondary-rgb), .095), transparent 42rem),
      radial-gradient(ellipse at 18% 84%, rgba(var(--field-primary-rgb), .055), transparent 34rem),
      rgb(var(--bg-rgb));
    isolation: isolate;
    clip-path: inset(0 0 0 0);
    transition: opacity .9s var(--ease), clip-path 1.08s var(--ease);
  }
  .site-intro[hidden] { display: none; }
  .site-intro[data-state='leaving'] { opacity: 0; clip-path: inset(0 0 100% 0); pointer-events: none; }
  .intro-particles { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; }
  .intro-grain {
    position: absolute;
    inset: -15%;
    z-index: 1;
    opacity: .07;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.62'/%3E%3C/svg%3E");
    transform: rotate(2deg);
    pointer-events: none;
  }
  .intro-scan {
    position: absolute;
    inset: -25% auto -25% 0;
    z-index: 2;
    width: 20vw;
    opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(var(--field-primary-rgb), .12), rgba(var(--text-rgb), .055), transparent);
    filter: blur(1.4rem);
    transform: translateX(-130%) skewX(-12deg);
    pointer-events: none;
  }
  .site-intro[data-state='playing'] .intro-scan { animation: intro-scan 1.35s 1.2s var(--ease) both; }
  .intro-header, .intro-footer {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3.5rem);
    left: clamp(1.25rem, 4vw, 3.5rem);
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
  }
  .intro-header { top: clamp(1.3rem, 4vw, 3rem); }
  .intro-header > p {
    display: flex;
    align-items: center;
    gap: .9rem;
    margin: 0;
    color: rgba(var(--text-rgb), .33);
    font-size: .52rem;
    letter-spacing: .14em;
    opacity: 0;
  }
  .intro-header img { width: 1.65rem; height: 1.65rem; padding: 1px; border: 1px solid rgba(var(--brand-primary-rgb), .45); border-radius: .34rem; object-fit: cover; background: linear-gradient(145deg, rgba(var(--brand-primary-rgb), .55), rgba(var(--brand-secondary-rgb), .55)); box-shadow: 0 0 1.2rem rgba(var(--brand-primary-rgb), .12); }
  .intro-header i { display: block; width: 3rem; height: 1px; background: rgba(var(--text-rgb), .14); }
  .site-intro[data-state='playing'] .intro-header > p { animation: intro-rise .52s .08s var(--ease) forwards; }
  .intro-skip {
    padding: .5rem .65rem;
    border: 0;
    color: rgba(var(--text-rgb), .5);
    background: transparent;
    font-family: var(--font-mono);
    font-size: .56rem;
    letter-spacing: .08em;
    cursor: pointer;
    opacity: 0;
  }
  .site-intro[data-state='playing'] .intro-skip { animation: intro-fade .38s .26s ease forwards; }
  .intro-skip kbd { margin-left: .4rem; padding: .18rem .32rem; border: 1px solid rgba(var(--text-rgb), .18); border-radius: 2px; color: inherit; font: inherit; }
  .intro-skip:hover { color: rgb(var(--text-rgb)); }
  .intro-skip:focus-visible { outline: 2px solid rgb(var(--signal-rgb)); outline-offset: 3px; }
  .intro-copy {
    position: absolute;
    top: 46%;
    left: 50%;
    z-index: 4;
    width: min(78vw, 66rem);
    transform: translate(-50%, -50%);
  }
  .intro-index {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    margin: 0 0 1rem;
    color: rgba(var(--text-rgb), .39);
    font-family: var(--font-mono);
    font-size: clamp(.5rem, .75vw, .62rem);
    letter-spacing: .15em;
    opacity: 0;
    transform: translateY(.7rem);
  }
  .site-intro[data-state='playing'] .intro-index { animation: intro-rise .5s .72s var(--ease) forwards; }
  .intro-index span + span::before { content: '/'; margin-right: 1.2rem; color: rgba(var(--text-rgb), .17); }
  .intro-title-stack { position: relative; text-align: center; }
  h1, .intro-echo {
    margin: 0;
    font-family: var(--font-signature);
    font-size: clamp(4.3rem, 11.5vw, 9.7rem);
    font-weight: 760;
    line-height: .88;
    letter-spacing: -.09em;
    white-space: nowrap;
  }
  h1 {
    position: relative;
    z-index: 2;
    color: rgb(var(--text-rgb));
    opacity: 0;
    filter: blur(18px);
    transform: translateY(1.1rem) scale(.985);
    text-shadow: 0 0 2.8rem rgba(var(--field-primary-rgb), .16);
  }
  .site-intro[data-state='playing'] h1 { animation: intro-title .92s 1.02s var(--ease) forwards; }
  .intro-echo {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(var(--field-secondary-rgb), .22);
    opacity: 0;
    pointer-events: none;
  }
  .intro-echo--back { transform: translate(-1rem, .4rem); }
  .intro-echo--front { z-index: 3; transform: translate(1rem, -.35rem); -webkit-text-stroke-color: rgba(var(--field-primary-rgb), .15); }
  .site-intro[data-state='playing'] .intro-echo--back { animation: intro-echo-back 1.05s .86s var(--ease) forwards; }
  .site-intro[data-state='playing'] .intro-echo--front { animation: intro-echo-front 1.12s .94s var(--ease) forwards; }
  .intro-status {
    display: grid;
    grid-template-columns: auto minmax(7rem, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    margin-top: 2.1rem;
    opacity: 0;
    transform: translateY(.8rem);
  }
  .site-intro[data-state='playing'] .intro-status { animation: intro-rise .54s 1.62s var(--ease) forwards; }
  .intro-status > div:first-child { display: flex; gap: .65rem; align-items: center; }
  .intro-status span, .intro-status small { color: rgba(var(--text-rgb), .35); font-family: var(--font-mono); font-size: .5rem; letter-spacing: .1em; }
  .intro-status p { margin: 0; color: rgba(var(--text-rgb), .68); font-size: clamp(.72rem, 1vw, .88rem); letter-spacing: .08em; }
  .intro-progress { position: relative; height: 1px; overflow: visible; background: rgba(var(--text-rgb), .14); }
  .intro-progress i { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, rgb(var(--brand-primary-rgb)), rgb(var(--brand-secondary-rgb))); box-shadow: 0 0 .9rem rgba(var(--brand-primary-rgb), .45); transform: scaleX(0); transform-origin: left; }
  .intro-progress b { position: absolute; top: 50%; left: 0; width: .34rem; height: .34rem; border-radius: 50%; background: rgb(var(--text-rgb)); box-shadow: 0 0 1rem rgba(var(--field-primary-rgb), .7); transform: translate(-50%, -50%); }
  .site-intro[data-state='playing'] .intro-progress i { animation: intro-progress 1.7s 1.68s var(--ease) forwards; }
  .site-intro[data-state='playing'] .intro-progress b { animation: intro-progress-dot 1.7s 1.68s var(--ease) forwards; }
  .intro-footer {
    bottom: clamp(1.3rem, 4vw, 3rem);
    align-items: flex-end;
    color: rgba(var(--text-rgb), .27);
    font-size: .49rem;
    line-height: 1.8;
    letter-spacing: .09em;
    opacity: 0;
  }
  .intro-footer p { margin: 0; }
  .intro-footer p:last-child { text-align: right; }
  .site-intro[data-state='playing'] .intro-footer { animation: intro-fade .45s .46s ease forwards; }
  .site-intro[data-state='dispersing'] :is(h1, .intro-echo, .intro-index, .intro-status) { opacity: 0; filter: blur(12px); transform: translateY(-.8rem) scale(1.012); transition: .48s ease; }
  @keyframes intro-rise { to { opacity: 1; transform: translateY(0); } }
  @keyframes intro-fade { to { opacity: 1; } }
  @keyframes intro-title { 0% { opacity: 0; filter: blur(18px); transform: translateY(1.1rem) scale(.985); } 58% { opacity: 1; filter: blur(2px); } 100% { opacity: 1; filter: blur(0); transform: none; } }
  @keyframes intro-echo-back { 0% { opacity: 0; transform: translate(-1.4rem, .55rem); } 46% { opacity: .72; } 100% { opacity: .18; transform: translate(-.38rem, .14rem); } }
  @keyframes intro-echo-front { 0% { opacity: 0; transform: translate(1.4rem, -.5rem); } 42% { opacity: .55; } 100% { opacity: .12; transform: translate(.32rem, -.1rem); } }
  @keyframes intro-progress { to { transform: scaleX(1); } }
  @keyframes intro-progress-dot { to { left: 100%; } }
  @keyframes intro-scan { 0% { opacity: 0; transform: translateX(-130%) skewX(-12deg); } 28% { opacity: 1; } 74% { opacity: .7; } 100% { opacity: 0; transform: translateX(620%) skewX(-12deg); } }
  @media (max-width: 640px) {
    .intro-header > p span:last-child, .intro-header i { display: none; }
    .intro-copy { width: calc(100vw - 2.5rem); }
    .intro-index { gap: .55rem; }
    .intro-index span + span::before { margin-right: .55rem; }
    h1, .intro-echo { font-size: clamp(3.4rem, 18.8vw, 5.3rem); }
    .intro-status { grid-template-columns: 1fr; gap: .8rem; }
    .intro-status small { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-intro { transition: opacity .15s linear; }
    .intro-particles, .intro-scan, .intro-echo { display: none; }
    .site-intro[data-state='playing'] :is(.intro-header > p, .intro-skip, .intro-index, h1, .intro-status, .intro-footer) { animation-duration: .01ms; animation-delay: 0ms; }
    .site-intro[data-state='playing'] .intro-progress :is(i, b) { animation: none; }
  }
</style>

<script>
  import type { IntroParticleController, IntroPalette, IntroRgb } from '../lib/intro-particles';
  import { storageGet, storageSet } from '../lib/browser-storage';

  const introKey = 'someone-site:intro-seen:v4';
  const intro = document.querySelector<HTMLElement>('[data-site-intro]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (intro) {
    const forceReplay = new URLSearchParams(location.search).has('intro');
    const alreadySeen = storageGet('sessionStorage', introKey) === 'true';
    let leaveTimer = 0;
    let exitTimer = 0;
    let removeTimer = 0;
    let particleController: IntroParticleController | undefined;
    let disposed = false;
    const suspendedSiblings = new Map<HTMLElement, { inert: boolean; ariaHidden: string | null }>();
    const suspendPage = () => {
      for (const element of document.body.querySelectorAll<HTMLElement>(':scope > :not(.site-intro):not(script)')) {
        if (!suspendedSiblings.has(element)) suspendedSiblings.set(element, {
          inert: element.inert,
          ariaHidden: element.getAttribute('aria-hidden'),
        });
        element.setAttribute('inert', '');
        element.inert = true;
        element.setAttribute('aria-hidden', 'true');
      }
    };
    const introObserver = new MutationObserver(suspendPage);
    const restorePage = () => suspendedSiblings.forEach(({ inert, ariaHidden }, element) => {
      element.inert = inert;
      if (ariaHidden === null) element.removeAttribute('aria-hidden');
      else element.setAttribute('aria-hidden', ariaHidden);
    });
    const readRgb = (name: string): IntroRgb => {
      const values = getComputedStyle(document.documentElement).getPropertyValue(name).split(',').map((value) => Number(value.trim()));
      return [values[0] ?? 255, values[1] ?? 255, values[2] ?? 255];
    };
    const readPalette = (): IntroPalette => ({
      primary: readRgb('--field-primary-rgb'),
      secondary: readRgb('--field-secondary-rgb'),
      warm: readRgb('--field-warm-rgb'),
      text: readRgb('--text-rgb'),
      light: getComputedStyle(document.documentElement).colorScheme.includes('light'),
    });
    const finish = (restoreFocus = true) => {
      if (disposed) return;
      disposed = true;
      intro.hidden = true;
      document.body.classList.remove('intro-active');
      restorePage();
      introObserver.disconnect();
      document.removeEventListener('DOMContentLoaded', suspendPage);
      particleController?.destroy();
      removeEventListener('keydown', onKeyDown);
      if (restoreFocus) document.getElementById('main-content')?.focus({ preventScroll: true });
      dispatchEvent(new CustomEvent('site:intro-end'));
    };
    const leave = () => {
      if (intro.dataset.state === 'dispersing' || intro.dataset.state === 'leaving' || intro.hidden) return;
      clearTimeout(leaveTimer);
      particleController?.scatter();
      intro.dataset.state = reducedMotion ? 'leaving' : 'dispersing';
      exitTimer = window.setTimeout(() => { intro.dataset.state = 'leaving'; }, reducedMotion ? 0 : 320);
      removeTimer = window.setTimeout(finish, reducedMotion ? 150 : 1080);
    };
    function onKeyDown(event: KeyboardEvent) {
      if (event.key === 'Escape') leave();
    }
    if (alreadySeen && !forceReplay) {
      intro.hidden = true;
    } else {
      storageSet('sessionStorage', introKey, 'true');
      document.body.classList.add('intro-active');
      suspendPage();
      introObserver.observe(document.body, { childList: true });
      document.addEventListener('DOMContentLoaded', suspendPage, { once: true });
      intro.dataset.state = 'playing';
      dispatchEvent(new CustomEvent('site:intro-start'));
      if (!reducedMotion) {
        const canvas = intro.querySelector<HTMLCanvasElement>('[data-intro-particles]');
        if (canvas) {
          import('../lib/intro-particles').then(({ mountIntroParticles }) => {
            if (!disposed) particleController = mountIntroParticles(canvas, readPalette());
          }).catch((error) => console.warn('[site-intro] Particle typography unavailable.', error));
        }
      }
      const skipButton = intro.querySelector<HTMLButtonElement>('[data-intro-skip]');
      skipButton?.addEventListener('click', leave, { once: true });
      skipButton?.focus({ preventScroll: true });
      addEventListener('keydown', onKeyDown);
      leaveTimer = window.setTimeout(leave, reducedMotion ? 650 : 3800);
    }
    addEventListener('pagehide', () => {
      clearTimeout(leaveTimer);
      clearTimeout(exitTimer);
      clearTimeout(removeTimer);
      finish(false);
    }, { once: true });
  }
</script>
