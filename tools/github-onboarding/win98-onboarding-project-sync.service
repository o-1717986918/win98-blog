[Unit]
Description=win98.site private GitHub training roster synchronization
After=network-online.target win98-onboarding-roster.service
Wants=network-online.target

[Service]
User=win98onboarding
Group=win98onboarding
StateDirectory=win98-onboarding
StateDirectoryMode=0700
LoadCredential=github-token:/etc/win98-onboarding/github-token
ExecStart=/usr/bin/python3 -B /opt/win98-onboarding-roster/project_sync.py --project 1
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
